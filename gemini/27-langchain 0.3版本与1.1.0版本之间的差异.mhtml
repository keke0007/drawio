,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4228668850="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-335"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-335"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-335"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-335"><span class="hljs-keyword">if</span> __name__ == <span class="hljs-string">"__main__"</span>:
