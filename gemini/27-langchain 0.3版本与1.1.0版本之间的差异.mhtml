pple" mat-ripple-loader-centered="" aria-controls="user-query-content-4" jslog="273008;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_d5fe93e247ee7604&quot;,&quot;c_48fc01a043422523&quot;,null,null,null,null,null,null,1,null,null,null,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c747749843="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-m action-button-icon google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><!----><!----><span _ngcontent-ng-c747749843="" class="user-query-bubble-with-background ng-star-inserted"><!----><span _ngcontent-ng-c747749843="" class="horizontal-container"><div _ngcontent-ng-c747749843="" role="heading" aria-level="2" class="query-text gds-body-l" dir="ltr"><p _ngcontent-ng-c747749843="" class="query-text-line ng-star-inserted"> 如何给智能提体配置提示词，并实现结构化输出 <!----><!----></p><!----></div><!----></span></span><!----></div><!----><!----><!----></div><!----><!----><!----></user-query-content></span></user-query><!----><!----><model-response _ngcontent-ng-c2507350163="" _nghost-ng-c2587251704="" class="ng-star-inserted"><div _ngcontent-ng-c2587251704=""><response-container _ngcontent-ng-c2587251704="" _nghost-ng-c623567544="" class="ng-tns-c623567544-65 reduced-bottom-padding ng-star-inserted" jslog="188576;track:impression,attention;BardVeMetadataKey:[[&quot;r_d5fe93e247ee7604&quot;,&quot;c_48fc01a043422523&quot;,null,null,null,null,null,null,1,null,null,null,0]];mutable:true" data-hveid="0" decode-data-ved="1" data-ved="0CAAQoMELahgKEwjOvqTL3ZaRAxUAAAAAHQAAAAAQswE"><div _ngcontent-ng-c623567544="" class="response-container ng-tns-c623567544-65 response-container-with-gpi is-mobile ng-star-inserted" jslog="173900;track:impression,attention"