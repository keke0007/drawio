;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_fbb32b28a30e2273&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4228668850="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-315"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-315"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-315"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-315"><span class="hljs-keyword">from</span> langchain_openai <span class="hljs-keyword">import</span> OpenAIEmbeddings
