<span class="hljs-comment"># ==========================================</span>
<span class="hljs-comment"># 1. 模拟一个"用户长期画像数据库" (Global Memory)</span>
<span class="hljs-comment"># ==========================================</span>
<span class="hljs-comment"># 在实际生产中，这应该是一个 Redis, MySQL 或 VectorDB</span>
USER_PROFILE_DB = {
    <span class="hljs-string">"user_alice"</span>: {
