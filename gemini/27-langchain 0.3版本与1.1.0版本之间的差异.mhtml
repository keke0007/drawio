    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">saveKnowledge</span><span class="hljs-params">(String content)</span> </span>{
        <span class="hljs-comment">// Spring AI 会自动帮你做 Embedding 并存入 PG</span>
        Document doc = <span class="hljs-keyword">new</span> Document(content, Map.of(<span class="hljs-string">"source"</span>, <span class="hljs-string">"employee_handbook"</span>));
        vectorStore.add(java.util.List.of(doc));
    }
}
