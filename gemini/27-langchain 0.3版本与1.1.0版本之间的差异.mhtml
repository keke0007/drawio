opy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-187"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-187"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-187"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-187"><span class="hljs-comment"># 安装 gunicorn</span>
pip install gunicorn

<span class="hljs-comment"># 启动命令 (假设文件名是 server.py，app对象名为 app)</span>
<span class="hljs-comment"># -w 4 表示开启 4 个工作进程</span>
