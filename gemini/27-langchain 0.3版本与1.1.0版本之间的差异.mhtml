-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-185"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-185"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-185"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-185"><span class="hljs-keyword">from</span> langserve <span class="hljs-keyword">import</span> RemoteRunnable

