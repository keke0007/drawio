44="" class="menu-button-wrapper ng-tns-c623567544-316 ng-star-inserted" style=""><button _ngcontent-ng-c623567544="" mat-button="" mattooltip="More" tabindex="0" aria-label="Show more options" data-test-id="more-menu-button" class="mdc-button mat-mdc-button-base mat-mdc-tooltip-trigger icon-button more-button ng-tns-c623567544-316 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" aria-describedby="cdk-describedby-message-ng-1-53" cdk-describedby-host="ng-1"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><mat-icon _ngcontent-ng-c623567544="" role="img" fonticon="more_vert" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="more_vert"></mat-icon><span class="mdc-button__label"></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c2587251704="" class="response-content ng-tns-c623567544-316"><!----><model-thoughts _ngcontent-ng-c2587251704="" data-test-id="model-thoughts" _nghost-ng-c452331535="" class="ng-tns-c452331535-318 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c452331535="" class="model-thoughts ng-tns-c452331535-318 is-mobile"><div _ngcontent-ng-c452331535="" class="thoughts-header ng-tns-c452331535-318"><button _ngcontent-ng-c452331535="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c452331535-318 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c452331535="" class="thoughts-header-button-content"><div _ngcontent-ng-c452331535="" class="thoughts-header-button-label ng-tns-c452331535-318"><span _ngcontent-ng-c452331535="" class="ng-tns-c452331535-318">Show thinking</span></div><div _ngcontent-ng-c452331535="" class="thoughts-header-button-icons ng-tns-c452331535-318"><!----><mat-icon _ngcontent-ng-c452331535="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c452331535-318 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----></div></model-thoughts><!----><!----><!----><!----><message-content _ngcontent-ng-c2587251704="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c4287165981="" id="message-content-id-r_4c7586d7e901f90c" style="height: auto;"><div _ngcontent-ng-c4287165981="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_4c7586d7e901f90c" aria-live="polite" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">在 LangChain 1.1.0 / LangGraph 架构下，实现“用户意图识别”通常不再需要训练一个传统的分类模型（如 BERT）。</p><p data-path-to-node="1">现在的最佳实践是利用大模型本身的能力，配合 <b>“结构化输出”</b> 和 <b>“条件路由 (Conditional Routing)”</b>。</p><p data-path-to-node="2">我们将意图识别分为三个层级，建议您根据业务复杂程度选择：</p><hr data-path-to-node="3"><p data-path-to-node="4"></p><h3>层级 1：隐式识别 (最简单)</h3><p></p><p data-path-to-node="5"><b>原理：</b> 把意图识别完全交给 LLM 的 <b>Tool Calling</b> 能力。
<b>做法：</b> 你不专门写代码去识别。如果用户问“北京天气”，LLM 自动选择 <code>get_weather</code> 工具，这就是一种意图识别。
<b>缺点：</b> 无法区分“闲聊”和“业务”。每次都要加载所有工具，耗费 Token 且容易被干扰。</p><p data-path-to-node="6"></p><h3>层级 2：显式路由 (推荐，专业做法)</h3><p></p><p data-path-to-node="7"><b>原理：</b> 在执行任何工具之前，先跑一个小型的、专门的 LLM 调用（Router），强迫它做一个<b>选择题</b>。
<b>流程：</b> 用户输入 -&gt; <b>意图分类器</b> -&gt; (如果是闲聊 -&gt; 直接回复) / (如果是查询 -&gt; 进 RAG) / (如果是操作 -&gt; 进 Tool)。</p><p data-path-to-node="8">下面我为您演示 <b>层级 2</b> 的完整实现代码。这种方式在生产环境中既省钱（闲聊不查库）又精准。</p><hr data-path-to-node="9"><p data-path-to-node="10"></p><h3>代码实现：基于 LangGraph 的意图路由系统</h3><p></p><p data-path-to-node="11">假设您的系统有三种意图：</p><ol start="1" data-path-to-node="12"><li><p data-path-to-node="12,0,0"><b>General:</b> 普通闲聊（打招呼、夸奖）。</p></li><li><p data-path-to-node="12,1,0"><b>RAG:</b> 查公司知识库（如“报销流程”）。</p></li><li><p data-path-to-node="12,2,0"><b>Tool:</b> 查实时数据（如“汇率”、“天气”）。</p></li></ol><p data-path-to-node="13"></p><h4>1. 定义意图结构 (Pydantic)</h4><p></p><p data-path-to-node="14">利用 LangChain 的 <code>with_structured_output</code> 强制 LLM 做单选题。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4228668850="" class="ng-tns-c4228668850-331 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4228668850="" class="code-block ng-tns-c4228668850-331 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_4c7586d7e901f90c&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_b10da94a480f81aa&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjOvqTL3ZaRAxUAAAAAHQAAAAAQxgM" style="display: block;"><div _ngcontent-ng-c4228668850="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4228668850-331 ng-star-inserted" style=""><span _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-331">Python</span><div _ngcontent-ng-c4228668850="" class="buttons ng-tns-c4228668850-331 ng-star-inserted"><button _ngcontent-ng-c4228668850="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4228668850-331 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_4c7586d7e901f90c&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_b10da94a480f81aa&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4228668850="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-331"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-331"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-331"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-331"><span class="hljs-keyword">from</span> typing <span class="hljs-keyword">import</span> Literal
<span class="hljs-keyword">from</span> pydantic <span class="hljs-keyword">import</span> BaseModel, Field
<span class="hljs-keyword">from</span> langchain_openai <span class="hljs-keyword">import</span> ChatOpenAI

<span class="hljs-comment"># 定义分类选项</span>
<span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">Intent</span>(<span class="hljs-params">BaseModel</span>):</span>
    <span class="hljs-string">"""根据用户的问题，将意图分类为以下之一"""</span>
    category: Literal[<span class="hljs-string">"general_chat"</span>, <span class="hljs-string">"search_knowledge_base"</span>, <span class="hljs-string">"use_calculator"</span>] = Field(
        description=<span class="hljs-string">"用户意图的类别。闲聊选general_chat，问公司规定选search_knowledge_base，算数或查数据选use_calculator"</span>
    )

llm = ChatOpenAI(model=<span class="hljs-string">"gpt-4o"</span>, temperature=<span class="hljs-number">0</span>)

<span class="hljs-comment"># 创建一个专门的"路由链"</span>
<span class="hljs-comment"># 这比完整的 Agent 轻量得多，只负责分类</span>
router_chain = llm.with_structured_output(Intent)
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="16"></p><h4>2. 定义处理节点 (Node)</h4><p></p><p data-path-to-node="17">在 LangGraph 中，不同的意图由不同的节点处理。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4228668850="" class="ng-tns-c4228668850-332 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4228668850="" class="code-block ng-tns-c4228668850-332 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_4c7586d7e901f90c&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_b10da94a480f81aa&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjOvqTL3ZaRAxUAAAAAHQAAAAAQxwM" style="display: block;"><div _ngcontent-ng-c4228668850="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4228668850-332 ng-star-inserted" style=""><span _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-332">Python</span><div _ngcontent-ng-c4228668850="" class="buttons ng-tns-c4228668850-332 ng-star-inserted"><button _ngcontent-ng-c4228668850="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4228668850-332 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_4c7586d7e901f90c&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_b10da94a480f81aa&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4228668850="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-332"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-332"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-332"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-332"><span class="hljs-keyword">from</span> langchain_core.messages <span class="hljs-keyword">import</span> SystemMessage, AIMessage

<span class="hljs-comment"># --- 节点 1: 闲聊处理 ---</span>
<span class="hljs-function"><span class="hljs-keyword">def</span> <span class="hljs-title">general_chat_node</span>(<span class="hljs-params">state</span>):</span>
    <span class="hljs-string">"""处理闲聊，不调用任何工具，省钱"""</span>
    print(<span class="hljs-string">"--- 进入闲聊模式 ---"</span>)
    <span class="hljs-comment"># 这里可以用一个更便宜的模型，比如 gpt-3.5-turbo</span>
    chat_llm = ChatOpenAI(model=<span class="hljs-string">"gpt-4o"</span>) 
    response = chat_llm.invoke(state[<span class="hljs-string">"messages"</span>])
    <span class="hljs-keyword">return</span> {<span class="hljs-string">"messages"</span>: [response]}

<span class="hljs-comment"># --- 节点 2: RAG 知识库检索 ---</span>
<span class="hljs-comment"># (这里简化模拟，实际就是调用 retrieve_tool)</span>
<span class="hljs-function"><span class="hljs-keyword">def</span> <span class="hljs-title">rag_search_node</span>(<span class="hljs-params">state</span>):</span>
    print(<span class="hljs-string">"--- 进入知识库检索模式 ---"</span>)
    question = state[<span class="hljs-string">"messages"</span>][-<span class="hljs-number">1</span>].content
    <span class="hljs-comment"># 模拟检索结果</span>
    result = <span class="hljs-string">f"基于知识库查询 '<span class="hljs-subst">{question}</span>' 的结果：公司报销需要在每月5号前提交。"</span>
    <span class="hljs-keyword">return</span> {<span class="hljs-string">"messages"</span>: [AIMessage(content=result)]}

<span class="hljs-comment"># --- 节点 3: 工具调用 ---</span>
<span class="hljs-comment"># (这里简化模拟)</span>
<span class="hljs-function"><span class="hljs-keyword">def</span> <span class="hljs-title">tool_node</span>(<span class="hljs-params">state</span>):</span>
    print(<span class="hljs-string">"--- 进入工具调用模式 ---"</span>)
    <span class="hljs-keyword">return</span> {<span class="hljs-string">"messages"</span>: [AIMessage(content=<span class="hljs-string">"正在调用计算器工具...结果是 42"</span>)]}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="19"></p><h4>3. 构建路由逻辑 (Conditional Edge)</h4><p></p><p data-path-to-node="20">这是核心部分：根据 router_chain 的结果决定走向。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4228668850="" class="ng-tns-c4228668850-333 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4228668850="" class="code-block ng-tns-c4228668850-333 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_4c7586d7e901f90c&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_b10da94a480f81aa&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjOvqTL3ZaRAxUAAAAAHQAAAAAQyAM" style="display: block;"><div _ngcontent-ng-c4228668850="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4228668850-333 ng-star-inserted" style=""><span _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-333">Python</span><div _ngcontent-ng-c4228668850="" class="buttons ng-tns-c4228668850-333 ng-star-inserted"><button _ngcontent-ng-c4228668850="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4228668850-333 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_4c7586d7e901f90c&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_b10da94a480f81aa&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4228668850="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-333"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-333"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-333"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-333"><span class="hljs-function"><span class="hljs-keyword">def</span> <span class="hljs-title">route_decision</span>(<span class="hljs-params">state</span>):</span>
    <span class="hljs-string">"""
    这是图中的'条件边'函数。
    它读取用户的最后一条消息，判断意图，返回下一个节点的名称。
    """</span>
    last_message = state[<span class="hljs-string">"messages"</span>][-<span class="hljs-number">1</span>]
    
    <span class="hljs-comment"># 调用意图识别链</span>
    intent = router_chain.invoke(last_message.content)
    
    print(<span class="hljs-string">f"\n[系统识别意图]: <span class="hljs-subst">{intent.category}</span>"</span>)
    
    <span class="hljs-comment"># 映射到图中的节点名称</span>
    <span class="hljs-keyword">if</span> intent.category == <span class="hljs-string">"general_chat"</span>:
        <span class="hljs-keyword">return</span> <span class="hljs-string">"node_chat"</span>
    <span class="hljs-keyword">elif</span> intent.category == <span class="hljs-string">"search_knowledge_base"</span>:
        <span class="hljs-keyword">return</span> <span class="hljs-string">"node_rag"</span>
    <span class="hljs-keyword">elif</span> intent.category == <span class="hljs-string">"use_calculator"</span>:
        <span class="hljs-keyword">return</span> <span class="hljs-string">"node_tool"</span>
    
    <span class="hljs-keyword">return</span> <span class="hljs-string">"node_chat"</span> <span class="hljs-comment"># 默认回退</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="22"></p><h4>4. 组装图 (Graph)</h4><p></p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4228668850="" class="ng-tns-c4228668850-334 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4228668850="" class="code-block ng-tns-c4228668850-334 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_4c7586d7e901f90c&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_b10da94a480f81aa&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjOvqTL3ZaRAxUAAAAAHQAAAAAQyQM" style="display: block;"><div _ngcontent-ng-c4228668850="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4228668850-334 ng-star-inserted" style=""><span _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-334">Python</span><div _ngcontent-ng-c4228668850="" class="buttons ng-tns-c4228668850-334 ng-star-inserted"><button _ngcontent-ng-c4228668850="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4228668850-334 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_4c7586d7e901f90c&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_b10da94a480f81aa&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4228668850="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-334"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-334"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-334"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-334"><span class="hljs-keyword">from</span> langgraph.graph <span class="hljs-keyword">import</span> StateGraph, END
<span class="hljs-keyword">from</span> langgraph.graph.message <span class="hljs-keyword">import</span> add_messages
<span class="hljs-keyword">from</span> typing <span class="hljs-keyword">import</span> Annotated, TypedDict

<span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">State</span>(<span class="hljs-params">TypedDict</span>):</span>
    messages: Annotated[<span class="hljs-built_in">list</span>, add_messages]

workflow = StateGraph(State)

<span class="hljs-comment"># 添加节点</span>
workflow.add_node(<span class="hljs-string">"node_chat"</span>, general_chat_node)
workflow.add_node(<span class="hljs-string">"node_rag"</span>, rag_search_node)
workflow.add_node(<span class="hljs-string">"node_tool"</span>, tool_node)

<span class="hljs-comment"># 设置条件入口</span>
<span class="hljs-comment"># 意味着：一上来不进任何节点，直接运行 route_decision 函数来决定去哪</span>
workflow.set_conditional_entry_point(
    route_decision,
    {
        <span class="hljs-string">"node_chat"</span>: <span class="hljs-string">"node_chat"</span>,
        <span class="hljs-string">"node_rag"</span>: <span class="hljs-string">"node_rag"</span>,
        <span class="hljs-string">"node_tool"</span>: <span class="hljs-string">"node_tool"</span>
    }
)

<span class="hljs-comment"># 所有节点执行完后都结束</span>
workflow.add_edge(<span class="hljs-string">"node_chat"</span>, END)
workflow.add_edge(<span class="hljs-string">"node_rag"</span>, END)
workflow.add_edge(<span class="hljs-string">"node_tool"</span>, END)

<span class="hljs-comment"># 编译图</span>
