    <span class="hljs-comment"># 其他用户...</span>
}

<span class="hljs-function"><span class="hljs-keyword">def</span> <span class="hljs-title">get_user_profile</span>(<span class="hljs-params">user_id: <span class="hljs-built_in">str</span></span>) -&gt; str:</span>
    <span class="hljs-string">"""从数据库获取用户的长期记忆字符串"""</span>
    data = USER_PROFILE_DB.get(user_id)
    <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> data:
        <span class="hljs-keyword">return</span> <span class="hljs-string">"（该用户暂无历史画像数据）"</span>
    <span class="hljs-keyword">return</span> <span class="hljs-string">f"""
    [用户长期画像]
    - 已知事实: <span class="hljs-subst">{<span class="hljs-string">"; "</span>.join(data[<span class="hljs-string">'facts'</span>])}</span>
    - 偏好: <span class="hljs-subst">{data[<span class="hljs-string">'preferences'</span>]}</span>
    """</span>

<span class="hljs-function"><span class="hljs-keyword">def</span> <span class="hljs-title">update_user_profile</span>(<span class="hljs-params">user_id: <span class="hljs-built_in">str</span>, new_fact: <span class="hljs-built_in">str</span></span>):</span>
    <span class="hljs-string">"""更新用户画像 (工具调用时触发)"""</span>
    <span class="hljs-keyword">if</span> user_id <span class="hljs-keyword">not</span> <span class="hljs-keyword">in</span> USER_PROFILE_DB:
        USER_PROFILE_DB[user_id] = {<span class="hljs-string">"facts"</span>: [], <span class="hljs-string">"preferences"</span>: <span class="hljs-string">""</span>}
    USER_PROFILE_DB[user_id][<span class="hljs-string">"facts"</span>].append(new_fact)
    print(<span class="hljs-string">f"\n&gt;&gt;&gt;&gt; [系统日志] 已更新用户 <span class="hljs-subst">{user_id}</span> 的长期记忆: <span class="hljs-subst">{new_fact}</span> &lt;&lt;&lt;&lt;\n"</span>)

<span class="hljs-comment"># ==========================================</span>
<span class="hljs-comment"># 2. 定义工具</span>
<span class="hljs-comment"># ==========================================</span>

<span class="hljs-comment"># 让 Agent 有能力主动把当前对话的重要信息存入"长期记忆"</span>
<span class="hljs-meta">@tool</span>
<span class="hljs-function"><span class="hljs-keyword">def</span> <span class="hljs-title">save_important_user_info</span>(<span class="hljs-params">info: <span class="hljs-built_in">str</span>, user_id: <span class="hljs-built_in">str</span></span>):</span>
    <span class="hljs-string">"""
    当用户提到重要的个人信息（如姓名、职业、喜好、过敏源）时，调用此工具保存。
    注意：user_id 需要从上下文中获取。
    """</span>
    update_user_profile(user_id, info)
    <span class="hljs-keyword">return</span> <span class="hljs-string">"已保存到用户档案。"</span>

tools = [save_important_user_info]

<span class="hljs-comment"># ==========================================</span>
<span class="hljs-comment"># 3. 核心：动态 Prompt 生成器 (State Modifier)</span>
<span class="hljs-comment"># ==========================================</span>

<span class="hljs-function"><span class="hljs-keyword">def</span> <span class="hljs-title">profile_injector</span>(<span class="hljs-params">state, config</span>):</span>
    <span class="hljs-string">"""
    这个函数会在每次调用 LLM 前运行。
    它可以动态读取 config 里的 user_id，并修改 System Prompt。
    """</span>
    <span class="hljs-comment"># 1. 从配置中获取 user_id (由调用端传入)</span>
    <span class="hljs-comment"># config 结构通常是 {'configurable': {'thread_id': '...', 'user_id': '...'}}</span>
    configurable = config.get(<span class="hljs-string">"configurable"</span>, {})
    user_id = configurable.get(<span class="hljs-string">"user_id"</span>, <span class="hljs-string">"unknown_user"</span>)
    
    <span class="hljs-comment"># 2. 从外部数据库加载这个人的"跨会话记忆"</span>
    user_profile_str = get_user_profile(user_id)
    
    <span class="hljs-comment"># 3. 构建动态 System Prompt</span>
    system_prompt = <span class="hljs-string">f"""
    你是一个智能助手。
    
    以下是你对当前用户的已知信息（来自历史会话）：
    <span class="hljs-subst">{user_profile_str}</span>
    
    如果用户在本次对话中提供了新的重要个人信息，请务必调用 'save_important_user_info' 工具进行保存，以便下次会话记住。
    当前用户的 ID 是: <span class="hljs-subst">{user_id}</span> (调用工具时请使用此ID)
    """</span>
    
    <span class="hljs-comment"># 4. 返回 SystemMessage，它会被 LangGraph 插入到消息列表最前面</span>
    <span class="hljs-keyword">return</span> [SystemMessage(content=system_prompt)] + state[<span class="hljs-string">"messages"</span>]

<span class="hljs-comment"># ==========================================</span>
<span class="hljs-comment"># 4. 构建 Agent</span>
<span class="hljs-comment"># ==========================================</span>

llm = ChatOpenAI(model=<span class="hljs-string">"gpt-4o"</span>, temperature=<span class="hljs-number">0</span>)
memory = SqliteSaver(sqlite3.connect(<span class="hljs-string">":memory:"</span>, check_same_thread=<span class="hljs-literal">False</span>))

<span class="hljs-comment"># 注意：这里 state_modifier 传入的是函数，而不是字符串</span>
agent_app = create_react_agent(
    llm, 
    tools, 
    checkpointer=memory,
    state_modifier=profile_injector <span class="hljs-comment"># &lt;-- 注入动态逻辑</span>
)

<span class="hljs-comment"># ==========================================</span>
<span class="hljs-comment"># 5. 模拟演示</span>
<span class="hljs-comment"># ==========================================</span>

<span class="hljs-function"><span class="hljs-keyword">def</span> <span class="hljs-title">run_chat</span>(<span class="hljs-params">thread_id, user_id, message</span>):</span>
    print(<span class="hljs-string">f"\n--- [会话: <span class="hljs-subst">{thread_id}</span>] [用户: <span class="hljs-subst">{user_id}</span>] ---"</span>)
    print(<span class="hljs-string">f"User: <span class="hljs-subst">{message}</span>"</span>)
    
    <span class="hljs-comment"># Config 中同时传入 thread_id (隔离会话) 和 user_id (关联画像)</span>
    config = {
        <span class="hljs-string">"configurable"</span>: {
            <span class="hljs-string">"thread_id"</span>: thread_id,
            <span class="hljs-string">"user_id"</span>: user_id
        }
    }
    
    result = agent_app.invoke({<span class="hljs-string">"messages"</span>: [(<span class="hljs-string">"user"</span>, message)]}, config=config)
    print(<span class="hljs-string">f"AI  : <span class="hljs-subst">{result[<span class="hljs-string">'messages'</span>][-<span class="hljs-number">1</span>].content}</span>"</span>)

<span class="hljs-keyword">if</span> __name__ == <span class="hljs-string">"__main__"</span>:
    <span class="hljs-comment"># 预设：alice 已经有一些画像在数据库里了（见代码开头）</span>
    <span class="hljs-comment"># 场景 1: Alice 开启一个新的会话 (Session A)</span>
    <span class="hljs-comment"># 预期：AI 应该知道她是 Java 开发，尽管这是个全新的 thread_id</span>
    run_chat(
        thread_id=<span class="hljs-string">"session_A_001"</span>, 
        user_id=<span class="hljs-string">"user_alice"</span>, 
        message=<span class="hljs-string">"给我推荐一本适合我职业的技术书。"</span>
    )
    
    <span class="hljs-comment"># 场景 2: Alice 在 Session A 中透露了新信息</span>
    <span class="hljs-comment"># 预期：AI 调用工具将"对Python感兴趣"存入长期库</span>
    run_chat(
        thread_id=<span class="hljs-string">"session_A_001"</span>, 
        user_id=<span class="hljs-string">"user_alice"</span>, 
        message=<span class="hljs-string">"最近我打算转行学 Python 大数据，记住哦。"</span>
    )
    
    <span class="hljs-comment"># 场景 3: Alice 第二天来了，开启了全新的会话 (Session B)</span>
    <span class="hljs-comment"># 预期：thread_id 变了，短期记忆没了。但 AI 应该通过长期记忆知道她刚学的 Python。</span>
    run_chat(
        thread_id=<span class="hljs-string">"session_B_999"</span>, 
        user_id=<span class="hljs-string">"user_alice"</span>, 
        message=<span class="hljs-string">"还记得我最近打算学什么吗？"</span>
    )
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="11"></p><h3>运行结果解析</h3><p></p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4228668850="" class="ng-tns-c4228668850-269 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4228668850="" class="code-block ng-tns-c4228668850-269 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_b95039230220039d&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_86ddf8dffbcb1a99&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjOvqTL3ZaRAxUAAAAAHQAAAAAQgwM" style="display: block;"><div _ngcontent-ng-c4228668850="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4228668850-269 ng-star-inserted" style=""><span _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-269">Plaintext</span><div _ngcontent-ng-c4228668850="" class="buttons ng-tns-c4228668850-269 ng-star-inserted"><button _ngcontent-ng-c4228668850="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4228668850-269 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_b95039230220039d&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_86ddf8dffbcb1a99&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4228668850="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-269"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-269"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-269"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-269">--- [会话: session_A_001] [用户: user_alice] ---
User: 给我推荐一本适合我职业的技术书。
# AI 读取到了"Java开发"的画像
