    embeddings=OpenAIEmbeddings(),
    collection_name=<span class="hljs-string">"documents"</span>, <span class="hljs-comment"># 这里的 collection 概念对应 PG 里的表或分区</span>
    connection=connection,
    use_jsonb=<span class="hljs-literal">True</span>,
)

<span class="hljs-comment"># 变成工具给 Agent</span>
