        ConnectParam.newBuilder()
            .withHost(<span class="hljs-string">"localhost"</span>)
            .withPort(<span class="hljs-number">19530</span>)
            .build()
    );

    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">storeDocument</span><span class="hljs-params">(String docId, String content)</span> </span>{
        <span class="hljs-comment">// 1. 调用 Embedding 服务获取向量 (假设是一个工具方法)</span>
        <span class="hljs-comment">// 注意：必须确保这里用的模型和 Python 端 LangChain 用的是同一个！</span>
        List&lt;Float&gt; vector = EmbeddingUtil.getEmbedding(content); 

        <span class="hljs-comment">// 2. 准备数据字段</span>
        List&lt;String&gt; ids = Arrays.asList(docId);
        List&lt;String&gt; contents = Arrays.asList(content);
        List&lt;List&lt;Float&gt;&gt; vectors = Arrays.asList(vector);

        <span class="hljs-comment">// 3. 插入 Milvus</span>
        InsertParam insertParam = InsertParam.newBuilder()
            .withCollectionName(<span class="hljs-string">"company_knowledge"</span>)
            .withPartitionName(<span class="hljs-string">"_default"</span>)
            .addField(<span class="hljs-string">"doc_id"</span>, ids)
            .addField(<span class="hljs-string">"content"</span>, contents) <span class="hljs-comment">// 存原文以便 RAG 检索时提取</span>
            .addField(<span class="hljs-string">"doc_embedding"</span>, vectors)
            .build();

        milvusClient.insert(insertParam);
    }
}
