2331535-205 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c452331535="" class="model-thoughts ng-tns-c452331535-205 is-mobile"><div _ngcontent-ng-c452331535="" class="thoughts-header ng-tns-c452331535-205"><button _ngcontent-ng-c452331535="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c452331535-205 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c452331535="" class="thoughts-header-button-content"><div _ngcontent-ng-c452331535="" class="thoughts-header-button-label ng-tns-c452331535-205"><span _ngcontent-ng-c452331535="" class="ng-tns-c452331535-205">Show thinking</span></div><div _ngcontent-ng-c452331535="" class="thoughts-header-button-icons ng-tns-c452331535-205"><!----><mat-icon _ngcontent-ng-c452331535="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c452331535-205 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----></div></model-thoughts><!----><!----><!----><!----><message-content _ngcontent-ng-c2587251704="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c4287165981="" id="message-content-id-r_6d893f0b8dff1d0b" style="height: auto;"><div _ngcontent-ng-c4287165981="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_6d893f0b8dff1d0b" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">非常感谢您的澄清。这是一个非常精准且深入的问题。</p><p data-path-to-node="1">您指的应该是 <code>langchain.agents</code> 包下的一系列<b>构建函数</b>（例如 <code>create_tool_calling_agent</code>、<code>create_openai_tools_agent</code> 等，通常统称为 Agent 构建方法），而不是执行器。</p><p data-path-to-node="2">在 <b>LangChain 1.1.0</b> 的语境下，<code>langchain.agents</code> 包中的 <b>Agent 构建函数</b> 与 <code>langgraph.prebuilt</code> 中的 <b><code>create_react_agent</code></b> 有着本质的层级区别。</p><p data-path-to-node="3">简单来说：<b>前者只是制造了“大脑”（决策逻辑），而后者制造了完整的“自动驾驶系统”（大脑 + 执行 + 循环）。</b></p><p data-path-to-node="4">以下是详细的技术差异对比：</p><p data-path-to-node="5"></p><h3>1. 本质定义的区别</h3><p></p><ul data-path-to-node="6"><li><p data-path-to-node="6,0,0"><b><code>langchain.agents.create_...</code> (如 create_tool_calling_agent)</b></p><ul data-path-to-node="6,0,1"><li><p data-path-to-node="6,0,1,0,0"><b>定义：</b> 它构建的是一个 <b><code>Runnable</code> (可运行对象)</b>。</p></li><li><p data-path-to-node="6,0,1,1,0"><b>作用范围：</b> <b>仅负责推理（Reasoning）</b>。</p></li><li><p data-path-to-node="6,0,1,2,0"><b>输入：</b> 字典，通常包含 <code>{input, intermediate_steps}</code>。</p></li><li><p data-path-to-node="6,0,1,3,0"><b>输出：</b> <b><code>AgentAction</code></b>（表示“我想调用某个工具”）或 <b><code>AgentFinish</code></b>（表示“通过，回答结束”）。</p></li><li><p data-path-to-node="6,0,1,4,0"><b>关键点：</b> 它<b>绝对不会</b>去执行工具。它只是输出了一个“意图”。它是一个<b>单步</b>的决策链。</p></li></ul></li><li><p data-path-to-node="6,1,0"><b><code>langgraph.prebuilt.create_react_agent</code></b></p><ul data-path-to-node="6,1,1"><li><p data-path-to-node="6,1,1,0,0"><b>定义：</b> 它构建的是一个 <b><code>CompiledGraph</code> (编译后的图)</b>。</p></li><li><p data-path-to-node="6,1,1,1,0"><b>作用范围：</b> <b>负责全流程（Orchestration）</b>。</p></li><li><p data-path-to-node="6,1,1,2,0"><b>输入：</b> 消息列表 <code>list[BaseMessage]</code>。</p></li><li><p data-path-to-node="6,1,1,3,0"><b>输出：</b> 最终的状态字典（包含所有交互历史）。</p></li><li><p data-path-to-node="6,1,1,4,0"><b>关键点：</b> 它<b>包含</b>了推理、工具执行、错误处理和循环逻辑。</p></li></ul></li></ul><p data-path-to-node="7"></p><h3>2. 数据流向对比 (通过代码理解)</h3><p></p><p data-path-to-node="8">让我们看看如果我们分别“运行”这两者，结果会有什么不同。</p><p data-path-to-node="9"></p><h4>A. 使用 <code>langchain.agents</code> 包创建的 Agent</h4><p></p><p data-path-to-node="10">它就像一个“大脑在缸中”，它能思考，但没有手去操作。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4228668850="" class="ng-tns-c4228668850-216 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4228668850="" class="code-block ng-tns-c4228668850-216 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_6d893f0b8dff1d0b&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_a772c4a216a578c1&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjOvqTL3ZaRAxUAAAAAHQAAAAAQvgI" style="display: block;"><div _ngcontent-ng-c4228668850="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4228668850-216 ng-star-inserted" style=""><span _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-216">Python</span><div _ngcontent-ng-c4228668850="" class="buttons ng-tns-c4228668850-216 ng-star-inserted"><button _ngcontent-ng-c4228668850="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4228668850-216 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_6d893f0b8dff1d0b&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_a772c4a216a578c1&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4228668850="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-216"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-216"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-216"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-216"><span class="hljs-keyword">from</span> langchain.agents <span class="hljs-keyword">import</span> create_tool_calling_agent
<span class="hljs-keyword">from</span> langchain_core.prompts <span class="hljs-keyword">import</span> ChatPromptTemplate
<span class="hljs-comment"># ... 假设 tools 和 llm 已定义</span>

<span class="hljs-comment"># 1. 创建 Agent (仅决策逻辑)</span>
prompt = ChatPromptTemplate.from_messages([
    (<span class="hljs-string">"system"</span>, <span class="hljs-string">"You are a helper."</span>),
    (<span class="hljs-string">"human"</span>, <span class="hljs-string">"{input}"</span>),
    (<span class="hljs-string">"placeholder"</span>, <span class="hljs-string">"{agent_scratchpad}"</span>), 
])
<span class="hljs-comment"># 这里的 agent_runnable 就是您说的 "create_agent" 的产物</span>
agent_runnable = create_tool_calling_agent(llm, tools, prompt)

<span class="hljs-comment"># 2. 运行它 (注意：必须手动传入 intermediate_steps)</span>
<span class="hljs-comment"># 如果没有外部循环喂给它 intermediate_steps，它永远不知道工具执行的结果</span>
result = agent_runnable.invoke({
    <span class="hljs-string">"input"</span>: <span class="hljs-string">"查询北京天气"</span>,
    <span class="hljs-string">"intermediate_steps"</span>: [] <span class="hljs-comment"># 第一次运行，还没有历史步骤</span>
})

<span class="hljs-comment"># 3. 查看结果</span>
<span class="hljs-comment"># 结果不是天气字符串，而是一个对象，告诉我们需要去调用工具</span>
print(<span class="hljs-built_in">type</span>(result)) 
<span class="hljs-comment"># 输出: &lt;class 'langchain_core.agents.AgentAction'&gt;</span>
print(result.tool) 
<span class="hljs-comment"># 输出: 'get_weather'</span>
<span class="hljs-comment"># ！！！注意：这里代码停下来了，工具并没有被执行！！！</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="12"></p><h4>B. 使用 <code>langgraph.prebuilt</code> 创建的 Agent</h4><p></p><p data-path-to-node="13">它是一个拥有“手”和“记忆”的完整机器人。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4228668850="" class="ng-tns-c4228668850-217 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4228668850="" class="code-block ng-tns-c4228668850-217 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_6d893f0b8dff1d0b&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_a772c4a216a578c1&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjOvqTL3ZaRAxUAAAAAHQAAAAAQvwI" style="display: block;"><div _ngcontent-ng-c4228668850="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4228668850-217 ng-star-inserted" style=""><span _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-217">Python</span><div _ngcontent-ng-c4228668850="" class="buttons ng-tns-c4228668850-217 ng-star-inserted"><button _ngcontent-ng-c4228668850="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4228668850-217 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_6d893f0b8dff1d0b&quot;,&quot;c_48fc01a043422523&quot;,null,&quot;rc_a772c4a216a578c1&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4228668850="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4228668850="" class="formatted-code-block-internal-container ng-tns-c4228668850-217"><div _ngcontent-ng-c4228668850="" class="animated-opacity ng-tns-c4228668850-217"><pre _ngcontent-ng-c4228668850="" class="ng-tns-c4228668850-217"><code _ngcontent-ng-c4228668850="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4228668850-217"><span class="hljs-keyword">from</span> langgraph.prebuilt <span class="hljs-keyword">import</span> create_react_agent

<span class="hljs-comment"># 1. 创建图 (包含决策+执行+循环)</span>
<span class="hljs-comment"># 内部自动处理了类似 agent_runnable 的逻辑，并连接了 ToolNode</span>
agent_graph = create_react_agent(llm, tools)

<span class="hljs-comment"># 2. 运行它</span>
result = agent_graph.invoke({<span class="hljs-string">"messages"</span>: [(<span class="hljs-string">"user"</span>, <span class="hljs-string">"查询北京天气"</span>)]})

<span class="hljs-comment"># 3. 查看结果</span>
<span class="hljs-comment"># 结果直接是最终回复，因为图内部自动执行了工具并进行了第二轮推理</span>
print(result[<span class="hljs-string">"messages"</span>][-<span class="hljs-number">1</span>].content)
<span class="hljs-comment"># 输出: "北京今天天气晴..."</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="15"></p><h3>3. 在 1.1.0 架构中的关系</h3><p></p><p data-path-to-node="16">在 LangChain 1.1.0 的自定义开发中，<b>您依然可以使用 <code>langchain.agents</code> 包中的 <code>create_agent</code></b>，但通常是为了构建自定义的 LangGraph 节点。</p><p data-path-to-node="17">如果您觉得预置的 <code>create_react_agent</code> 不够用，想自己画图（StateGraph），您的架构通常是这样的：</p><ol start="1" data-path-to-node="18"><li><p data-path-to-node="18,0,0"><b>定义 Agent 节点：</b> 使用 <code>langchain.agents.create_tool_calling_agent</code> 创建的 Runnable 来充当图中的 "Agent Node"（负责思考）。</p></li><li><p data-path-to-node="18,1,0"><b>定义 Tool 节点：</b> 使用 <code>ToolNode</code> 来充当图中的 "Tools Node"（负责干活）。</p></li><li><p data-path-to-node="18,2,0"><b>定义边：</b> 编写条件逻辑（Conditional Edge），如果 Agent 节点输出 <code>AgentAction</code>，就流向 Tool 节点；如果输出 <code>AgentFinish</code>，就结束。</p></li></ol><p data-path-to-node="19"></p><h3>总结</h3><p></p><ul data-path-to-node="20"><li><p data-path-to-node="20,0,0"><b><code>langchain.agents.create_...</code></b>: 是<b>组件</b>。它是一个把 LLM + Prompt + OutputParser 组装在一起的<b>解析器</b>。它只负责把自然语言变成结构化的“动作指令”。</p></li><li><p data-path-to-node="20,1,0"><b><code>langgraph...create_react_agent</code></b>: 是<b>系统</b>。它利用上述的解析能力，配合执行循环，完成真正的任务。</p></li></ul><p data-path-to-node="21">如果您只是想“用”一个 Agent，选后者。
如果您是想“造”一个拥有奇特思考逻辑（比如先思考、再反思、再决定工具）的自定义 Agent 节点，您可能会用到前者来定义那个思考节点。</p></div><!----></message-content><!----><!----><div _ngcontent-ng-c2587251704="" class="response-footer is-mobile gap has-thoughts complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2587251704="" _nghost-ng-c3206106919="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c623567544="" class="response-container-footer ng-tns-c623567544-203"><!----><message-actions _ngcontent-ng-c2587251704="" footer="" _nghost-ng-c3226180721="" class="ng-tns-c3226180721-211 ng-star-inserted hide-action-bar" style=""><div _ngcontent-ng-c3226180721="" class="actions-container-v2 ng-tns-c3226180721-211 mobile"><!----><!----><div _ngcontent-ng-c3226180721="" class="spacer ng-tns-c3226180721-211 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c3226180721="" yposition="above" xposition="after" class="ng-tns-c3226180721-211"><!----></mat-menu><mat-menu _ngcontent-ng-c3226180721="" yposition="above" class="ng-tns-c3226180721-211"><!----></mat-menu><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></message-actions><!----><!----></div></div><!----></response-container><!----><!----><!----><!----><freemium-rag-disclaimer _ngcontent-ng-c2587251704="" _nghost-ng-c3728931254="" class="ng-star-inserted" style=""><!----></freemium-rag-disclaimer><!----></div></model-response><div _ngcontent-ng-c2507350163="" class="restart-chat-button-scroll-placeholder ng-star-inserted"></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div><div _ngcontent-ng-c2507350163="" class="conversation-container message-actions-hover-boundary ng-star-inserted" id="cb0674a9ff67cc3d" style=""><user-query _ngcontent-ng-c2507350163="" _nghost-ng-