" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_079b7d0267749114&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_1870234defa87c57&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-244"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-244"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-244"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-244">Ext.define(<span class="hljs-string">'MyApp.controller.Orders'</span>, {
    <span class="hljs-attr">extend</span>: <span class="hljs-string">'Ext.app.Controller'</span>,

    <span class="hljs-attr">views</span>: [
        <span class="hljs-string">'order.Form'</span>,
        <span class="hljs-string">'component.CodeViewX'</span> <span class="hljs-comment">// 确保加载了自定义组件</span>
    ],

    <span class="hljs-attr">init</span>: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params"></span>) </span>{
        <span class="hljs-built_in">this</span>.control({
            <span class="hljs-comment">// 【核心选择器】</span>
            <span class="hljs-comment">// 解释：在 orderform 组件里，找到 name 为 supplierName 的 codeviewx 组件</span>
            <span class="hljs-string">'orderform codeviewx[name=supplierName]'</span>: {
                <span class="hljs-comment">// 监听我们在组件里定义的自定义事件 'itemselected'</span>
                <span class="hljs-attr">itemselected</span>: <span class="hljs-built_in">this</span>.onSupplierSelected
            }
        });
    },

    <span class="hljs-comment">/**
     * 当供应商被选中时触发
     * <span class="hljs-doctag">@param <span class="hljs-type">{Component}</span> </span>comboTrigger  就是那个 CodeViewX 组件实例
     * <span class="hljs-doctag">@param <span class="hljs-type">{Model}</span> </span>record            用户选中的那一行数据 (Ext.data.Model)
     */</span>
    <span class="hljs-attr">onSupplierSelected</span>: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">comboTrigger, record</span>) </span>{
        <span class="hljs-built_in">console</span>.log(<span class="hljs-string">'Controller 捕获到了选择事件！'</span>);
        
        <span class="hljs-comment">// 1. 找到所在的表单</span>
        <span class="hljs-comment">// (向上查找最近的 form 面板)</span>
        <span class="hljs-keyword">var</span> formPanel = comboTrigger.up(<span class="hljs-string">'form'</span>); 
        <span class="hljs-keyword">var</span> basicForm = formPanel.getForm();

        <span class="hljs-comment">// 2. 获取记录里的数据</span>
        <span class="hljs-comment">// 假设后台返回的数据里有 contact 和 phone 字段</span>
        <span class="hljs-keyword">var</span> contactName = record.get(<span class="hljs-string">'contact'</span>);
