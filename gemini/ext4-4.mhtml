st-id="model-thoughts" _nghost-ng-c636883080="" class="ng-tns-c636883080-249 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c636883080="" class="model-thoughts ng-tns-c636883080-249 is-mobile"><div _ngcontent-ng-c636883080="" class="thoughts-header ng-tns-c636883080-249"><button _ngcontent-ng-c636883080="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c636883080-249 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c636883080="" class="thoughts-header-button-content"><div _ngcontent-ng-c636883080="" class="thoughts-header-button-label ng-tns-c636883080-249"><span _ngcontent-ng-c636883080="" class="ng-tns-c636883080-249">Show thinking</span></div><div _ngcontent-ng-c636883080="" class="thoughts-header-button-icons ng-tns-c636883080-249"><!----><mat-icon _ngcontent-ng-c636883080="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c636883080-249 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----></div></model-thoughts><!----><!----><!----><message-content _ngcontent-ng-c535586177="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c1226125435="" id="message-content-id-r_f308f7d684632881" style="height: auto;"><div _ngcontent-ng-c1226125435="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_f308f7d684632881" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">在 ExtJS 4 中，实现 Loading 效果（遮罩层 Mask）主要有 <b>3 种最常用的方式</b>。选择哪一种取决于你想遮住谁：是遮住整个屏幕、遮住某个弹窗，还是让表格自动显示加载中。</p><p data-path-to-node="1">以下是详细的实现方法：</p><hr data-path-to-node="2"><p data-path-to-node="3"></p><h3>方法一：针对某个组件 (Panel/Window/Form) —— 最常用</h3><p></p><p data-path-to-node="4">ExtJS 4 的所有组件（继承自 <code>Ext.Component</code> 的，如 Panel, Window, Grid, Tree）都内置了一个非常方便的方法：<b><code>setLoading</code></b>。</p><p data-path-to-node="5">它会自动计算组件的大小和位置，把遮罩层精确地覆盖在组件上面。</p><p data-path-to-node="6"><b>场景</b>：用户点击“保存”按钮，表单不能再编辑，直到保存结束。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-272 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-272 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQuwI" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-272 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-272">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-272 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-272 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-272"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-272"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-272"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-272"><span class="hljs-comment">// 开启 Loading</span>
<span class="hljs-comment">// 参数可以是布尔值 true，也可以是字符串（显示文字）</span>
myFormPanel.setLoading(<span class="hljs-literal">true</span>); 
<span class="hljs-comment">// 或者</span>
myFormPanel.setLoading(<span class="hljs-string">'正在保存数据，请稍候...'</span>);

<span class="hljs-comment">// --- 模拟 Ajax 请求结束 ---</span>

<span class="hljs-comment">// 关闭 Loading (必须手动关闭，否则用户就卡死了)</span>
myFormPanel.setLoading(<span class="hljs-literal">false</span>);
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="8"><b>在 Controller 中的实战写法：</b></p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-273 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-273 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQvAI" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-273 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-273">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-273 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-273 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-273"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-273"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-273"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-273">saveUser: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">button</span>) </span>{
    <span class="hljs-keyword">var</span> win = button.up(<span class="hljs-string">'window'</span>); <span class="hljs-comment">// 获取所在的窗口</span>
    <span class="hljs-keyword">var</span> form = win.down(<span class="hljs-string">'form'</span>);

    <span class="hljs-keyword">if</span> (form.isValid()) {
        <span class="hljs-comment">// 1. 开启遮罩</span>
        win.setLoading(<span class="hljs-string">'保存中...'</span>);

        Ext.Ajax.request({
            <span class="hljs-attr">url</span>: <span class="hljs-string">'/api/save'</span>,
            <span class="hljs-attr">success</span>: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">response</span>) </span>{
                <span class="hljs-comment">// 2. 成功后关闭</span>
                win.setLoading(<span class="hljs-literal">false</span>); 
                Ext.Msg.alert(<span class="hljs-string">'成功'</span>, <span class="hljs-string">'保存成功'</span>);
                win.close();
            },
            <span class="hljs-attr">failure</span>: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params"></span>) </span>{
                <span class="hljs-comment">// 3. 失败也要关闭！千万别忘了！</span>
                win.setLoading(<span class="hljs-literal">false</span>);
                Ext.Msg.alert(<span class="hljs-string">'错误'</span>, <span class="hljs-string">'服务器炸了'</span>);
            }
        });
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="10"><p data-path-to-node="11"></p><h3>方法二：全局遮罩 (Global Mask) —— 霸道拦截</h3><p></p><p data-path-to-node="12">如果你进行的操作非常重要，不希望用户点击页面上的任何地方（比如初始化系统配置、页面跳转），你可以直接遮罩整个 <code>&lt;body&gt;</code>。</p><p data-path-to-node="13"><b>方法</b>：使用 <code>Ext.getBody().mask()</code>。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-274 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-274 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQvQI" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-274 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-274">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-274 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-274 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-274"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-274"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-274"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-274"><span class="hljs-comment">// 遮住整个浏览器窗口</span>
Ext.getBody().mask(<span class="hljs-string">'系统初始化中...'</span>);

<span class="hljs-comment">// 解除遮罩</span>
Ext.getBody().unmask();
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><ul data-path-to-node="15"><li><p data-path-to-node="15,0,0"><b>注意</b>：<code>Ext.Msg.wait()</code> 也是一种全局遮罩，通常用于进度条展示，但 <code>Ext.getBody().mask()</code> 更轻量通用。</p></li></ul><hr data-path-to-node="16"><p data-path-to-node="17"></p><h3>方法三：Grid / Tree 的自动遮罩 (LoadMask)</h3><p></p><p data-path-to-node="18">对于 <b>GridPanel (表格)</b> 和 <b>TreePanel (树)</b>，ExtJS 默认集成了自动遮罩功能。当绑定的 Store 调用 <code>load()</code> 方法时，表格会自动变灰并转圈，加载完自动消失。</p><p data-path-to-node="19"><b>如何配置？</b>
通常默认是开启的。如果你想自定义文字或者强制开启：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-275 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-275 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQvgI" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-275 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-275">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-275 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-275 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-275"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-275"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-275"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-275">Ext.create(<span class="hljs-string">'Ext.grid.Panel'</span>, {
    <span class="hljs-attr">store</span>: userStore,
    <span class="hljs-attr">columns</span>: [...],
    
    <span class="hljs-comment">// 配置 viewConfig</span>
    <span class="hljs-attr">viewConfig</span>: {
        <span class="hljs-comment">// loadMask: true, // 默认就是 true</span>
        
        <span class="hljs-comment">// 如果想改文字，传入一个对象</span>
        <span class="hljs-attr">loadMask</span>: {
            <span class="hljs-attr">msg</span>: <span class="hljs-string">'拼命加载数据中...'</span>
        }
    }
});
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><ul data-path-to-node="21"><li><p data-path-to-node="21,0,0"><b>坑点提示</b>：如果你的 Grid 配置了 <code>loadMask: true</code> 但加载时不显示遮罩，通常是因为你的 Store 设置了 <code>autoLoad: true</code>，且 Store 加载太快（或在 Grid 渲染前就开始加载了）。<b>解决办法是设置 <code>Store</code> 的 <code>autoLoad: false</code>，等 Grid 渲染出来后（在 Controller 的 init 或 Grid 的 afterrender 事件里）再手动 <code>store.load()</code>。</b></p></li></ul><hr data-path-to-node="22"><p data-path-to-node="23"></p><h3>方法四：进阶 —— 全局 Ajax 监听 (一劳永逸)</h3><p></p><p data-path-to-node="24">在一个大系统中，每个 Ajax 请求都手写 <code>setLoading(true)</code> 和 <code>false</code> 会累死人。
你可以利用 <code>Ext.Ajax</code> 的全局事件，实现**“只要有请求飞出去，就自动遮罩；请求回来，自动取消”**。</p><p data-path-to-node="25">在你的 <code>app.js</code> 或主控制器的 <code>init</code> 中：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-276 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-276 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQvwI" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-276 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-276">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-276 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-276 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-276"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-276"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-276"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-276"><span class="hljs-comment">// 监听所有 Ajax 请求发起前</span>
Ext.Ajax.on(<span class="hljs-string">'beforerequest'</span>, <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">conn, options</span>) </span>{
    <span class="hljs-comment">// 过滤掉不需要遮罩的请求（比如后台轮询消息）</span>
    <span class="hljs-keyword">if</span> (!options.hideMask) {
        Ext.getBody().mask(<span class="hljs-string">'数据处理中...'</span>);
    }
});

<span class="hljs-comment">// 监听所有 Ajax 请求完成后（无论成功失败）</span>
Ext.Ajax.on(<span class="hljs-string">'requestcomplete'</span>, <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">conn, response, options</span>) </span>{
    <span class="hljs-keyword">if</span> (!options.hideMask) {
        Ext.getBody().unmask();
    }
});

<span class="hljs-comment">// 监听请求异常（比如 404, 500）</span>
Ext.Ajax.on(<span class="hljs-string">'requestexception'</span>, <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">conn, response, options</span>) </span>{
    <span class="hljs-keyword">if</span> (!options.hideMask) {
        Ext.getBody().unmask();
    }
    Ext.Msg.alert(<span class="hljs-string">'错误'</span>, <span class="hljs-string">'网络请求失败，状态码：'</span> + response.status);
});
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="27"><b>使用时：</b></p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-277 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-277 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQwAI" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-277 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-277">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-277 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-277 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_f308f7d684632881&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_d19023d329514097&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-277"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-277"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-277"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-277"><span class="hljs-comment">// 普通请求（会自动出遮罩）</span>
