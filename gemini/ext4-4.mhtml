        {<span class="hljs-attr">name</span>: <span class="hljs-string">'email'</span>, <span class="hljs-attr">type</span>: <span class="hljs-string">'string'</span>},
        {<span class="hljs-attr">name</span>: <span class="hljs-string">'createTime'</span>, <span class="hljs-attr">type</span>: <span class="hljs-string">'date'</span>, <span class="hljs-attr">dateFormat</span>: <span class="hljs-string">'Y-m-d'</span>} <span class="hljs-comment">// 处理日期格式</span>
