        }
        <span class="hljs-keyword">if</span> (phoneField) {
            phoneField.setValue(phoneNumber);
        }
        
        Ext.Msg.alert(<span class="hljs-string">'自动填充'</span>, <span class="hljs-string">'已根据供应商自动带出联系人信息'</span>);
    }
});
