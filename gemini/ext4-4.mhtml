ty="1" transform="matrix(1,0,0,1,0,0)"><path stroke="url(#__lottie_element_1556)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4" stroke-opacity="1" stroke-width="2" d=" M14.303000450134277,4.5279998779296875 C12.380999565124512,10.597000122070312 6.701000213623047,15 0,15 C-4.961999893188477,15 -9.36400032043457,12.586000442504883 -12.095000267028809,8.869000434875488"></path></g></g><g transform="matrix(1,0,0,1,16,16)" opacity="1" style="display: none;"><g opacity="1" transform="matrix(1,0,0,1,0,0)"><path stroke="url(#__lottie_element_1552)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4" stroke-opacity="1" stroke-width="2" d=" M-5.741000175476074,-13.859999656677246 C-3.9719998836517334,-14.595000267028809 -2.0329999923706055,-15 0,-15 C0,-15 0,-15 0,-15 C1.2580000162124634,-15 2.4800000190734863,-14.845000267028809 3.6489999294281006,-14.552000045776367"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_1548)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_1544)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_1537)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g></g></svg></div></div></bard-avatar><!----><!----></div><!----><div _ngcontent-ng-c1330069915="" class="response-container-content ng-tns-c1330069915-278 is-mobile has-thoughts"><div _ngcontent-ng-c1330069915="" class="menu-button-wrapper ng-tns-c1330069915-278 ng-star-inserted" style=""><button _ngcontent-ng-c1330069915="" mat-button="" mattooltip="More" tabindex="0" aria-label="Show more options" data-test-id="more-menu-button" class="mdc-button mat-mdc-button-base mat-mdc-tooltip-trigger icon-button more-button ng-tns-c1330069915-278 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" aria-describedby="cdk-describedby-message-ng-1-19" cdk-describedby-host="ng-1"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><mat-icon _ngcontent-ng-c1330069915="" role="img" fonticon="more_vert" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="more_vert"></mat-icon><span class="mdc-button__label"></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c535586177="" class="response-content ng-tns-c1330069915-278"><!----><model-thoughts _ngcontent-ng-c535586177="" data-test-id="model-thoughts" _nghost-ng-c636883080="" class="ng-tns-c636883080-280 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c636883080="" class="model-thoughts ng-tns-c636883080-280 is-mobile"><div _ngcontent-ng-c636883080="" class="thoughts-header ng-tns-c636883080-280"><button _ngcontent-ng-c636883080="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c636883080-280 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c636883080="" class="thoughts-header-button-content"><div _ngcontent-ng-c636883080="" class="thoughts-header-button-label ng-tns-c636883080-280"><span _ngcontent-ng-c636883080="" class="ng-tns-c636883080-280">Show thinking</span></div><div _ngcontent-ng-c636883080="" class="thoughts-header-button-icons ng-tns-c636883080-280"><!----><mat-icon _ngcontent-ng-c636883080="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c636883080-280 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----></div></model-thoughts><!----><!----><!----><message-content _ngcontent-ng-c535586177="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c1226125435="" id="message-content-id-r_45fd72be2ed47d4c" style="height: auto;"><div _ngcontent-ng-c1226125435="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_45fd72be2ed47d4c" aria-live="polite" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">在 ExtJS 4 中实现文件上传有一点<b>特殊</b>。</p><p data-path-to-node="1"><b>核心区别</b>：普通的表单提交或数据请求走的是标准的 Ajax (<code>XMLHttpRequest</code>)，但文件上传走的是 <b>Hidden IFrame</b> 模式（因为那时候的浏览器标准还不支持通过 Ajax 直接传二进制流）。</p><p data-path-to-node="2">这意味着：<b>千万不要用 <code>Ext.Ajax.request</code> 去上传文件，必须用 <code>form.submit()</code>。</b></p><p data-path-to-node="3">下面是标准的实现步骤：</p><hr data-path-to-node="4"><p data-path-to-node="5"></p><h3>1. 前端界面代码 (The View)</h3><p></p><p data-path-to-node="6">你需要使用 <code>xtype: 'filefield'</code> (文件选择框)。必须把它放在一个 <code>Ext.form.Panel</code> 里面。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-289 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-289 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_45fd72be2ed47d4c&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_1a8210d1a2862a06&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQ0gI" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-289 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-289">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-289 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-289 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_45fd72be2ed47d4c&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_1a8210d1a2862a06&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-289"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-289"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-289"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-289">Ext.create(<span class="hljs-string">'Ext.window.Window'</span>, {
    <span class="hljs-attr">title</span>: <span class="hljs-string">'文件上传'</span>,
    <span class="hljs-attr">width</span>: <span class="hljs-number">400</span>,
    <span class="hljs-attr">bodyPadding</span>: <span class="hljs-number">10</span>,
    <span class="hljs-attr">modal</span>: <span class="hljs-literal">true</span>,
    <span class="hljs-attr">items</span>: [{
        <span class="hljs-attr">xtype</span>: <span class="hljs-string">'form'</span>, <span class="hljs-comment">// 必须是 form panel</span>
        <span class="hljs-attr">border</span>: <span class="hljs-literal">false</span>,
        <span class="hljs-attr">defaults</span>: {
            <span class="hljs-attr">anchor</span>: <span class="hljs-string">'100%'</span>,
            <span class="hljs-attr">allowBlank</span>: <span class="hljs-literal">false</span>,
            <span class="hljs-attr">msgTarget</span>: <span class="hljs-string">'side'</span>,
            <span class="hljs-attr">labelWidth</span>: <span class="hljs-number">60</span>
        },
        <span class="hljs-attr">items</span>: [{
            <span class="hljs-attr">xtype</span>: <span class="hljs-string">'textfield'</span>,
            <span class="hljs-attr">fieldLabel</span>: <span class="hljs-string">'名称'</span>,
            <span class="hljs-attr">name</span>: <span class="hljs-string">'fileName'</span> <span class="hljs-comment">// 普通字段</span>
        },{
            <span class="hljs-comment">// --- 核心组件 ---</span>
            <span class="hljs-attr">xtype</span>: <span class="hljs-string">'filefield'</span>, 
            <span class="hljs-attr">name</span>: <span class="hljs-string">'attachment'</span>, <span class="hljs-comment">// 后台接收文件的参数名 (比如 SpringMVC 的 @RequestParam("attachment"))</span>
            <span class="hljs-attr">fieldLabel</span>: <span class="hljs-string">'文件'</span>,
            <span class="hljs-attr">buttonText</span>: <span class="hljs-string">'浏览...'</span>,
            
            <span class="hljs-comment">// 限制文件类型 (前端正则校验)</span>
            <span class="hljs-comment">// 比如只允许图片</span>
            <span class="hljs-attr">validator</span>: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">value</span>) </span>{
                <span class="hljs-keyword">if</span> (!value.match(<span class="hljs-regexp">/\.(jpg|jpeg|png|gif)$/i</span>)) {
                    <span class="hljs-keyword">return</span> <span class="hljs-string">'只允许上传图片文件'</span>;
                }
                <span class="hljs-keyword">return</span> <span class="hljs-literal">true</span>;
            }
        }],
        
        <span class="hljs-attr">buttons</span>: [{
            <span class="hljs-attr">text</span>: <span class="hljs-string">'上传'</span>,
            <span class="hljs-attr">handler</span>: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params"></span>) </span>{
                <span class="hljs-keyword">var</span> formPanel = <span class="hljs-built_in">this</span>.up(<span class="hljs-string">'form'</span>);
                <span class="hljs-keyword">var</span> form = formPanel.getForm();

                <span class="hljs-keyword">if</span> (form.isValid()) {
                    <span class="hljs-comment">// --- 核心提交逻辑 ---</span>
                    form.submit({
                        <span class="hljs-attr">url</span>: <span class="hljs-string">'/api/upload'</span>, <span class="hljs-comment">// 后台接口</span>
                        <span class="hljs-attr">waitMsg</span>: <span class="hljs-string">'正在上传文件...'</span>, <span class="hljs-comment">// 自动带 Loading 遮罩</span>
                        
                        <span class="hljs-attr">success</span>: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">fp, o</span>) </span>{
                            <span class="hljs-comment">// o.result 是后台返回的 JSON 对象</span>
                            Ext.Msg.alert(<span class="hljs-string">'成功'</span>, <span class="hljs-string">'上传成功，文件路径：'</span> + o.result.filePath);
                        },
                        
                        <span class="hljs-attr">failure</span>: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">fp, o</span>) </span>{
                            Ext.Msg.alert(<span class="hljs-string">'失败'</span>, o.result.msg || <span class="hljs-string">'上传失败'</span>);
                        }
                    });
                }
            }
        }]
    }]
}).show();
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="8"><p data-path-to-node="9"></p><h3>2. 后台返回数据的“巨坑” (The Backend Trap)</h3><p></p><p data-path-to-node="10">这是 ExtJS 4 文件上传<b>最容易出错</b>的地方。</p><p data-path-to-node="11">由于 ExtJS 4 使用的是 iframe 模拟上传，如果后台返回标准的 JSON (<code>Content-Type: application/json</code>)，<b>某些浏览器（如老版本 IE 或 Chrome）会以为你要下载这个 JSON 文件，直接弹出一个下载框</b>，而不是把数据交给回调函数。</p><p data-path-to-node="12"><b>✅ 正确的后台做法</b>：
无论后台框架是 Java Spring、PHP 还是 Node.js，上传接口返回的 <code>Content-Type</code> 必须是 <b><code>text/html</code></b> 或 <b><code>text/plain</code></b>，哪怕你返回的内容是 JSON 字符串。</p><p data-path-to-node="13"><b>Spring MVC 示例：</b></p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-290 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-290 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_45fd72be2ed47d4c&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_1a8210d1a2862a06&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQ0wI" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-290 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-290">Java</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-290 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-290 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_45fd72be2ed47d4c&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_1a8210d1a2862a06&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-290"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-290"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-290"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-290"><span class="hljs-meta">@RequestMapping(value = "/upload", method = RequestMethod.POST)</span>
<span class="hljs-comment">// 注意：produces 必须设为 text/html，否则 ExtJS 4 可能解析失败</span>
<span class="hljs-meta">@ResponseBody(produces = "text/html;charset=UTF-8")</span> 
<span class="hljs-function"><span class="hljs-keyword">public</span> String <span class="hljs-title">upload</span><span class="hljs-params">(<span class="hljs-meta">@RequestParam("attachment")</span> MultipartFile file)</span> </span>{
    <span class="hljs-comment">// ... 保存文件的逻辑 ...</span>
    
    <span class="hljs-comment">// 返回标准 JSON 字符串</span>
    <span class="hljs-keyword">return</span> <span class="hljs-string">"{ \"success\": true, \"msg\": \"上传成功\", \"filePath\": \"/uploads/a.jpg\" }"</span>;
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="15"><p data-path-to-node="16"></p><h3>3. 常见问题排查</h3><p></p><p data-path-to-node="17"></p><h4>Q1: 点击上传后，界面一直卡在 "正在上传文件..."，也不报错？</h4><p></p><ul data-path-to-node="18"><li><p data-path-to-node="18,0,0"><b>原因</b>：后台返回的 JSON 格式不对。</p></li><li><p data-path-to-node="18,1,0"><b>解决</b>：ExtJS 的 <code>form.submit</code> 默认要求后台返回的数据里必须包含 <b><code>success: true</code></b>。如果后台只返回了 <code>{"id": 123}</code>，ExtJS 会认为请求失败（failure），或者解析不出来导致卡死。</p></li></ul><p data-path-to-node="19"></p><h4>Q2: 上传完文件，文本框里还留着文件名，怎么清空？</h4><p></p><ul data-path-to-node="20"><li><p data-path-to-node="20,0,0"><b>解决</b>：在 <code>success</code> 回调里调用 <code>formPanel.getForm().reset()</code>。但是，<code>filefield</code> 由于浏览器的安全限制，有时候 <code>reset()</code> 清不掉。</p></li><li><p data-path-to-node="20,1,0"><b>暴力清空法</b>：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-291 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-291 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_45fd72be2ed47d4c&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_1a8210d1a2862a06&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQ1AI" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-291 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-291">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-291 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-291 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_45fd72be2ed47d4c&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_1a8210d1a2862a06&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-291"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-291"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-291"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-291"><span class="hljs-comment">// 在 success 里</span>
<span class="hljs-keyword">var</span> fileField = formPanel.down(<span class="hljs-string">'filefield'</span>);
fileField.reset(); 
<span class="hljs-comment">// 如果 reset 不行，直接销毁重建或者重置 input 元素</span>
fileField.fileInputEl.dom.value = <span class="hljs-string">''</span>; 
fileField.setRawValue(<span class="hljs-string">''</span>);
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></li></ul><p data-path-to-node="21"></p><h4>Q3: 怎么做“上传进度条”？</h4><p></p><ul data-path-to-node="22"><li><p data-path-to-node="22,0,0"><b>ExtJS 4 原生</b>：<b>做不到</b>。</p></li><li><p data-path-to-node="22,1,0"><b>原因</b>：基于 iframe 的上传方式无法获取进度信息。</p></li><li><p data-path-to-node="22,2,0"><b>替代方案</b>：只能显示 infinite 的遮罩 (<code>waitMsg</code>)。如果非要进度条，需要引入 Flash 插件（SWFUpload，已淘汰）或者使用 HTML5 的特性重写 ExtJS 的底层上传逻辑（非常麻烦，不建议新手尝试）。</p></li></ul><hr data-path-to-node="23"><p data-path-to-node="24"></p><h3>总结</h3><p></p><ol start="1" data-path-to-node="25"><li><p data-path-to-node="25,0,0">用 <b><code>xtype: 'filefield'</code></b>。</p></li><li><p data-path-to-node="25,1,0">用 <b><code>form.submit()</code></b> 提交，<b>不要</b>用 <code>Ext.Ajax</code>。</p></li><li><p data-path-to-node="25,2,0">后台必须返回 <b><code>{success: true}</code></b>。</p></li><li><p data-path-to-node="25,3,0">后台 <code>Content-Type</code> 最好设为 <b><code>text/html</code></b>。</p></li></ol><p data-path-to-node="26"><b>下一步建议：</b>
文件上传成功后，通常需要在页面上把图片显示出来，或者提供下载链接。你知道 ExtJS 4 如何<b>渲染图片</b>以及如何实现<b>文件下载</b>（尤其是处理 Session 验证时的下载）吗？</p></div><!----></message-content><!----><!----><div _ngcontent-ng-c535586177="" class="response-footer is-mobile gap has-thoughts complete"><!----><!----><sources-list _ngcontent-ng-c535586177="" class="sources-list ng-star-inserted" style=""><!----></sources-list><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c535586177="" _nghost-ng-c3711665544="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c1330069915="" class="response-container-footer ng-tns-c1330069915-278"><!----><message-actions _ngcontent-ng-c535586177="" footer="" _nghost-ng-c3862268828="" class="ng-tns-c3862268828-288 ng-star-inserted" style=""><div _ngcontent-ng-c3862268828="" class="actions-container-v2 ng-tns-c3862268828-288 mobile"><!----><!----><div _ngcontent-ng-c3862268828="" class="spacer ng-tns-c3862268828-288 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c3862268828="" yposition="above" xposition="after" class="ng-tns-c3862268828-288"><!----></mat-menu><mat-menu _ngcontent-ng-c3862268828="" yposition="above" class="ng-tns-c3862268828-288"><!----></mat-menu><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></message-actions><!----><!----></div></div><!----></response-container><!----><!----><!----><!----><freemium-rag-disclaimer _ngcontent-ng-c535586177="" _nghost-ng-c3728931254="" class="ng-star-inserted" style=""><!----></freemium-rag-disclaimer><!----></div></model-response><div _ngcontent-ng-c3492214941="" class="restart-chat-button-scroll-placeholder ng-star-inserted"></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><freemium-file-upload-near-quota-disclaimer _ngcontent-ng-c3492214941="" class="with-chat-padding ng-star-insert