<b>注意：</b> 在 ExtJS 4 中，简单的列布局推荐用 <code>hbox</code> 替代，但如果要搞多行多列的复杂表单，<code>column</code> 布局还是很常用。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-42 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-42 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_549e435b6264093b&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_caeb9640c8d6e4de&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,1]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahcKEwjV3rLI7YWRAxUAAAAAHQAAAAAQLA" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-42 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-42">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-42 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-42 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_549e435b6264093b&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_caeb9640c8d6e4de&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,1]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-42"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-42"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-42"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-42">Ext.create(<span class="hljs-string">'Ext.panel.Panel'</span>, {
