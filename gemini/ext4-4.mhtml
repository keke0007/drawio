        <span class="hljs-comment">// 3. 赋值给其他文本框</span>
        <span class="hljs-comment">// 这里的 'contact' 和 'phone' 对应 View 里的 name 属性</span>
        <span class="hljs-keyword">var</span> contactField = basicForm.findField(<span class="hljs-string">'contact'</span>);
        <span class="hljs-keyword">var</span> phoneField = basicForm.findField(<span class="hljs-string">'phone'</span>);

        <span class="hljs-keyword">if</span> (contactField) {
