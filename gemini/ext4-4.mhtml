    <span class="hljs-attr">action</span>: <span class="hljs-string">'save'</span>,
    <span class="hljs-comment">// 错误点：这里已经绑定了一次事件</span>
    <span class="hljs-attr">handler</span>: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params"></span>) </span>{
        <span class="hljs-built_in">console</span>.log(<span class="hljs-string">'View里的handler触发了'</span>); 
