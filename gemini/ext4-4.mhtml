    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="8"><b>Controller (app/controller/Users.js):</b></p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-154 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-154 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_5483dcf6eb0f1ebc&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_568b80a2f7c6b5dc&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQrwE" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-154 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-154">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-154 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-154 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_5483dcf6eb0f1ebc&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_568b80a2f7c6b5dc&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-154"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-154"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-154"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-154">init: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-built_in">this</span>.control({
        <span class="hljs-string">'userlist button[action=save]'</span>: {
            <span class="hljs-comment">// 错误点：Controller 这里又监听了一次</span>
            <span class="hljs-attr">click</span>: <span class="hljs-built_in">this</span>.saveUser 
        }
    });
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="10"><b>后果</b>：ExtJS 会先执行 View 里的 <code>handler</code>，紧接着 Controller 监听到事件又执行一次。
<b>✅ 解决方法</b>：<b>删掉 View 里的 <code>handler</code></b>，只保留 Controller 里的监听。</p><hr data-path-to-node="11"><p data-path-to-node="12"></p><h3>原因二：Controller 选择器 (Selector) 太宽泛</h3><p></p><p data-path-to-node="13">如果你的页面上同时存在<b>两个</b>类似的组件，而你的选择器写得不够精确，一次点击可能会被多个监听器捕获，或者一个 Controller 监听到了两个按钮。</p><p data-path-to-node="14"><b>场景</b>：
你打开了一个“添加用户”的弹窗，没关闭，又打开了一个“编辑用户”的弹窗。这两个弹窗里都有一个 <code>action: 'save'</code> 的按钮。</p><p data-path-to-node="15"><b>❌ 错误代码：</b></p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-155 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-155 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_5483dcf6eb0f1ebc&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_568b80a2f7c6b5dc&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQsAE" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-155 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-155">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-155 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-155 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_5483dcf6eb0f1ebc&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_568b80a2f7c6b5dc&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-155"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-155"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-155"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-155"><span class="hljs-comment">// Controller</span>
<span class="hljs-built_in">this</span>.control({
    <span class="hljs-string">'button[action=save]'</span>: { <span class="hljs-comment">// 太宽泛了！所有带 save 动作的按钮都会触发</span>
        <span class="hljs-attr">click</span>: <span class="hljs-built_in">this</span>.saveUser
    }
});
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="17"><b>后果</b>：当你点其中一个按钮时，因为 ExtJS 的 Component Query 机制，有时候会导致意想不到的多次触发（尤其是当组件嵌套或 ID 冲突时）。</p><p data-path-to-node="18"><b>✅ 解决方法</b>：
加上<b>父组件的别名 (xtype)</b> 限定范围。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-156 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-156 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_5483dcf6eb0f1ebc&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_568b80a2f7c6b5dc&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQsQE" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-156 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-156">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-156 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-156 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_5483dcf6eb0f1ebc&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_568b80a2f7c6b5dc&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-156"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-156"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-156"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-156"><span class="hljs-built_in">this</span>.control({
    <span class="hljs-comment">// 只监听 "useredit" 窗口下的 save 按钮</span>
    <span class="hljs-string">'useredit button[action=save]'</span>: { 
        <span class="hljs-attr">click</span>: <span class="hljs-built_in">this</span>.saveUser
    }
});
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="20"><p data-path-to-node="21"></p><h3>原因三：Controller 被初始化了两次 (隐蔽 🕵️)</h3><p></p><p data-path-to-node="22">如果你的 <code>init</code> 方法执行了两次，那么 <code>this.control({...})</code> 就会运行两次，导致同一个事件被绑定了两个监听器。</p><p data-path-to-node="23"><b>怎么会初始化两次？</b></p><ol start="1" data-path-to-node="24"><li><p data-path-to-node="24,0,0">你在 <code>app.js</code> 的 <code>controllers: ['Users']</code> 里写了一次。</p></li><li><p data-path-to-node="24,1,0">你又在另一个 Controller 的 <code>controllers: []</code> 数组里引用了它（或者手动 <code>Ext.create</code> 了它）。</p></li><li><p data-path-to-node="24,2,0">或者你在 View 里使用了 <code>controller: 'Users'</code> (ExtJS 5+ 的写法，ExtJS 4 不支持但有时候混用会导致怪异行为)。</p></li></ol><p data-path-to-node="25"><b>✅ 解决方法</b>：
在 Controller 的 <code>init</code> 方法第一行打个 <code>console.log('Controller Init执行了')</code>。刷新页面，看控制台打印了几次。如果是两次，检查 <code>app.js</code> 和其他地方的引用。</p><hr data-path-to-node="26"><p data-path-to-node="27"></p><h3>原因四：事件冒泡 (Event Bubbling)</h3><p></p><p data-path-to-node="28">如果你的按钮里包含图标（Icon），或者特殊的 HTML 结构。
有时候点击图标（<code>&lt;img&gt;</code>）会触发一次，事件冒泡到按钮（<code>&lt;div&gt;</code>）又触发一次。</p><p data-path-to-node="29"><b>✅ 解决方法</b>：
虽然 ExtJS 的 Button 封装得很好，很少出这个问题，但如果是自定义组件，可以在事件处理函数最后加一行：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-157 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-157 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_5483dcf6eb0f1ebc&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_568b80a2f7c6b5dc&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwjV3rLI7YWRAxUAAAAAHQAAAAAQsgE" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-157 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-157">JavaScript</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-157 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-157 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_5483dcf6eb0f1ebc&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_568b80a2f7c6b5dc&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-157"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-157"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-157"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-157">saveUser: <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">button, e</span>) </span>{
