opy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-39"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-39"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-39"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-39">Ext.create(<span class="hljs-string">'Ext.window.Window'</span>, {
