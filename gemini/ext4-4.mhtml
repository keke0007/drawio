mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_079b7d0267749114&quot;,&quot;c_0bc7eac89b122205&quot;,null,&quot;rc_1870234defa87c57&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-246"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-246"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-246"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-246"><span class="hljs-keyword">var</span> store = Ext.create(<span class="hljs-string">'Ext.data.Store'</span>, {
