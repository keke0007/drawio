.message { padding: 10px; font-size: 14px; line-height: 120%; text-align: left; background-color: rgb(243, 250, 255); border-left: 5px solid rgb(199, 232, 255); border-bottom: 1px solid var(--box-border-color); color: rgb(51, 51, 51); cursor: pointer; }

