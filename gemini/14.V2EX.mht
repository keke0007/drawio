.backstage_node_access_avatar { padding: 10px; width: 32px; flex: 0 0 auto !important; }

.backstage_node_access_info { padding: 10px; text-align: left; width: 100%; flex: 1 1 0%; font-size: 14px; line-height: 150%; }

.backstage_node_access_op { width: auto; padding: 10px; background-color: rgb(245, 245, 245); font-size: 14px; flex: 0 0 auto !important; }

