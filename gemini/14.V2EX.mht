.grid_item:hover { background-color: rgb(240, 240, 240); box-shadow: rgba(0, 0, 0, 0.08) 0px 5px 20px inset; cursor: pointer; text-decoration: none; }

.thank_area { display: inline-block; line-height: 100%; vertical-align: middle; }

