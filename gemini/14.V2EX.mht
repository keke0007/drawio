.widgets { display: flex; flex-flow: wrap; padding: 5px; }

.social_label:link, .social_label:visited { background-color: rgb(249, 249, 249); padding: 5px 15px 5px 6px; font-size: 14px; line-height: 100%; text-decoration: none; display: inline-block; border-radius: 20px; outline: 0px; margin: 5px; }

.social_label:hover { background-color: rgb(233, 233, 233); outline: 0px; }

.social_label:active { box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 5px inset; outline: 0px; }

.node_impressions { display: flex; border-bottom: 1px solid var(--box-border-color); }

.node_impressions_avatar { padding: 10px; width: 73px; flex: 0 0 auto !important; }

.node_impressions_info { padding: 10px; text-align: left; width: 240px; flex: 0 0 auto !important; }

