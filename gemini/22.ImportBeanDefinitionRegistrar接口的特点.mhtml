 stroke="url(#__lottie_element_2868)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4" stroke-opacity="1" stroke-width="2" d=" M6.734000205993652,-13.404999732971191 C11.635000228881836,-10.935999870300293 15,-5.857999801635742 15,0 C15,2 14.607999801635742,3.9079999923706055 13.895999908447266,5.6529998779296875"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_2864)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_2860)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_2853)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g></g></svg></div></div></bard-avatar><!----><!----></div><!----><div _ngcontent-ng-c1330069915="" class="response-container-content ng-tns-c1330069915-314 is-mobile has-thoughts"><div _ngcontent-ng-c1330069915="" class="menu-button-wrapper ng-tns-c1330069915-314 ng-star-inserted" style=""><button _ngcontent-ng-c1330069915="" mat-button="" mattooltip="More" tabindex="0" aria-label="Show more options" data-test-id="more-menu-button" class="mdc-button mat-mdc-button-base mat-mdc-tooltip-trigger icon-button more-button ng-tns-c1330069915-314 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" aria-describedby="cdk-describedby-message-ng-1-160" cdk-describedby-host="ng-1"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><mat-icon _ngcontent-ng-c1330069915="" role="img" fonticon="more_vert" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="more_vert"></mat-icon><span class="mdc-button__label"></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c535586177="" class="response-content ng-tns-c1330069915-314"><!----><model-thoughts _ngcontent-ng-c535586177="" data-test-id="model-thoughts" _nghost-ng-c636883080="" class="ng-tns-c636883080-316 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c636883080="" class="model-thoughts ng-tns-c636883080-316 is-mobile"><div _ngcontent-ng-c636883080="" class="thoughts-header ng-tns-c636883080-316"><button _ngcontent-ng-c636883080="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c636883080-316 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c636883080="" class="thoughts-header-button-content"><div _ngcontent-ng-c636883080="" class="thoughts-header-button-label ng-tns-c636883080-316"><span _ngcontent-ng-c636883080="" class="ng-tns-c636883080-316">Show thinking</span></div><div _ngcontent-ng-c636883080="" class="thoughts-header-button-icons ng-tns-c636883080-316"><!----><mat-icon _ngcontent-ng-c636883080="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c636883080-316 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----></div></model-thoughts><!----><!----><!----><message-content _ngcontent-ng-c535586177="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c1226125435="" id="message-content-id-r_7accbdfc7865758d" style="height: auto;"><div _ngcontent-ng-c1226125435="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_7accbdfc7865758d" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">你说得很对，在多数据源场景下，如果没有指定 <code>Primary</code>（主数据源），Spring 在进行 <code>@Autowired</code> 注入 <code>DataSource</code> 时会报 <code>NoUniqueBeanDefinitionException</code> 错误，因为容器里有多个同类型的 Bean，它不知道该选哪一个。</p><p data-path-to-node="1">我们需要在注册逻辑中增加判断：<b>读取配置文件中的 <code>primary</code> 属性，或者约定某个名字（如 <code>master</code>）为默认主数据源。</b></p><p data-path-to-node="2">下面是<b>修改后的完整实现方案</b>，增加了 <code>setPrimary(true)</code> 的逻辑。</p><p data-path-to-node="3"></p><h3>1. 修改配置文件 (application.yml)</h3><p></p><p data-path-to-node="4">我们在 <code>master</code> 数据源下显式增加一个 <code>primary: true</code> 的配置项。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-333 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-333 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_7accbdfc7865758d&quot;,&quot;c_965ca52fee0e6f85&quot;,null,&quot;rc_a579bb1274cd6d71&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwj7hdrNx4WRAxUAAAAAHQAAAAAQ_AM" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-333 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-333">YAML</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-333 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-333 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_7accbdfc7865758d&quot;,&quot;c_965ca52fee0e6f85&quot;,null,&quot;rc_a579bb1274cd6d71&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-333"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-333"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-333"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-333"><span class="hljs-attr">custom:</span>
  <span class="hljs-attr">datasources:</span>
    <span class="hljs-comment">#这是主数据源</span>
    <span class="hljs-attr">master:</span>
      <span class="hljs-attr">primary:</span> <span class="hljs-literal">true</span>   <span class="hljs-comment"># &lt;--- 关键配置：标记为主数据源</span>
      <span class="hljs-attr">driver-class-name:</span> <span class="hljs-string">com.mysql.cj.jdbc.Driver</span>
      <span class="hljs-attr">url:</span> <span class="hljs-string">jdbc:mysql://localhost:3306/db_master</span>
      <span class="hljs-attr">username:</span> <span class="hljs-string">root</span>
      <span class="hljs-attr">password:</span> <span class="hljs-string">password</span>
    <span class="hljs-comment"># 这是从数据源</span>
    <span class="hljs-attr">slave:</span>
      <span class="hljs-attr">driver-class-name:</span> <span class="hljs-string">com.mysql.cj.jdbc.Driver</span>
      <span class="hljs-attr">url:</span> <span class="hljs-string">jdbc:mysql://localhost:3306/db_slave</span>
      <span class="hljs-attr">username:</span> <span class="hljs-string">root</span>
      <span class="hljs-attr">password:</span> <span class="hljs-string">password</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="6"></p><h3>2. 修改注册逻辑 (MultiDataSourceRegistrar)</h3><p></p><p data-path-to-node="7">在 <code>registerBeanDefinitions</code> 方法中，我们解析这个 <code>primary</code> 属性，并调用 <code>BeanDefinitionBuilder.setPrimary(true)</code>。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-334 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-334 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_7accbdfc7865758d&quot;,&quot;c_965ca52fee0e6f85&quot;,null,&quot;rc_a579bb1274cd6d71&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwj7hdrNx4WRAxUAAAAAHQAAAAAQ_QM" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-334 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-334">Java</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-334 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-334 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_7accbdfc7865758d&quot;,&quot;c_965ca52fee0e6f85&quot;,null,&quot;rc_a579bb1274cd6d71&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-334"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-334"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-334"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-334"><span class="hljs-keyword">import</span> com.zaxxer.hikari.HikariDataSource;
<span class="hljs-keyword">import</span> org.springframework.beans.factory.support.BeanDefinitionBuilder;
<span class="hljs-keyword">import</span> org.springframework.beans.factory.support.BeanDefinitionRegistry;
<span class="hljs-keyword">import</span> org.springframework.boot.context.properties.bind.BindResult;
<span class="hljs-keyword">import</span> org.springframework.boot.context.properties.bind.Binder;
<span class="hljs-keyword">import</span> org.springframework.context.EnvironmentAware;
<span class="hljs-keyword">import</span> org.springframework.context.annotation.ImportBeanDefinitionRegistrar;
<span class="hljs-keyword">import</span> org.springframework.core.env.Environment;
<span class="hljs-keyword">import</span> org.springframework.core.type.AnnotationMetadata;

<span class="hljs-keyword">import</span> java.util.Map;

<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">MultiDataSourceRegistrar</span> <span class="hljs-keyword">implements</span> <span class="hljs-title">ImportBeanDefinitionRegistrar</span>, <span class="hljs-title">EnvironmentAware</span> </span>{

    <span class="hljs-keyword">private</span> Environment environment;

    <span class="hljs-meta">@Override</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">setEnvironment</span><span class="hljs-params">(Environment environment)</span> </span>{
        <span class="hljs-keyword">this</span>.environment = environment;
    }

    <span class="hljs-meta">@Override</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">registerBeanDefinitions</span><span class="hljs-params">(AnnotationMetadata importingClassMetadata, BeanDefinitionRegistry registry)</span> </span>{
        <span class="hljs-comment">// 1. 读取配置</span>
        Binder binder = Binder.get(environment);
        BindResult&lt;Map&gt; bindResult = binder.bind(<span class="hljs-string">"custom.datasources"</span>, Map.class);

        <span class="hljs-keyword">if</span> (!bindResult.isBound()) {
            <span class="hljs-keyword">return</span>;
        }

        Map&lt;String, Map&lt;String, Object&gt;&gt; dataSourcesConfig = bindResult.get();

        <span class="hljs-comment">// 2. 遍历配置</span>
        dataSourcesConfig.forEach((dsName, dsProperties) -&gt; {
            
            String beanName = dsName + <span class="hljs-string">"DataSource"</span>;
            BeanDefinitionBuilder builder = BeanDefinitionBuilder.genericBeanDefinition(HikariDataSource.class);

            <span class="hljs-comment">// --- 核心修改点 START ---</span>
            
            <span class="hljs-comment">// 获取配置中的 primary 属性，默认为 false</span>
            Object primaryObj = dsProperties.get(<span class="hljs-string">"primary"</span>);
            <span class="hljs-keyword">boolean</span> isPrimary = <span class="hljs-keyword">false</span>;
            
            <span class="hljs-keyword">if</span> (primaryObj != <span class="hljs-keyword">null</span>) {
                isPrimary = Boolean.parseBoolean(primaryObj.toString());
            } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (<span class="hljs-string">"master"</span>.equals(dsName)) {
                <span class="hljs-comment">// 可选策略：如果没配 primary 属性，但名字叫 master，也可以默认设为主数据源</span>
                isPrimary = <span class="hljs-keyword">true</span>; 
            }

            <span class="hljs-comment">// 如果是主数据源，调用 setPrimary(true)</span>
            <span class="hljs-keyword">if</span> (isPrimary) {
                builder.setPrimary(<span class="hljs-keyword">true</span>);
                System.out.println(<span class="hljs-string">"&gt;&gt;&gt; 设置 "</span> + beanName + <span class="hljs-string">" 为 Primary (主) 数据源"</span>);
            }
            
            <span class="hljs-comment">// --- 核心修改点 END ---</span>

            <span class="hljs-comment">// 设置常规属性</span>
            builder.addPropertyValue(<span class="hljs-string">"jdbcUrl"</span>, dsProperties.get(<span class="hljs-string">"url"</span>));
            builder.addPropertyValue(<span class="hljs-string">"username"</span>, dsProperties.get(<span class="hljs-string">"username"</span>));
            builder.addPropertyValue(<span class="hljs-string">"password"</span>, dsProperties.get(<span class="hljs-string">"password"</span>));
            builder.addPropertyValue(<span class="hljs-string">"driverClassName"</span>, dsProperties.get(<span class="hljs-string">"driver-class-name"</span>));

            <span class="hljs-comment">// 注册</span>
            registry.registerBeanDefinition(beanName, builder.getBeanDefinition());
        });
    }
}
