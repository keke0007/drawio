n;BardVeMetadataKey:[[&quot;r_bf5f6dd0a7142a3b&quot;,&quot;c_965ca52fee0e6f85&quot;,null,&quot;rc_d83968bdedd8bc15&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-356"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-356"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-356"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-356"><span class="hljs-meta">@Service</span>
<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">UserService</span> </span>{

    <span class="hljs-meta">@Autowired</span>
    <span class="hljs-keyword">private</span> JdbcTemplate jdbcTemplate; <span class="hljs-comment">// 注入的是路由数据源</span>

    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">doSomething</span><span class="hljs-params">()</span> </span>{
        <span class="hljs-comment">// 1. 默认情况：不传参数 -&gt; 走 master</span>
        String dbName = jdbcTemplate.queryForObject(<span class="hljs-string">"SELECT DATABASE()"</span>, String.class);
        System.out.println(<span class="hljs-string">"默认数据源: "</span> + dbName);

        <span class="hljs-keyword">try</span> {
            <span class="hljs-comment">// 2. 指定参数：切换到 slave</span>
            DataSourceContextHolder.setDataSourceType(<span class="hljs-string">"slave"</span>);
            
            String slaveName = jdbcTemplate.queryForObject(<span class="hljs-string">"SELECT DATABASE()"</span>, String.class);
            System.out.println(<span class="hljs-string">"切换后数据源: "</span> + slaveName);
            
        } <span class="hljs-keyword">finally</span> {
            <span class="hljs-comment">// 3. 务必清除，防止污染线程池中的下一个请求</span>
            DataSourceContextHolder.clearDataSourceType();
        }
        
        <span class="hljs-comment">// 4. 清除后：又回到默认 master</span>
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="21"></p><h3>方案总结</h3><p></p><ol start="1" data-path-to-node="22"><li><p data-path-to-node="22,0,0"><b><code>ManagedMap</code> + <code>RuntimeBeanReference</code></b>：这是在 <code>ImportBeanDefinitionRegistrar</code> 中处理 Bean 依赖关系的核心技巧。我们不能直接 <code>new</code> 数据源对象给 Router，而是要给它一个“指向未来 Bean 的引用”。</p></li><li><p data-path-to-node="22,1,0"><b>Router <code>@Primary</code></b>：我们把“路由数据源”设为 Primary，这样 Spring 框架（包括事务管理器）就会默认操作这个路由器，而路由器再根据 ThreadLocal 转发给底层的真实数据源。</p></li><li><p data-path-to-node="22,2,0"><b>默认回退</b>：Router 的 <code>defaultTargetDataSource</code> 属性保证了当 ThreadLocal 为空时，自动回退到 <code>master</code>。</p></li></ol></div><!----></message-content><!----><!----><div _ngcontent-ng-c535586177="" class="response-footer is-mobile gap has-thoughts complete"><!----><!----><sources-list _ngcontent-ng-c535586177="" class="sources-list ng-star-inserted" style=""><overview-carousel _nghost-ng-c825243532="" class="ng-star-inserted"><div _ngcontent-ng-c825243532="" jslog="268370;track:generic_click,impression"><!----><!----><sources-sidebar-button _ngcontent-ng-c825243532="" _nghost-ng-c3843965356="" class="ng-star-inserted"><!----><button _ngcontent-ng-c3843965356="" mat-stroked-button="" class="mdc-button mat-mdc-button-base legacy-sources-sidebar-button mdc-button--outlined mat-mdc-outlined-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="262207;track:generic_click,impression,attention" data-hveid="1"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><mat-icon