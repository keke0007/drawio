t;,&quot;c_965ca52fee0e6f85&quot;,null,&quot;rc_c6726c4c432acf05&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-311"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-311"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-311"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-311"><span class="hljs-keyword">import</span> com.zaxxer.hikari.HikariDataSource;
<span class="hljs-keyword">import</span> org.springframework.boot.context.properties.bind.BindResult;
<span class="hljs-keyword">import</span> org.springframework.boot.context.properties.bind.Binder;
<span class="hljs-keyword">import</span> org.springframework.context.EnvironmentAware;
<span class="hljs-keyword">import</span> org.springframework.context.annotation.ImportBeanDefinitionRegistrar;
<span class="hljs-keyword">import</span> org.springframework.core.env.Environment;
<span class="hljs-keyword">import</span> org.springframework.core.type.AnnotationMetadata;
<span class="hljs-keyword">import</span> org.springframework.beans.factory.support.BeanDefinitionBuilder;
<span class="hljs-keyword">import</span> org.springframework.beans.factory.support.BeanDefinitionRegistry;

<span class="hljs-keyword">import</span> javax.sql.DataSource;
<span class="hljs-keyword">import</span> java.util.Map;

<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">MultiDataSourceRegistrar</span> <span class="hljs-keyword">implements</span> <span class="hljs-title">ImportBeanDefinitionRegistrar</span>, <span class="hljs-title">EnvironmentAware</span> </span>{

    <span class="hljs-keyword">private</span> Environment environment;

    <span class="hljs-meta">@Override</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">setEnvironment</span><span class="hljs-params">(Environment environment)</span> </span>{
        <span class="hljs-keyword">this</span>.environment = environment;
    }

    <span class="hljs-meta">@Override</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">registerBeanDefinitions</span><span class="hljs-params">(AnnotationMetadata importingClassMetadata, BeanDefinitionRegistry registry)</span> </span>{
        <span class="hljs-comment">// 1. 利用 Spring Boot 的 Binder 读取 "custom.datasources" 下的所有属性</span>
        <span class="hljs-comment">//    将其绑定到一个 Map&lt;String, Map&lt;String, Object&gt;&gt; 结构中</span>
        <span class="hljs-comment">//    外层 Map 的 Key 是数据源名称 (如 master, slave)</span>
        <span class="hljs-comment">//    内层 Map 是具体配置 (如 url, username)</span>
        Binder binder = Binder.get(environment);
        BindResult&lt;Map&gt; bindResult = binder.bind(<span class="hljs-string">"custom.datasources"</span>, Map.class);

        <span class="hljs-keyword">if</span> (!bindResult.isBound()) {
            System.out.println(<span class="hljs-string">"未检测到多数据源配置，跳过注册。"</span>);
            <span class="hljs-keyword">return</span>;
        }

        Map&lt;String, Map&lt;String, Object&gt;&gt; dataSourcesConfig = bindResult.get();

        <span class="hljs-comment">// 2. 遍历配置，动态注册 Bean</span>
        dataSourcesConfig.forEach((dsName, dsProperties) -&gt; {
            
            <span class="hljs-comment">// 生成 Bean 的名字，例如 "masterDataSource"</span>
            String beanName = dsName + <span class="hljs-string">"DataSource"</span>;

            <span class="hljs-comment">// 3. 构建 BeanDefinition</span>
            <span class="hljs-comment">//    这里我们指定 Bean 的类型为 HikariDataSource</span>
            BeanDefinitionBuilder builder = BeanDefinitionBuilder.genericBeanDefinition(HikariDataSource.class);

            <span class="hljs-comment">// 4. 设置属性值</span>
            <span class="hljs-comment">//    注意：HikariCP 的属性名通常是 jdbcUrl, username, password, driverClassName</span>
            <span class="hljs-comment">//    我们需要将配置文件中的 key 映射到 Bean 的 setter 方法上</span>
            
            <span class="hljs-comment">// 简单处理：直接把 Map 里的值赋进去，Spring 会自动做类型转换</span>
            <span class="hljs-comment">// 假设 yaml 里的 key 和 HikariDataSource 的 setter 是一致的</span>
            <span class="hljs-comment">// 如果不一致（比如 yaml 写 url，Hikari 需要 jdbcUrl），需要在这里手动转换</span>
            builder.addPropertyValue(<span class="hljs-string">"jdbcUrl"</span>, dsProperties.get(<span class="hljs-string">"url"</span>));
            builder.addPropertyValue(<span class="hljs-string">"username"</span>, dsProperties.get(<span class="hljs-string">"username"</span>));
            builder.addPropertyValue(<span class="hljs-string">"password"</span>, dsProperties.get(<span class="hljs-string">"password"</span>));
            builder.addPropertyValue(<span class="hljs-string">"driverClassName"</span>, dsProperties.get(<span class="hljs-string">"driver-class-name"</span>));

            <span class="hljs-comment">// 5. 注册到容器</span>
            registry.registerBeanDefinition(beanName, builder.getBeanDefinition());
            
            System.out.println(<span class="hljs-string">"&gt;&gt;&gt; 已动态注册数据源 Bean: "</span> + beanName);
        });
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="18"></p><h3>5. 启动与测试</h3><p></p><p data-path-to-node="19">在你的 Spring Boot 启动类上加上注解：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-312 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-312 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_47b71a9547e04462&quot;,&quot;c_965ca52fee0e6f85&quot;,null,&quot;rc_c6726c4c432acf05&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwj7hdrNx4WRAxUAAAAAHQAAAAAQ4gM" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-312 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-312">Java</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-312 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-312 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_47b71a9547e04462&quot;,&quot;c_965ca52fee0e6f85&quot;,null,&quot;rc_c6726c4c432acf05&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-312"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-312"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-312"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-312"><span class="hljs-keyword">import</span> org.springframework.boot.SpringApplication;
<span class="hljs-keyword">import</span> org.springframework.boot.autoconfigure.SpringBootApplication;
<span class="hljs-keyword">import</span> org.springframework.context.ConfigurableApplicationContext;
<span class="hljs-keyword">import</span> javax.sql.DataSource;

<span class="hljs-meta">@SpringBootApplication</span>
<span class="hljs-meta">@EnableMultiDataSource</span> <span class="hljs-comment">// 开启多数据源自动注册</span>
<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">MultiDsApplication</span> </span>{

    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">static</span> <span class="hljs-keyword">void</span> <span class="hljs-title">main</span><span class="hljs-params">(String[] args)</span> </span>{
        ConfigurableApplicationContext context = SpringApplication.run(MultiDsApplication.class, args);

        <span class="hljs-comment">// 测试获取 Bean</span>
        <span class="hljs-keyword">if</span> (context.containsBean(<span class="hljs-string">"masterDataSource"</span>)) {
            DataSource master = context.getBean(<span class="hljs-string">"masterDataSource"</span>, DataSource.class);
            System.out.println(<span class="hljs-string">"获取到 master 数据源: "</span> + master);
        }

        <span class="hljs-keyword">if</span> (context.containsBean(<span class="hljs-string">"slaveDataSource"</span>)) {
            DataSource slave = context.getBean(<span class="hljs-string">"slaveDataSource"</span>, DataSource.class);
            System.out.println(<span class="hljs-string">"获取到 slave 数据源: "</span> + slave);
        }
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="21"></p><h3>进阶优化点（实际生产中需要考虑）</h3><p></p><p data-path-to-node="22">上述代码是一个最小可行性模型（MVP），在生产环境中，你可能需要考虑以下几点：</p><ol start="1" data-path-to-node="23"><li><p data-path-to-node="23,0,0"><b>属性绑定优化</b>：
上面的代码手动一个个 <code>get("url")</code> 比较麻烦且容易出错。更高级的做法是定义一个 POJO 类（例如 <code>DataSourceProperties</code>），利用 Binder 直接绑定成对象列表，然后再从对象取值。</p></li><li><p data-path-to-node="23,1,0"><b>Primary Bean (主数据源)</b>：
Spring 容器中如果存在多个同类型的 Bean（这里是多个 DataSource），在 <code>@Autowired</code> 时会报错。
你需要在注册逻辑中判断，如果名字叫 <code>master</code>（或者配置文件里有个 <code>primary: true</code> 属性），则调用 <code>builder.setPrimary(true)</code>。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c2179167942="" class="ng-tns-c2179167942-313 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2179167942="" class="code-block ng-tns-c2179167942-313 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_47b71a9547e04462&quot;,&quot;c_965ca52fee0e6f85&quot;,null,&quot;rc_c6726c4c432acf05&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwj7hdrNx4WRAxUAAAAAHQAAAAAQ4wM" style="display: block;"><div _ngcontent-ng-c2179167942="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2179167942-313 ng-star-inserted" style=""><span _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-313">Java</span><div _ngcontent-ng-c2179167942="" class="buttons ng-tns-c2179167942-313 ng-star-inserted"><button _ngcontent-ng-c2179167942="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2179167942-313 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_47b71a9547e04462&quot;,&quot;c_965ca52fee0e6f85&quot;,null,&quot;rc_c6726c4c432acf05&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2179167942="" role="img" fonticon="content_copy" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2179167942="" class="formatted-code-block-internal-container ng-tns-c2179167942-313"><div _ngcontent-ng-c2179167942="" class="animated-opacity ng-tns-c2179167942-313"><pre _ngcontent-ng-c2179167942="" class="ng-tns-c2179167942-313"><code _ngcontent-ng-c2179167942="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2179167942-313"><span class="hljs-keyword">if</span> (<span class="hljs-string">"master"</span>.equals(dsName)) {
    builder.setPrimary(<span class="hljs-keyword">true</span>);
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></li><li><p data-path-to-node="23,2,0"><b>与 DynamicDataSource 集成</b>：
通常多数据源不仅仅是注册多个 Bean，还需要一个 <code>AbstractRoutingDataSource</code> 来在运行时动态切换。
你可以在 <code>registerBeanDefinitions</code> 的最后，再注册一个名为 <code>dynamicDataSource</code> 的 Bean，把刚才注册的所有 datasource 引用放入这个路由数据源的 <code>targetDataSources</code> Map 中。</p></li></ol><p data-path-to-node="24"></p><h3>总结</h3><p></p><p data-path-to-node="25">通过这个方案，你实现了：</p><ol start="1" data-path-to-node="26"><li><p data-path-to-node="26,0,0"><b><code>EnvironmentAware</code></b>：拿到了 YAML 里的原始配置数据。</p></li><li><p data-path-to-node="26,1,0"><b><code>ImportBeanDefinitionRegistrar</code></b>：拿到了 <code>registry</code> 注册权。</p></li><li><p data-path-to-node="26,2,0"><b><code>Binder</code></b>：解决了“如何解析松散绑定的配置属性”的难题。</p></li></ol><p data-path-to-node="27">三者结合，完美实现了<b>配置驱动的动态 Bean 注册</b>。</p></div><!----></message-content><!----><!----><div _ngcontent-ng-c535586177="" class="response-footer is-mobile gap has-thoughts complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c535586177="" _nghost-ng-c3711665544="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c1330069915="" class="response-container-footer ng-tns-c1330069915-283"><!----><message-actions _ngcontent-ng-c535586177="" footer="" _nghost-ng-c3862268828="" class="ng-tns-c3862268828-299 ng-star-inserted hide-action-bar" style=""><div _ngcontent-ng-c3862268828="" class="actions-container-v2 ng-tns-c3862268828-299 mobile"><!----><!----><div _ngcontent-ng-c3862268828="" class="spacer ng-tns-c3862268828-299 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c3862268828="" yposition="above" xposition="after" class="ng-tns-c3862268828-299"><!----></mat-menu><mat-menu _ngcontent-ng-c3862268828="" yposition="above" class="ng-tns-c3862268828-299"><!----></mat-menu><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></message-actions><!----><!----></div></div><!----></response-container><!----><!--