<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">Car</span> </span>{
    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-title">Car</span><span class="hljs-params">()</span> </span>{ System.out.println(<span class="hljs-string">"Car 构造器被调用"</span>); }
}

<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">Driver</span> </span>{
    <span class="hljs-keyword">private</span> Car car;
    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-title">Driver</span><span class="hljs-params">(Car car)</span> </span>{ <span class="hljs-keyword">this</span>.car = car; }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h4 data-path-to-node="13">情况 A：使用 <code>@Configuration</code> (正确，单例)</h4><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4103393053="" class="ng-tns-c4103393053-217 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4103393053="" class="code-block ng-tns-c4103393053-217 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_21cf4e43742ea73e&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_78fd2441b2cd0045&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwiW6Obizr-RAxUAAAAAHQAAAAAQ1wI" style="display: block;"><div _ngcontent-ng-c4103393053="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4103393053-217 ng-star-inserted" style=""><span _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-217">Java</span><div _ngcontent-ng-c4103393053="" class="buttons ng-tns-c4103393053-217 ng-star-inserted"><button _ngcontent-ng-c4103393053="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4103393053-217 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_21cf4e43742ea73e&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_78fd2441b2cd0045&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4103393053="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4103393053="" class="formatted-code-block-internal-container ng-tns-c4103393053-217"><div _ngcontent-ng-c4103393053="" class="animated-opacity ng-tns-c4103393053-217"><pre _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-217"><code _ngcontent-ng-c4103393053="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4103393053-217"><span class="hljs-meta">@Configuration</span>
<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">AppConfig</span> </span>{

    <span class="hljs-meta">@Bean</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> Car <span class="hljs-title">car</span><span class="hljs-params">()</span> </span>{
        <span class="hljs-keyword">return</span> <span class="hljs-keyword">new</span> Car();
    }

    <span class="hljs-meta">@Bean</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> Driver <span class="hljs-title">driver</span><span class="hljs-params">()</span> </span>{
        <span class="hljs-comment">// 重点在这里！！</span>
        <span class="hljs-comment">// 我们直接调用了上面的 car() 方法</span>
        <span class="hljs-keyword">return</span> <span class="hljs-keyword">new</span> Driver(car()); 
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="15"><b>运行结果：</b></p><ul data-path-to-node="16"><li><p data-path-to-node="16,0,0"><code>Car 构造器被调用</code> <b>(只打印 1 次)</b></p></li><li><p data-path-to-node="16,1,0"><code>driver</code> 持有的 <code>car</code> 和容器里的 <code>car</code> 是<b>同一个对象</b>。</p></li></ul><h4 data-path-to-node="17">情况 B：使用 <code>@Component</code> (错误，多例)</h4><p data-path-to-node="18">如果你把 <code>@Configuration</code> 换成 <code>@Component</code>：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4103393053="" class="ng-tns-c4103393053-218 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4103393053="" class="code-block ng-tns-c4103393053-218 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_21cf4e43742ea73e&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_78fd2441b2cd0045&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwiW6Obizr-RAxUAAAAAHQAAAAAQ2AI" style="display: block;"><div _ngcontent-ng-c4103393053="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4103393053-218 ng-star-inserted" style=""><span _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-218">Java</span><div _ngcontent-ng-c4103393053="" class="buttons ng-tns-c4103393053-218 ng-star-inserted"><button _ngcontent-ng-c4103393053="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4103393053-218 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_21cf4e43742ea73e&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_78fd2441b2cd0045&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4103393053="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4103393053="" class="formatted-code-block-internal-container ng-tns-c4103393053-218"><div _ngcontent-ng-c4103393053="" class="animated-opacity ng-tns-c4103393053-218"><pre _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-218"><code _ngcontent-ng-c4103393053="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4103393053-218"><span class="hljs-meta">@Component</span>
<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">AppConfig</span> </span>{ <span class="hljs-comment">// 这里改成了 Component</span>

    <span class="hljs-meta">@Bean</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> Car <span class="hljs-title">car</span><span class="hljs-params">()</span> </span>{
        <span class="hljs-keyword">return</span> <span class="hljs-keyword">new</span> Car();
    }

    <span class="hljs-meta">@Bean</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> Driver <span class="hljs-title">driver</span><span class="hljs-params">()</span> </span>{
        <span class="hljs-comment">// 这里再次调用 car()</span>
        <span class="hljs-keyword">return</span> <span class="hljs-keyword">new</span> Driver(car()); 
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="20"><b>运行结果：</b></p><ul data-path-to-node="21"><li><p data-path-to-node="21,0,0"><code>Car 构造器被调用</code> <b>(打印 2 次！！)</b></p></li><li><p data-path-to-node="21,1,0">第一次是 Spring 扫描 <code>car()</code> 方法创建 Bean 时。</p></li><li><p data-path-to-node="21,2,0">第二次是 <code>driver()</code> 方法内部执行 <code>car()</code> 代码时（就像普通 Java 方法调用一样，执行了 <code>new Car()</code>）。</p></li><li><p data-path-to-node="21,3,0"><b>后果：</b> Driver 用的是一个全新的 Car，而不是 Spring 容器里管理的那个 Car。这会导致事务失效、连接池多创建等严重 Bug。</p></li></ul><hr data-path-to-node="22"><h3 data-path-to-node="23">3. 底层原理：CGLIB 魔法</h3><p data-path-to-node="24">为什么 <code>@Configuration</code> 那么智能？</p><p data-path-to-node="25">当 Spring 启动时，它会检查类上是否有 <code>@Configuration</code> 注解。如果有，Spring 不会直接实例化这个类，而是利用 <b>CGLIB</b> 生成一个<b>代理子类</b>（比如 <code>AppConfig$$EnhancerBySpringCGLIB</code>）。</p><p data-path-to-node="26">在这个代理类中，<code>car()</code> 方法大概长这样（伪代码）：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4103393053="" class="ng-tns-c4103393053-219 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4103393053="" class="code-block ng-tns-c4103393053-219 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_21cf4e43742ea73e&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_78fd2441b2cd0045&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwiW6Obizr-RAxUAAAAAHQAAAAAQ2QI" style="display: block;"><div _ngcontent-ng-c4103393053="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4103393053-219 ng-star-inserted" style=""><span _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-219">Java</span><div _ngcontent-ng-c4103393053="" class="buttons ng-tns-c4103393053-219 ng-star-inserted"><button _ngcontent-ng-c4103393053="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4103393053-219 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_21cf4e43742ea73e&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_78fd2441b2cd0045&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4103393053="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4103393053="" class="formatted-code-block-internal-container ng-tns-c4103393053-219"><div _ngcontent-ng-c4103393053="" class="animated-opacity ng-tns-c4103393053-219"><pre _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-219"><code _ngcontent-ng-c4103393053="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4103393053-219"><span class="hljs-comment">// CGLIB 生成的代理逻辑</span>
<span class="hljs-function"><span class="hljs-keyword">public</span> Car <span class="hljs-title">car</span><span class="hljs-params">()</span> </span>{
    <span class="hljs-comment">// 1. 先去 Spring 容器里查，有没有名为 "car" 的 Bean？</span>
    Object bean = applicationContext.getBean(<span class="hljs-string">"car"</span>);
    
    <span class="hljs-comment">// 2. 如果有，直接返回容器里的 Bean (保证单例)</span>
    <span class="hljs-keyword">if</span> (bean != <span class="hljs-keyword">null</span>) {
        <span class="hljs-keyword">return</span> (Car) bean;
    }
    
    <span class="hljs-comment">// 3. 如果没有，才调用父类(你自己写的 AppConfig)的 car() 方法去 new 一个，并存入容器</span>
    <span class="hljs-keyword">return</span> <span class="hljs-keyword">super</span>.car();
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="28">而 <b><code>@Component</code></b> 模式下（Lite Mode），Spring 只是把它当作一个普通的 Bean，不会创建 CGLIB 代理。所以你在 <code>driver()</code> 里调用 <code>car()</code>，就是纯粹的 Java 方法跳转，没有任何拦截机制，自然就直接 <code>new</code> 了一个新对象。</p><hr data-path-to-node="29"><h3 data-path-to-node="30">4. 最佳实践建议</h3><p data-path-to-node="31">为了避免隐晦的 Bug，请遵循以下规则：</p><ol start="1" data-path-to-node="32"><li><p data-path-to-node="32,0,0"><b>定义 Bean 时，永远使用 <code>@Configuration</code>：</b>
只要你的类里包含 <code>@Bean</code> 方法，特别是这些方法之间存在相互调用关系时，必须用 <code>@Configuration</code>。</p></li><li><p data-path-to-node="32,1,0"><b>业务组件使用 <code>@Component</code>（或 @Service, @Controller）：</b>
如果是普通的业务类，仅仅是通过 <code>@Autowired</code> 注入属性，没有定义 <code>@Bean</code> 方法，或者是为了简单的导入第三方类（Lite Mode），才使用 <code>@Component</code>。</p></li><li><p data-path-to-node="32,2,0"><b>如果非要在 <code>@Component</code> 里定义 <code>@Bean</code> 怎么办？</b>
不要直接调用方法，而是通过<b>方法参数注入</b>，这样 Spring 会自动处理依赖，无论是在 Component 还是 Configuration 下都安全：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4103393053="" class="ng-tns-c4103393053-220 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4103393053="" class="code-block ng-tns-c4103393053-220 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_21cf4e43742ea73e&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_78fd2441b2cd0045&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwiW6Obizr-RAxUAAAAAHQAAAAAQ2gI" style="display: block;"><div _ngcontent-ng-c4103393053="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4103393053-220 ng-star-inserted" style=""><span _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-220">Java</span><div _ngcontent-ng-c4103393053="" class="buttons ng-tns-c4103393053-220 ng-star-inserted"><button _ngcontent-ng-c4103393053="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4103393053-220 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_21cf4e43742ea73e&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_78fd2441b2cd0045&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4103393053="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4103393053="" class="formatted-code-block-internal-container ng-tns-c4103393053-220"><div _ngcontent-ng-c4103393053="" class="animated-opacity ng-tns-c4103393053-220"><pre _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-220"><code _ngcontent-ng-c4103393053="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4103393053-220"><span class="hljs-meta">@Component</span>
<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">AppConfig</span> </span>{
    <span class="hljs-meta">@Bean</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> Car <span class="hljs-title">car</span><span class="hljs-params">()</span> </span>{ <span class="hljs-keyword">return</span> <span class="hljs-keyword">new</span> Car(); }

    <span class="hljs-meta">@Bean</span>
    <span class="hljs-comment">// 安全写法：让 Spring 通过参数传进来，不要自己调 car()</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> Driver <span class="hljs-title">driver</span><span class="hljs-params">(Car car)</span> </span>{ 
        <span class="hljs-keyword">return</span> <span class="hljs-keyword">new</span> Driver(car); 
    }
