ot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_9af9213a1e1c8068&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4103393053="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4103393053="" class="formatted-code-block-internal-container ng-tns-c4103393053-294"><div _ngcontent-ng-c4103393053="" class="animated-opacity ng-tns-c4103393053-294"><pre _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-294"><code _ngcontent-ng-c4103393053="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4103393053-294">调用结果: 【RPC调用】请求地址: [http://api.google.com/users] -&gt; 接口: UserApi.getUserName
