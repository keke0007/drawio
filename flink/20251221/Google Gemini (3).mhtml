e-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_1271)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g><g style="display: none;"><g><path stroke="url(#__lottie_element_1264)" stroke-linecap="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g></g></svg></div></div></bard-avatar><!----><!----></div><!----><div _ngcontent-ng-c895538348="" class="response-container-content ng-tns-c895538348-138 is-mobile has-thoughts"><div _ngcontent-ng-c895538348="" class="menu-button-wrapper ng-tns-c895538348-138 ng-star-inserted" style=""><button _ngcontent-ng-c895538348="" mat-button="" mattooltip="更多" tabindex="0" aria-label="显示更多选项" data-test-id="more-menu-button" class="mdc-button mat-mdc-button-base mat-mdc-tooltip-trigger icon-button more-button ng-tns-c895538348-138 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" aria-describedby="cdk-describedby-message-ng-1-92" cdk-describedby-host="ng-1"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><mat-icon _ngcontent-ng-c895538348="" role="img" fonticon="more_vert" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="more_vert"></mat-icon><span class="mdc-button__label"></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1111299064="" class="response-content ng-tns-c895538348-138"><div _ngcontent-ng-c1111299064="" class="thoughts-container"><div _ngcontent-ng-c1111299064="" class="thoughts-content ng-star-inserted" style=""><div _ngcontent-ng-c1111299064="" class="thoughts-wrapper"><!----><model-thoughts _ngcontent-ng-c1111299064="" data-test-id="model-thoughts" _nghost-ng-c131964840="" class="ng-tns-c131964840-140 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c131964840="" class="model-thoughts ng-tns-c131964840-140 is-mobile"><div _ngcontent-ng-c131964840="" class="thoughts-header ng-tns-c131964840-140"><button _ngcontent-ng-c131964840="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c131964840-140 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c131964840="" class="thoughts-header-button-content"><div _ngcontent-ng-c131964840="" class="thoughts-header-button-label ng-tns-c131964840-140"><span _ngcontent-ng-c131964840="" class="ng-tns-c131964840-140">显示思路</span></div><div _ngcontent-ng-c131964840="" class="thoughts-header-button-icons ng-tns-c131964840-140"><!----><mat-icon _ngcontent-ng-c131964840="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c131964840-140 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><structured-content-container _ngcontent-ng-c1111299064="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c1156049544="" style="height: auto;"><div _ngcontent-ng-c1156049544="" class="container"><message-content _ngcontent-ng-c1156049544="" _nghost-ng-c1463213052="" id="message-content-id-r_6b9594e4b37e4444" class="ng-star-inserted"><div _ngcontent-ng-c1463213052="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_6b9594e4b37e4444" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">这是一个生产环境标准的 Spring Boot 异步线程池配置方案。</p><p data-path-to-node="1">这份配置包含了三个关键点，是为了防止生产事故必须具备的：</p><ol start="1" data-path-to-node="2"><li><p data-path-to-node="2,0,0"><b>合理的参数设置</b>（避免 OOM）。</p></li><li><p data-path-to-node="2,1,0"><b>拒绝策略</b>（当线程池满了怎么办）。</p></li><li><p data-path-to-node="2,2,0"><b>异常捕获</b>（异步任务报错了怎么记录日志）。</p></li></ol><h3 data-path-to-node="3">1. 完整的配置代码 (<code>AsyncConfiguration.java</code>)</h3><p data-path-to-node="4">你可以直接复制这个类到你的项目中。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4103393053="" class="ng-tns-c4103393053-158 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4103393053="" class="code-block ng-tns-c4103393053-158 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_6b9594e4b37e4444&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_df34420d73aec030&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwiW6Obizr-RAxUAAAAAHQAAAAAQkgI" style="display: block;"><div _ngcontent-ng-c4103393053="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4103393053-158 ng-star-inserted" style=""><span _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-158">Java</span><div _ngcontent-ng-c4103393053="" class="buttons ng-tns-c4103393053-158 ng-star-inserted"><button _ngcontent-ng-c4103393053="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4103393053-158 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_6b9594e4b37e4444&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_df34420d73aec030&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4103393053="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4103393053="" class="formatted-code-block-internal-container ng-tns-c4103393053-158"><div _ngcontent-ng-c4103393053="" class="animated-opacity ng-tns-c4103393053-158"><pre _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-158"><code _ngcontent-ng-c4103393053="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4103393053-158"><span class="hljs-keyword">import</span> org.slf4j.Logger;
<span class="hljs-keyword">import</span> org.slf4j.LoggerFactory;
<span class="hljs-keyword">import</span> org.springframework.aop.interceptor.AsyncUncaughtExceptionHandler;
<span class="hljs-keyword">import</span> org.springframework.context.annotation.Bean;
<span class="hljs-keyword">import</span> org.springframework.context.annotation.Configuration;
<span class="hljs-keyword">import</span> org.springframework.scheduling.annotation.AsyncConfigurer;
<span class="hljs-keyword">import</span> org.springframework.scheduling.annotation.EnableAsync;
<span class="hljs-keyword">import</span> org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;

<span class="hljs-keyword">import</span> java.lang.reflect.Method;
<span class="hljs-keyword">import</span> java.util.concurrent.Executor;
<span class="hljs-keyword">import</span> java.util.concurrent.ThreadPoolExecutor;

<span class="hljs-meta">@Configuration</span>
<span class="hljs-meta">@EnableAsync</span> <span class="hljs-comment">// 开启异步支持</span>
<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">AsyncConfiguration</span> <span class="hljs-keyword">implements</span> <span class="hljs-title">AsyncConfigurer</span> </span>{

    <span class="hljs-keyword">private</span> <span class="hljs-keyword">static</span> <span class="hljs-keyword">final</span> Logger log = LoggerFactory.getLogger(AsyncConfiguration.class);

    <span class="hljs-comment">/**
     * 定义核心线程池
     * 生产环境建议根据 CPU 核数设置：
     * IO 密集型 (如发邮件、查库): CPU核数 * 2
     * CPU 密集型 (如复杂计算): CPU核数 + 1
     */</span>
    <span class="hljs-meta">@Bean("asyncTaskExecutor")</span> <span class="hljs-comment">// 指定 Bean 名称，在使用 @Async 时可以指定</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> ThreadPoolTaskExecutor <span class="hljs-title">asyncTaskExecutor</span><span class="hljs-params">()</span> </span>{
        ThreadPoolTaskExecutor executor = <span class="hljs-keyword">new</span> ThreadPoolTaskExecutor();
        
        <span class="hljs-comment">// 1. 核心线程数：线程池创建时候初始化的线程数</span>
        <span class="hljs-keyword">int</span> processors = Runtime.getRuntime().availableProcessors();
        executor.setCorePoolSize(processors * <span class="hljs-number">2</span>); 
        
        <span class="hljs-comment">// 2. 最大线程数：线程池最大的线程数，只有在缓冲队列满了之后才会申请超过核心线程数的线程</span>
        executor.setMaxPoolSize(processors * <span class="hljs-number">4</span>);
        
        <span class="hljs-comment">// 3. 缓冲队列：用来缓冲执行任务的队列</span>
        <span class="hljs-comment">// 坑点：不要使用 Integer.MAX_VALUE，否则无限堆积导致 OOM</span>
        executor.setQueueCapacity(<span class="hljs-number">500</span>);
        
        <span class="hljs-comment">// 4. 线程的名称前缀：方便分析日志和 Dump 分析</span>
        executor.setThreadNamePrefix(<span class="hljs-string">"Async-Executor-"</span>);
        
        <span class="hljs-comment">// 5. 【关键】拒绝策略：当线程池满了，且队列也满了的时候，怎么处理？</span>
        <span class="hljs-comment">// CallerRunsPolicy: 由调用者所在的线程来执行任务。</span>
        <span class="hljs-comment">// 优点：保证任务不丢失，且能减缓提交任务的速度（主线程被占用了，没空发新任务）。</span>
        executor.setRejectedExecutionHandler(<span class="hljs-keyword">new</span> ThreadPoolExecutor.CallerRunsPolicy());
        
        <span class="hljs-comment">// 6. 优雅关闭：应用关闭时，是否等待任务执行结束</span>
        executor.setWaitForTasksToCompleteOnShutdown(<span class="hljs-keyword">true</span>);
        executor.setAwaitTerminationSeconds(<span class="hljs-number">60</span>); <span class="hljs-comment">// 等待时间</span>
        
        executor.initialize();
        <span class="hljs-keyword">return</span> executor;
    }

    <span class="hljs-comment">/**
     * 指定默认的 Executor
     * 如果 <span class="hljs-doctag">@Async</span> 没有指定名称，且容器中有多个 Executor，Spring 会迷茫。
     * 实现 AsyncConfigurer 接口的 getAsyncExecutor 方法可以指定默认使用的线程池。
     */</span>
    <span class="hljs-meta">@Override</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> Executor <span class="hljs-title">getAsyncExecutor</span><span class="hljs-params">()</span> </span>{
        <span class="hljs-keyword">return</span> asyncTaskExecutor();
    }

    <span class="hljs-comment">/**
     * 【关键】异常处理
     * 处理 void 返回值的异步方法抛出的异常。
     * 如果不配置，void 方法的异常会被吞掉，日志里什么都看不到！
     */</span>
    <span class="hljs-meta">@Override</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> AsyncUncaughtExceptionHandler <span class="hljs-title">getAsyncUncaughtExceptionHandler</span><span class="hljs-params">()</span> </span>{
        <span class="hljs-keyword">return</span> <span class="hljs-keyword">new</span> AsyncExceptionHandler();
    }

    <span class="hljs-comment">// 自定义异常处理类</span>
    <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">AsyncExceptionHandler</span> <span class="hljs-keyword">implements</span> <span class="hljs-title">AsyncUncaughtExceptionHandler</span> </span>{
        <span class="hljs-meta">@Override</span>
        <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">handleUncaughtException</span><span class="hljs-params">(Throwable throwable, Method method, Object... obj)</span> </span>{
            log.error(<span class="hljs-string">"Async Exec Error - Method: {}, Args: {}"</span>, method.getName(), obj, throwable);
            <span class="hljs-comment">// 这里可以添加告警逻辑，比如发钉钉/邮件通知</span>
        }
    }
}
