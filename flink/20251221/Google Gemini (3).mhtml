mdc-button-persistent-ripple mdc-button__ripple"></span><mat-icon _ngcontent-ng-c895538348="" role="img" fonticon="more_vert" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="more_vert"></mat-icon><span class="mdc-button__label"></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1111299064="" class="response-content ng-tns-c895538348-107"><div _ngcontent-ng-c1111299064="" class="thoughts-container"><div _ngcontent-ng-c1111299064="" class="thoughts-content ng-star-inserted" style=""><div _ngcontent-ng-c1111299064="" class="thoughts-wrapper"><!----><model-thoughts _ngcontent-ng-c1111299064="" data-test-id="model-thoughts" _nghost-ng-c131964840="" class="ng-tns-c131964840-109 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c131964840="" class="model-thoughts ng-tns-c131964840-109 is-mobile"><div _ngcontent-ng-c131964840="" class="thoughts-header ng-tns-c131964840-109"><button _ngcontent-ng-c131964840="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c131964840-109 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c131964840="" class="thoughts-header-button-content"><div _ngcontent-ng-c131964840="" class="thoughts-header-button-label ng-tns-c131964840-109"><span _ngcontent-ng-c131964840="" class="ng-tns-c131964840-109">显示思路</span></div><div _ngcontent-ng-c131964840="" class="thoughts-header-button-icons ng-tns-c131964840-109"><!----><mat-icon _ngcontent-ng-c131964840="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c131964840-109 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><structured-content-container _ngcontent-ng-c1111299064="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c1156049544="" style="height: auto;"><div _ngcontent-ng-c1156049544="" class="container"><message-content _ngcontent-ng-c1156049544="" _nghost-ng-c1463213052="" id="message-content-id-r_5fc3b308d542f2c4" class="ng-star-inserted"><div _ngcontent-ng-c1463213052="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_5fc3b308d542f2c4" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">Spring Cache 的实现原理本质上就是 <b>Spring AOP（面向切面编程） + 动态代理</b>。</p><p data-path-to-node="1">简单来说，Spring 在项目启动时，会扫描被注解（<code>@Cacheable</code>, <code>@CachePut</code>, <code>@CacheEvict</code>）标记的方法，为这些方法的类生成一个<b>代理对象</b>。在运行时，请求先到达代理对象，代理对象根据注解逻辑去操作缓存，最后决定是否调用目标方法。</p><p data-path-to-node="2">下面我把它分为 <b>“启动阶段”</b> 和 <b>“运行阶段”</b> 来详细讲解。</p><hr data-path-to-node="3"><h3 data-path-to-node="4">一、 核心架构图解</h3><p data-path-to-node="5">在深入细节前，先建立一个全局视角。Spring Cache 并不是自己去实现一个缓存存储（像 Redis 那样），它是一个<b>抽象层</b>。</p><p data-path-to-node="6">它定义了一套接口（<code>CacheManager</code>, <code>Cache</code>），然后通过 AOP 拦截方法调用，将具体的缓存操作委托给底层的实现（如 Redis, Caffeine, EHCache 等）。</p><hr data-path-to-node="7"><h3 data-path-to-node="8">二、 启动阶段：代理的创建</h3><p data-path-to-node="9">当你使用 <code>@EnableCaching</code> 注解开启缓存功能时，发生了一系列动作：</p><ol start="1" data-path-to-node="10"><li><p data-path-to-node="10,0,0"><b>注册核心组件：</b>
<code>@EnableCaching</code> 会向 Spring 容器导入一个配置类（<code>ProxyCachingConfiguration</code>）。这个配置类主要注册了三个 Bean：</p><ul data-path-to-node="10,0,1"><li><p data-path-to-node="10,0,1,0,0"><b><code>CacheOperationSource</code></b>：负责解析注解（比如读取 <code>@Cacheable</code> 里的 <code>value</code>, <code>key</code> 等属性）。</p></li><li><p data-path-to-node="10,0,1,1,0"><b><code>CacheInterceptor</code></b>：核心拦截器（Advice），这是真正执行缓存逻辑的地方。</p></li><li><p data-path-to-node="10,0,1,2,0"><b><code>BeanFactoryCacheOperationSourceAdvisor</code></b>：这是一个 Advisor（切面），它把上面两个组合在一起：Pointcut（切点）是“带有缓存注解的方法”，Advice（通知）是 <code>CacheInterceptor</code>。</p></li></ul></li><li><p data-path-to-node="10,1,0"><b>自动代理（Auto Proxying）：</b>
Spring 容器中有一个 <code>InfrastructureAdvisorAutoProxyCreator</code>（这是 BeanPostProcessor 的一种）。</p><ul data-path-to-node="10,1,1"><li><p data-path-to-node="10,1,1,0,0">当 Spring 创建你的 Bean（比如 <code>UserService</code>）时，这个 Creator 会检查：这个 Bean 的方法上有缓存注解吗？</p></li><li><p data-path-to-node="10,1,1,1,0"><b>如果有</b>，它就不会返回原始对象，而是利用 <b>JDK 动态代理</b> 或 <b>CGLIB</b> 生成一个代理对象。</p></li><li><p data-path-to-node="10,1,1,2,0">这个代理对象里持有了上面提到的 <code>CacheInterceptor</code>。</p></li></ul></li></ol><hr data-path-to-node="11"><h3 data-path-to-node="12">三、 运行阶段：拦截与执行</h3><p data-path-to-node="13">当你在代码中调用 <code>userService.getUserById(1)</code> 时，实际上是在调用代理对象。流程如下：</p><h4 data-path-to-node="14">1. 进入拦截器 (<code>CacheInterceptor</code>)</h4><p data-path-to-node="15">代理对象将调用转发给 <code>CacheInterceptor</code> 的 <code>invoke</code> 方法。这是整个缓存机制的大脑。</p><h4 data-path-to-node="16">2. 解析缓存操作</h4><p data-path-to-node="17">拦截器通过 <code>CacheOperationSource</code> 获取当前方法上的注解信息（是读缓存、写缓存还是删缓存？）。</p><h4 data-path-to-node="18">3. 执行具体的指令</h4><p data-path-to-node="19">根据不同的注解，执行不同的逻辑（伪代码逻辑）：</p><ul data-path-to-node="20"><li><p data-path-to-node="20,0,0"><b><code>@Cacheable</code> (查/存):</b></p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4103393053="" class="ng-tns-c4103393053-118 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4103393053="" class="code-block ng-tns-c4103393053-118 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_5fc3b308d542f2c4&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_260dc1d25cdeea7f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwiW6Obizr-RAxUAAAAAHQAAAAAQ5wE" style="display: block;"><div _ngcontent-ng-c4103393053="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4103393053-118 ng-star-inserted" style=""><span _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-118">Java</span><div _ngcontent-ng-c4103393053="" class="buttons ng-tns-c4103393053-118 ng-star-inserted"><button _ngcontent-ng-c4103393053="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4103393053-118 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_5fc3b308d542f2c4&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_260dc1d25cdeea7f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4103393053="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4103393053="" class="formatted-code-block-internal-container ng-tns-c4103393053-118"><div _ngcontent-ng-c4103393053="" class="animated-opacity ng-tns-c4103393053-118"><pre _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-118"><code _ngcontent-ng-c4103393053="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4103393053-118"><span class="hljs-comment">// 1. 根据 key 生成策略生成 Cache Key (默认是参数组合)</span>
Object key = generateKey(args);

<span class="hljs-comment">// 2. 去 CacheManager 找对应的 Cache 实例，再查找 Key</span>
Cache.ValueWrapper value = cache.get(key);

<span class="hljs-keyword">if</span> (value != <span class="hljs-keyword">null</span>) {
    <span class="hljs-comment">// 3. 【缓存命中】直接返回缓存值，不执行目标方法</span>
    <span class="hljs-keyword">return</span> value.get();
} <span class="hljs-keyword">else</span> {
    <span class="hljs-comment">// 4. 【缓存未命中】执行真正的目标方法 (查询数据库)</span>
    Object result = invocation.proceed();

    <span class="hljs-comment">// 5. 将结果写入缓存</span>
    cache.put(key, result);
    <span class="hljs-keyword">return</span> result;
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></li><li><p data-path-to-node="20,1,0"><b><code>@CachePut</code> (更新):</b>
不管缓存有没有，<b>强制执行</b>目标方法，并将返回值放入缓存中（用于更新数据库后同步更新缓存）。</p></li><li><p data-path-to-node="20,2,0"><b>@CacheEvict (删除):</b>
在目标方法执行前或执行后（取决于 <code>beforeInvocation</code> 属性），调用 <code>cache.evict(key)</code> 删除缓存。</p></li></ul><hr data-path-to-node="21"><h3 data-path-to-node="22">四、 关键组件总结</h3><p data-path-to-node="23">理解这四个组件，就理解了 Spring Cache：</p><div class="horizontal-scroll-wrapper"><div class="table-block-component"><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><table-block _nghost-ng-c280977563="" class="ng-star-inserted"><div _ngcontent-ng-c280977563="" class="table-block has-export-button"><div _ngcontent-ng-c280977563="" not-end-of-paragraph="" class="table-content not-end-of-paragraph" jslog="275421;track:impression,attention" data-hveid="0" decode-data-ved="1" data-ved="0CAAQ3ecQahgKEwiW6Obizr-RAxUAAAAAHQAAAAAQ6AE"><table data-path-to-node="24"><thead><tr><td><span data-path-to-node="24,0,0,0">组件</span></td><td><span data-path-to-node="24,0,1,0">作用</span></td><td><span data-path-to-node="24,0,2,0">现实类比</span></td></tr></thead><tbody><tr><td><span data-path-to-node="24,1,0,0"><b>CacheManager</b></span></td><td><span data-path-to-node="24,1,1,0">缓存管理器，管理各种 Cache 组件。</span></td><td><span data-path-to-node="24,1,2,0"><b>银行经理</b> (管理着多个金库)</span></td></tr><tr><td><span data-path-to-node="24,2,0,0"><b>Cache</b></span></td><td><span data-path-to-node="24,2,1,0">具体的缓存操作接口 (get, put, evict)。</span></td><td><span data-path-to-node="24,2,2,0"><b>金库</b> (具体的 Redis, Caffeine 实例)</span></td></tr><tr><td><span data-path-to-node="24,3,0,0"><b>CacheInterceptor</b></span></td><td><span data-path-to-node="24,3,1,0">AOP 通知，执行缓存逻辑。</span></td><td><span data-path-to-node="24,3,2,0"><b>柜员</b> (决定是去金库取钱，还是让你存钱)</span></td></tr><tr><td><span data-path-to-node="24,4,0,0"><b>KeyGenerator</b></span></td><td><span data-path-to-node="24,4,1,0">缓存 Key 的生成策略。</span></td><td><span data-path-to-node="24,4,2,0"><b>号牌生成器</b> (决定你的钱存哪个柜子)</span></td></tr></tbody></table></div><div _ngcontent-ng-c280977563="" hide-from-message-actions="" class="table-footer hide-from-message-actions ng-star-inserted"><!----><button _ngcontent-ng-c280977563="" mat-icon-button="" mattooltip="复制表格" aria-label="复制表格" data-test-id="copy-table-button" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="276666;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_5fc3b308d542f2c4&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,null,null,null,null,null,1,null,null,null,0]]"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c280977563="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-l google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----></div><!----></table-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></div></div><hr data-path-to-node="25"><h3 data-path-to-node="26">五、 常见的大坑（基于原理的推导）</h3><p data-path-to-node="27">既然知道了它是基于 <b>AOP 动态代理</b> 实现的，那么它就继承了 AOP 的所有局限性：</p><ol start="1" data-path-to-node="28"><li><p data-path-to-node="28,0,0"><b>内部调用失效 (Self-Invocation)：</b>
如果你在一个方法 <code>A</code> 中调用同一个类中的方法 <code>B</code>（<code>B</code> 上有 <code>@Cacheable</code>），缓存<b>不会生效</b>。</p><ul data-path-to-node="28,0,1"><li><p data-path-to-node="28,0,1,0,0"><b>原因：</b> <code>A</code> 调用 <code>B</code> 时，使用的是 <code>this.B()</code>，直接通过原始对象调用，绕过了 Spring 生成的代理对象，<code>CacheInterceptor</code> 根本没机会执行。</p></li></ul></li><li><p data-path-to-node="28,1,0"><b>非 public 方法失效：</b>
Spring 的代理机制（特别是 JDK 代理，以及默认的 CGLIB 配置）通常只拦截 <code>public</code> 方法。在 <code>private</code> 方法上加 <code>@Cacheable</code> 是无效的。</p></li><li><p data-path-to-node="28,2,0"><b>对象序列化问题：</b>
如果使用 Redis 等远程缓存，方法的返回值必须实现 <code>Serializable</code> 接口，否则存入缓存时会报错。</p></li></ol><h3 data-path-to-node="29">总结</h3><p data-path-to-node="30">Spring Cache 的魔法 = <b>注解解析器</b> (找到哪里需要缓存) + <b>AOP 动态代理</b> (拦截请求) + <b>拦截器逻辑</b> (先查缓存，没命中再查库)。</p><p data-path-to-node="31"><b>您是否遇到了“内部调用导致缓存失效”或者“缓存 Key 生成策略冲突”这类具体问题？我可以针对性地提供解决方案。</b></p></div><!----></message-content><!----></div></structured-content-container><!----><!----><!----><div _ngcontent-ng-c1111299064="" class="response-footer is-mobile gap has-thoughts complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c1111299064="" _nghost-ng-c1438932748="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c895538348="" class="response-container-footer ng-tns-c895538348-107"><!----><message-actions _ngcontent-ng-c1111299064="" footer="" _nghost-ng-c2607072150="" class="ng-tns-c2607072150-114 ng-star-inserted hide-action-bar" style=""><div _ngcontent-ng-c2607072150="" class="actions-container-v2 ng-tns-c2607072150-114 mobile"><!----><!----><div _ngcontent-ng-c2607072150="" class="spacer ng-tns-c2607072150-114 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c2607072150="" yposition="above" xposition="after" class="ng-tns-c2607072150-114"><!----></mat-menu><mat-menu _ngcontent-ng-c2607072150="" yposition="above" class="ng-tns-c2607072150-114"><!----></mat-menu><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></message-actions><!----><!----></div></div><!----></response-container><!----><!----><!----><!----><freemium-rag-disclaimer _ngcontent-ng-c1111299064="" _nghost-ng-c3728931254="" class="ng-star-inserted" style=""><!----></freemium-rag-disclaimer><!----></div></model-response><div _ngcontent-ng-c1708826894="" class="restart-chat-button-scroll-placeholder ng-star-inserte