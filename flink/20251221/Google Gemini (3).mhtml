-s ng-tns-c4103393053-274 ng-star-inserted" style=""><span _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-274">Java</span><div _ngcontent-ng-c4103393053="" class="buttons ng-tns-c4103393053-274 ng-star-inserted"><button _ngcontent-ng-c4103393053="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4103393053-274 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_f7f3c5e375058a6f&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_06cf42211cb8cec8&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4103393053="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4103393053="" class="formatted-code-block-internal-container ng-tns-c4103393053-274"><div _ngcontent-ng-c4103393053="" class="animated-opacity ng-tns-c4103393053-274"><pre _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-274"><code _ngcontent-ng-c4103393053="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4103393053-274"><span class="hljs-meta">@Service</span>
