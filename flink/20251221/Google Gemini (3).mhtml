ot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_1c204939553e45f6&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4103393053="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4103393053="" class="formatted-code-block-internal-container ng-tns-c4103393053-182"><div _ngcontent-ng-c4103393053="" class="animated-opacity ng-tns-c4103393053-182"><pre _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-182"><code _ngcontent-ng-c4103393053="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4103393053-182"><span class="hljs-keyword">import</span> org.springframework.beans.factory.annotation.Qualifier;
<span class="hljs-keyword">import</span> org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;
<span class="hljs-keyword">import</span> org.springframework.web.bind.annotation.GetMapping;
<span class="hljs-keyword">import</span> org.springframework.web.bind.annotation.RestController;

<span class="hljs-keyword">import</span> java.util.HashMap;
<span class="hljs-keyword">import</span> java.util.Map;
<span class="hljs-keyword">import</span> java.util.concurrent.ThreadPoolExecutor;

<span class="hljs-meta">@RestController</span>
<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">MonitorController</span> </span>{

    <span class="hljs-keyword">private</span> <span class="hljs-keyword">final</span> ThreadPoolTaskExecutor executor;

    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-title">MonitorController</span><span class="hljs-params">(<span class="hljs-meta">@Qualifier("asyncTaskExecutor")</span> ThreadPoolTaskExecutor executor)</span> </span>{
        <span class="hljs-keyword">this</span>.executor = executor;
    }

    <span class="hljs-meta">@GetMapping("/monitor/thread-pool")</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> Map&lt;String, Object&gt; <span class="hljs-title">getThreadPoolStats</span><span class="hljs-params">()</span> </span>{
        ThreadPoolExecutor core = executor.getThreadPoolExecutor();
        
        Map&lt;String, Object&gt; stats = <span class="hljs-keyword">new</span> HashMap&lt;&gt;();
        stats.put(<span class="hljs-string">"activeCount"</span>, core.getActiveCount()); <span class="hljs-comment">// 正在干活的线程</span>
        stats.put(<span class="hljs-string">"maxPoolSize"</span>, core.getMaxPoolSize()); <span class="hljs-comment">// 最大允许线程</span>
        stats.put(<span class="hljs-string">"poolSize"</span>, core.getPoolSize());       <span class="hljs-comment">// 当前实际线程</span>
        stats.put(<span class="hljs-string">"queueSize"</span>, core.getQueue().size());  <span class="hljs-comment">// 排队的任务数</span>
        stats.put(<span class="hljs-string">"taskCount"</span>, core.getTaskCount());     <span class="hljs-comment">// 历史总任务数</span>
        stats.put(<span class="hljs-string">"completedTaskCount"</span>, core.getCompletedTaskCount()); <span class="hljs-comment">// 已执行完的任务</span>
        stats.put(<span class="hljs-string">"isShutdown"</span>, core.isShutdown());
        
        <span class="hljs-keyword">return</span> stats;
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="11">访问 <code>http://localhost:8080/monitor/thread-pool</code> 即可得到 JSON 格式的实时数据。</p><hr data-path-to-node="12"><h3 data-path-to-node="13">进阶建议：接入 Prometheus + Grafana</h3><p data-path-to-node="14">如果你的公司有监控平台，最好的方式是使用 <b>Spring Boot Actuator</b>。</p><ol start="1" data-path-to-node="15"><li><p data-path-to-node="15,0,0">引入依赖：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4103393053="" class="ng-tns-c4103393053-183 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4103393053="" class="code-block ng-tns-c4103393053-183 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_5cf9f45e2b5fe79d&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_1c204939553e45f6&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwiW6Obizr-RAxUAAAAAHQAAAAAQswI" style="display: block;"><div _ngcontent-ng-c4103393053="" class="code-block-decoration header-formatted gds-title-s ng-tns-c4103393053-183 ng-star-inserted" style=""><span _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-183">XML</span><div _ngcontent-ng-c4103393053="" class="buttons ng-tns-c4103393053-183 ng-star-inserted"><button _ngcontent-ng-c4103393053="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c4103393053-183 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_5cf9f45e2b5fe79d&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,&quot;rc_1c204939553e45f6&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4103393053="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c4103393053="" class="formatted-code-block-internal-container ng-tns-c4103393053-183"><div _ngcontent-ng-c4103393053="" class="animated-opacity ng-tns-c4103393053-183"><pre _ngcontent-ng-c4103393053="" class="ng-tns-c4103393053-183"><code _ngcontent-ng-c4103393053="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c4103393053-183"><span class="hljs-tag">&lt;<span class="hljs-name">dependency</span>&gt;</span>
