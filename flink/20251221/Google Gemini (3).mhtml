    <span class="hljs-comment">// ... 你的匹配逻辑</span>
    <span class="hljs-keyword">return</span> <span class="hljs-keyword">true</span>; <span class="hljs-comment">// or false</span>
}

<span class="hljs-meta">@Override</span>
<span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">boolean</span> <span class="hljs-title">isRuntime</span><span class="hljs-params">()</span> </span>{
