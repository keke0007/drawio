google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="more_vert"></mat-icon><span class="mdc-button__label"></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1111299064="" class="response-content ng-tns-c895538348-184"><div _ngcontent-ng-c1111299064="" class="thoughts-container"><div _ngcontent-ng-c1111299064="" class="thoughts-content ng-star-inserted" style=""><div _ngcontent-ng-c1111299064="" class="thoughts-wrapper"><!----><model-thoughts _ngcontent-ng-c1111299064="" data-test-id="model-thoughts" _nghost-ng-c131964840="" class="ng-tns-c131964840-186 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c131964840="" class="model-thoughts ng-tns-c131964840-186 is-mobile"><div _ngcontent-ng-c131964840="" class="thoughts-header ng-tns-c131964840-186"><button _ngcontent-ng-c131964840="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c131964840-186 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c131964840="" class="thoughts-header-button-content"><div _ngcontent-ng-c131964840="" class="thoughts-header-button-label ng-tns-c131964840-186"><span _ngcontent-ng-c131964840="" class="ng-tns-c131964840-186">显示思路</span></div><div _ngcontent-ng-c131964840="" class="thoughts-header-button-icons ng-tns-c131964840-186"><!----><mat-icon _ngcontent-ng-c131964840="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c131964840-186 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><structured-content-container _ngcontent-ng-c1111299064="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c1156049544="" style="height: auto;"><div _ngcontent-ng-c1156049544="" class="container"><message-content _ngcontent-ng-c1156049544="" _nghost-ng-c1463213052="" id="message-content-id-r_21cf4e43742ea73e" class="ng-star-inserted"><div _ngcontent-ng-c1463213052="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_21cf4e43742ea73e" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">这是一个面试高频题，也是 Spring 进阶必须掌握的知识点。</p><p data-path-to-node="1">虽然 <code>@Configuration</code> 注解本质上也是被 <code>@Component</code> 元注解标记的（意味着它们都会被 Spring 扫描并注册为 Bean），但它们在处理 <b><code>@Bean</code> 方法的内部调用</b> 时，行为截然不同。</p><p data-path-to-node="2">一句话总结：
<b><code>@Configuration</code> 保证了 Bean 的单例性（Singleton），而 <code>@Component</code> 不能。</b></p><p data-path-to-node="3">下面我通过 <b>核心区别</b>、<b>代码演示</b> 和 <b>底层原理</b> 来详细拆解。</p><hr data-path-to-node="4"><h3 data-path-to-node="5">1. 核心区别：Full 模式 vs Lite 模式</h3><p data-path-to-node="6">Spring 把对配置类的处理分为两种模式：</p><div class="horizontal-scroll-wrapper"><div class="table-block-component"><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><table-block _nghost-ng-c280977563="" class="ng-star-inserted"><div _ngcontent-ng-c280977563="" class="table-block has-export-button"><div _ngcontent-ng-c280977563="" not-end-of-paragraph="" class="table-content not-end-of-paragraph" jslog="275421;track:impression,attention" data-hveid="0" decode-data-ved="1" data-ved="0CAAQ3ecQahgKEwiW6Obizr-RAxUAAAAAHQAAAAAQ1AI"><table data-path-to-node="7"><thead><tr><td><span data-path-to-node="7,0,0,0">特性</span></td><td><span data-path-to-node="7,0,1,0">@Configuration (Full Mode)</span></td><td><span data-path-to-node="7,0,2,0">@Component (Lite Mode)</span></td></tr></thead><tbody><tr><td><span data-path-to-node="7,1,0,0"><b>代理机制</b></span></td><td><span data-path-to-node="7,1,1,0"><b>CGLIB 动态代理</b></span></td><td><span data-path-to-node="7,1,2,0">无代理 (原样执行)</span></td></tr><tr><td><span data-path-to-node="7,2,0,0"><b>方法调用拦截</b></span></td><td><span data-path-to-node="7,2,1,0"><b>会拦截</b> <code>@Bean</code> 方法调用</span></td><td><span data-path-to-node="7,2,2,0"><b>不会拦截</b></span></td></tr><tr><td><span data-path-to-node="7,3,0,0"><b>跨方法调用结果</b></span></td><td><span data-path-to-node="7,3,1,0">返回 Spring 容器中的<b>单例</b>对象</span></td><td><span data-path-to-node="7,3,2,0">每次调用都 <b>new 一个新对象</b></span></td></tr><tr><td><span data-path-to-node="7,4,0,0"><b>适用场景</b></span></td><td><span data-path-to-node="7,4,1,0">定义 Bean 工厂、复杂的 Bean 依赖装配</span></td><td><span data-path-to-node="7,4,2,0">普通业务组件、简单 Bean 定义</span></td></tr></tbody></table></div><div _ngcontent-ng-c280977563="" hide-from-message-actions="" class="table-footer hide-from-message-actions ng-star-inserted"><!----><button _ngcontent-ng-c280977563="" mat-icon-button="" mattooltip="复制表格" aria-label="复制表格" data-test-id="copy-table-button" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="276666;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_21cf4e43742ea73e&quot;,&quot;c_24c1e6ef0cac682c&quot;,null,null,null,null,null,null,1,null,null,null,0]]"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c280977563="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-l google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----></div><!----></table-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></div></div><hr data-path-to-node="8"><h3 data-path-to-node="9">2. 代码演示（一针见血）</h3><p data-path-to-node="10">假设我们有两个类：<code>Driver</code> (司机) 和 <code>Car</code> (车)。司机依赖车。</p><h4 data-path-to-node="11">场景：在定义 Driver 时，直接调用了 <code>car()</code> 方法。</h4><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><code-block _nghost-ng-c4103393053="" class="ng-tns-c4103393053-216 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c4103393053="" class="code-block ng-t