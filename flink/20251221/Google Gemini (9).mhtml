    <span class="hljs-attr">container_name:</span> <span class="hljs-string">es-node</span>
    <span class="hljs-attr">environment:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">discovery.type=single-node</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">ES_JAVA_OPTS=-Xms512m</span> <span class="hljs-string">-Xmx512m</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">xpack.security.enabled=false</span>
    <span class="hljs-attr">ports:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">"9200:9200"</span>
    <span class="hljs-attr">volumes:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">es_data:/usr/share/elasticsearch/data</span>
    <span class="hljs-attr">networks:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">ai-net</span>

  <span class="hljs-comment"># ---------------------------------------------------------------</span>
  <span class="hljs-comment"># 2. Kibana 8.11.1</span>
  <span class="hljs-comment">#    选择原因：必须与 ES 主版本号严格一致。</span>
  <span class="hljs-comment"># ---------------------------------------------------------------</span>
  <span class="hljs-attr">kibana:</span>
    <span class="hljs-attr">image:</span> <span class="hljs-string">docker.elastic.co/kibana/kibana:8.11.1</span>
    <span class="hljs-attr">container_name:</span> <span class="hljs-string">kibana</span>
    <span class="hljs-attr">ports:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">"5601:5601"</span>
    <span class="hljs-attr">environment:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">ELASTICSEARCH_HOSTS=http://es:9200</span>
    <span class="hljs-attr">depends_on:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">es</span>
    <span class="hljs-attr">networks:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">ai-net</span>

  <span class="hljs-comment"># ---------------------------------------------------------------</span>
  <span class="hljs-comment"># 3. PostgreSQL (with pgvector v0.5.1)</span>
  <span class="hljs-comment">#    选择原因：v0.5.1 是引入 HNSW 索引后的第一个稳定大版本，文档丰富。</span>
  <span class="hljs-comment"># ---------------------------------------------------------------</span>
  <span class="hljs-attr">postgres:</span>
    <span class="hljs-attr">image:</span> <span class="hljs-string">ankane/pgvector:v0.5.1</span>
    <span class="hljs-attr">container_name:</span> <span class="hljs-string">pg-vector</span>
    <span class="hljs-attr">environment:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">POSTGRES_USER=postgres</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">POSTGRES_PASSWORD=secret</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">POSTGRES_DB=vectordb</span>
    <span class="hljs-attr">ports:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">"5432:5432"</span>
    <span class="hljs-attr">volumes:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">pg_data:/var/lib/postgresql/data</span>
    <span class="hljs-attr">networks:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">ai-net</span>

  <span class="hljs-comment"># ---------------------------------------------------------------</span>
  <span class="hljs-comment"># 4. Redis Stack 7.2.0-v9</span>
  <span class="hljs-comment">#    选择原因：锁定在 7.2 版本，包含 RediSearch 2.8 和 RedisJSON 2.6。</span>
  <span class="hljs-comment"># ---------------------------------------------------------------</span>
  <span class="hljs-attr">redis:</span>
    <span class="hljs-attr">image:</span> <span class="hljs-string">redis/redis-stack:7.2.0-v9</span>
    <span class="hljs-attr">container_name:</span> <span class="hljs-string">redis-stack</span>
    <span class="hljs-attr">ports:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">"6379:6379"</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">"8001:8001"</span>
    <span class="hljs-attr">volumes:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">redis_data:/data</span>
    <span class="hljs-attr">networks:</span>
      <span class="hljs-bullet">-</span> <span class="hljs-string">ai-net</span>

<span class="hljs-attr">volumes:</span>
  <span class="hljs-attr">es_data:</span>
  <span class="hljs-attr">pg_data:</span>
  <span class="hljs-attr">redis_data:</span>

<span class="hljs-attr">networks:</span>
  <span class="hljs-attr">ai-net:</span>
    <span class="hljs-attr">driver:</span> <span class="hljs-string">bridge</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="4"><h3 data-path-to-node="5">⚠️ 版本切换的注意事项 (重要)</h3><p data-path-to-node="6">由于你可能运行过之前的版本，或者之后想重置环境，<b data-path-to-node="6" data-index-in-node="24">只修改版本号是不够的</b>。数据库的数据文件格式往往不向下兼容。</p><p data-path-to-node="7">如果你之前已经运行过 <code data-path-to-node="7" data-index-in-node="11">docker-compose up</code>，在应用这个新文件之前，请务必执行以下命令来<b data-path-to-node="7" data-index-in-node="50">彻底清除旧数据</b>：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c2283161342="" class="ng-tns-c2283161342-822 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2283161342="" class="code-block ng-tns-c2283161342-822 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_1cf485bd93a026d2&quot;,&quot;c_5449f3519d0d8e03&quot;,null,&quot;rc_e75df151e0805bdf&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwiU8tXn5c6RAxUAAAAAHQAAAAAQ1gg" style="display: block;"><div _ngcontent-ng-c2283161342="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2283161342-822 ng-star-inserted" style=""><span _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-822">Bash</span><div _ngcontent-ng-c2283161342="" class="buttons ng-tns-c2283161342-822 ng-star-inserted"><button _ngcontent-ng-c2283161342="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-too