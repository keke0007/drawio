}

POST /my_vector_index/_doc/<span class="hljs-number">2</span>
{
  <span class="hljs-attr">"name"</span>: <span class="hljs-string">"Item B"</span>,
  <span class="hljs-attr">"my_vector"</span>: [<span class="hljs-number">0.1</span>, <span class="hljs-number">0.2</span>, <span class="hljs-number">0.3</span>, <span class="hljs-number">0.4</span>]
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 data-path-to-node="14">4. 第三步：Java 代码实现 (ES 7.x)</h3><p data-path-to-node="15">这里展示如何使用 <code data-path-to-node="15" data-index-in-node="9">RestHighLevelClient</code> 构建向量查询。</p><p data-path-to-node="16"><b data-path-to-node="16" data-index-in-node="0">依赖类：</b>
你需要用到 <code data-path-to-node="16" data-index-in-node="11">ScriptScoreQueryBuilder</code> 和 <code data-path-to-node="16" data-index-in-node="37">Script</code>。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c2283161342="" class="ng-tns-c2283161342-727 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2283161342="" class="code-block ng-tns-c2283161342-727 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_a3168757b8caf04f&quot;,&quot;c_5449f3519d0d8e03&quot;,null,&quot;rc_1814a00c0085ffc5&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwiU8tXn5c6RAxUAAAAAHQAAAAAQ2wc" style="display: block;"><div _ngcontent-ng-c2283161342="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2283161342-727 ng-star-inserted" style=""><span _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-727">Java</span><div _ngcontent-ng-c2283161342="" class="buttons ng-tns-c2283161342-727 ng-star-inserted"><button _ngcontent-ng-c2283161342="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2283161342-727 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_a3168757b8caf04f&quot;,&quot;c_5449f3519d0d8e03&quot;,null,&quot;rc_1814a00c0085ffc5&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-727"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-727"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-727"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-727"><span class="hljs-keyword">import</span> org.elasticsearch.action.search.SearchRequest;
<span class="hljs-keyword">import</span> org.elasticsearch.action.search.SearchResponse;
<span class="hljs-keyword">import</span> org.elasticsearch.client.RequestOptions;
<span class="hljs-keyword">import</span> org.elasticsearch.client.RestHighLevelClient;
<span class="hljs-keyword">import</span> org.elasticsearch.common.lucene.search.function.CombineFunction;
<span class="hljs-keyword">import</span> org.elasticsearch.index.query.QueryBuilders;
<span class="hljs-keyword">import</span> org.elasticsearch.index.query.functionscore.ScriptScoreQueryBuilder;
<span class="hljs-keyword">import</span> org.elasticsearch.script.Script;
<span class="hljs-keyword">import</span> org.elasticsearch.script.ScriptType;
<span class="hljs-keyword">import</span> org.elasticsearch.search.builder.SearchSourceBuilder;

<span class="hljs-keyword">import</span> java.util.Arrays;
<span class="hljs-keyword">import</span> java.util.HashMap;
<span class="hljs-keyword">import</span> java.util.List;
<span class="hljs-keyword">import</span> java.util.Map;

<span class="hljs-comment">// 假设 client 已经初始化 (参考之前的代码)</span>
<span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">searchVector</span><span class="hljs-params">(RestHighLevelClient client)</span> <span class="hljs-keyword">throws</span> IOException </span>{

    <span class="hljs-comment">// 1. 准备查询向量 (模拟用户输入的向量)</span>
    List&lt;Double&gt; queryVector = Arrays.asList(<span class="hljs-number">0.5</span>, <span class="hljs-number">1.0</span>, -<span class="hljs-number">0.5</span>, <span class="hljs-number">0.2</span>);

    <span class="hljs-comment">// 2. 编写 Painless 脚本</span>
    <span class="hljs-comment">// cosineSimilarity 计算余弦相似度。</span>
    <span class="hljs-comment">// + 1.0 是为了防止出现负分（ES评分必须为正），余弦范围是 -1 到 1。</span>
    String scriptCode = <span class="hljs-string">"cosineSimilarity(params.query_vector, 'my_vector') + 1.0"</span>;

    <span class="hljs-comment">// 3. 封装脚本参数</span>
    Map&lt;String, Object&gt; params = <span class="hljs-keyword">new</span> HashMap&lt;&gt;();
    params.put(<span class="hljs-string">"query_vector"</span>, queryVector);

    Script script = <span class="hljs-keyword">new</span> Script(
        ScriptType.INLINE, 
        <span class="hljs-string">"painless"</span>, 
        scriptCode, 
        params
    );

    <span class="hljs-comment">// 4. 构建 ScriptScore 查询</span>
    <span class="hljs-comment">// QueryBuilders.matchAllQuery() 表示对所有文档进行计算。</span>
    <span class="hljs-comment">// 生产环境通常配合 filter 缩小范围，例如：QueryBuilders.termQuery("category", "shoes")</span>
    ScriptScoreQueryBuilder scriptScoreQuery = QueryBuilders.scriptScoreQuery(
            QueryBuilders.matchAllQuery(), 
            script
    );
    
    <span class="hljs-comment">// 设置计算模式（可选，默认是乘法，这里替换掉原始分）</span>
    scriptScoreQuery.boostMode(CombineFunction.REPLACE);

    <span class="hljs-comment">// 5. 组装请求</span>
    SearchSourceBuilder sourceBuilder = <span class="hljs-keyword">new</span> SearchSourceBuilder();
    sourceBuilder.query(scriptScoreQuery);
    sourceBuilder.size(<span class="hljs-number">5</span>); <span class="hljs-comment">// 取相似度最高的 5 个</span>

    SearchRequest request = <span class="hljs-keyword">new</span> SearchRequest(<span class="hljs-string">"my_vector_index"</span>);
    request.source(sourceBuilder);

    <span class="hljs-comment">// 6. 执行</span>
    SearchResponse response = client.search(request, RequestOptions.DEFAULT);
    
    <span class="hljs-comment">// 输出结果</span>
    System.out.println(<span class="hljs-string">"Hits: "</span> + response.getHits().getTotalHits().value);
    response.getHits().forEach(hit -&gt; {
        System.out.println(<span class="hljs-string">"Name: "</span> + hit.getSourceAsMap().get(<span class="hljs-string">"name"</span>) + 
                           <span class="hljs-string">", Score: "</span> + hit.getScore());
    });
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="18"><h3 data-path-to-node="19">5. ES 7.x vs 8.x 在向量方面的关键差异</h3><p data-path-to-node="20">如果你是初学者，这一点必须了解，因为它决定了你的架构能否扩展。</p><div class="horizontal-scroll-wrapper"><div class="table-block-component"><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><table-block _nghost-ng-c3726268734="" class="ng-star-inserted"><div _ngcontent-ng-c3726268734="" class="table-block has-export-button"><div _ngcontent-ng-c3726268734="" not-end-of-paragraph="" class="table-content not-end-of-paragraph" jslog="275421;track:impression,attention" data-hveid="0" decode-data-ved="1" data-ved="0CAAQ3ecQahgKEwiU8tXn5c6RAxUAAAAAHQAAAAAQ3Ac"><table data-path-to-node="21"><thead><tr><td><span data-path-to-node="21,0,0,0">特性</span></td><td><span data-path-to-node="21,0,1,0">ES 7.x (Script Score)</span></td><td><span data-path-to-node="21,0,2,0">ES 8.x (KNN Search)</span></td></tr></thead><tbody><tr><td><span data-path-to-node="21,1,0,0"><b data-path-to-node="21,1,0,0" data-index-in-node="0">算法原理</b></span></td><td><p data-path-to-node="21,1,1,0"><b data-path-to-node="21,1,1,0" data-index-in-node="0">暴力计算 (Brute Force)</b> </p><br data-path-to-node="21,1,1,1"><p data-path-to-node="21,1,1,2"> 扫描每一行，计算所有向量。</p></td><td><p data-path-to-node="21,1,2,0"><b data-path-to-node="21,1,2,0" data-index-in-node="0">HNSW (Approximate)</b> </p><br data-path-to-node="21,1,2,1"><p data-path-to-node="21,1,2,2"> 使用图结构索引，只遍历最近的节点。</p></td></tr><tr><td><span data-path-to-node="21,2,0,0"><b data-path-to-node="21,2,0,0" data-index-in-node="0">性能</b></span></td><td><span data-path-to-node="21,2,1,0">慢，O(N)。数据量大时延迟高。</span></td><td><span data-path-to-node="21,2,2,0">快，O(log N)。亿级数据也能毫秒级返回。</span></td></tr><tr><td><span data-path-to-node="21,3,0,0"><b data-path-to-node="21,3,0,0" data-index-in-node="0">准确率</b></span></td><td><span data-path-to-node="21,3,1,0">100% 精确。</span></td><td><span data-path-to-node="21,3,2,0">近似精确（通常 &gt;95%，可调）。</span></td></tr><tr><td><span data-path-to-node="21,4,0,0"><b data-path-to-node="21,4,0,0" data-index-in-node="0">API 写法</b></span></td><td><span data-path-to-node="21,4,1,0">复杂，需要写 Painless 脚本。</span></td><td><span data-path-to-node="21,4,2,0">简单，有专门的 <code data-path-to-node="21,4,2,0" data-index-in-node="8">knn</code> 参数。</span></td></tr><tr><td><span data-path-to-node="21,5,0,0"><b data-path-to-node="21,5,0,0" data-index-in-node="0">适用场景</b></span></td><td><span data-path-to-node="21,5,1,0">数据量小 (&lt;10万) 或 必须 100% 精确。</span></td><td><span data-path-to-node="21,5,2,0">任何场景，特别是 RAG、大模型知识库。</span></td></tr></tbody></table></div><div _ngcontent-ng-c3726268734="" hide-from-message-actions="" class="table-footer hide-from-message-actions ng-star-inserted"><!----><button _ngcontent-ng-c3726268734="" mat-icon-button="" mattooltip="复制表格" aria-label="复制表格" data-test-id="copy-table-button" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="276666;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_a3168757b8caf04f&quot;,&quot;c_5449f3519d0d8e03&quot;,null,null,null,null,null,null,1,null,null,null,0]]"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c3726268734="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-l google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----></div><!----></table-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></div></div><h3 data-path-to-node="22">建议</h3><ol start="1" data-path-to-node="23"><li><p data-path-to-node="23,0,0"><b data-path-to-node="23,0,0" data-index-in-node="0">如果是学习/练手：</b> 使用 ES 7.x 没问题，逻辑通了就行。</p></li><li><p data-path-to-node="23,1,0"><b data-path-to-node="23,1,0" data-index-in-node="0">如果是生产环境：</b></p><ul data-path-to-node="23,1,1"><li><p data-path-to-node="23,1,1,0,0"><b data-path-to-node="23,1,1,0,0" data-index-in-node="0">数据量 &lt; 10万：</b> 7.x 勉强可以用。</p></li><li><p data-path-to-node="23,1,1,1,0"><b data-path-to-node="23,1,1,1,0" data-index-in-node="0">数据量 &gt; 10万：</b> <b data-path-to-node="23,1,1,1,0" data-index-in-node="11">强烈建议升级到 ES 8.x</b>。如果在 7.x 上硬跑大量向量搜索，CPU 会瞬间飙升到 100%。</p></li></ul></li></ol><p data-path-to-node="24"><b data-path-to-node="24" data-index-in-node="0">特殊情况补充：</b>
如果你使用的是 <b data-path-to-node="24" data-index-in-node="16">OpenSearch</b>（AWS 基于 ES 7.10 分叉的版本）或者安装了 OpenDistro 插件的 ES 7.x，它们有一个特殊的 <code data-path-to-node="24" data-index-in-node="85">knn</code> 插件支持 HNSW。但如果是<b data-path-to-node="24" data-index-in-node="103">官方原版 Elasticsearch 7.x</b>，主要就是靠上面代码中的暴力计算。</p></div><!----></message-content><!----></div></structured-content-container><!----><!----><div _ngcontent-ng-c2200210637="" class="response-footer is-mobile has-thoughts gap complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2200210637="" _nghost-ng-c1438932748="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c3454274491="" class="response-container-footer ng-tns-c3454274491-709"><!----><message-actions _ngcontent-ng-c2200210637="" footer="" _nghost-ng-c1927598164="" class="ng-tns-c1927598164-719 ng-star-inserted hide-action-bar" style=""><div _ngcontent-ng-c1927598164="" class="actions-container-v2 ng-tns-c1927598164-719 mobile"><!----><!----><div _ngcontent-ng-c1927598164="" class="spacer ng-tns-c1927598164-719 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c1927598164="" yposition="above" xposition="after" class="ng-tns-c1927598164-719"><!----></mat-menu><mat-menu _ngcontent-ng-c1927598164="" yposition="above" class="ng-tns-c1927598164-719"><!----></mat-menu><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></message-actions><!----><!----></div></div><!----></response-container><!----><!----><!----><!----><freemium-rag-disclaimer _ngcontent-ng-c2200210637="" _nghost-ng-c3728931254="" class="ng-star-inserted" style=""><!----></freemium-rag-disclaimer><!----></div></model-response><div _ngcontent-ng-c413749340="" class="restart-chat-button-scroll-placeholder ng-star-inserted"></div><!----><!----><!----><!---