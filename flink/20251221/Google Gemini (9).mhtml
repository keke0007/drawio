c_5449f3519d0d8e03&quot;,null,&quot;rc_01693c0587388d61&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-839"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-839"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-839"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-839"><span class="hljs-keyword">import</span> co.elastic.clients.elasticsearch.ElasticsearchClient;
<span class="hljs-keyword">import</span> co.elastic.clients.elasticsearch.core.*;
<span class="hljs-keyword">import</span> co.elastic.clients.json.jackson.JacksonJsonpMapper;
<span class="hljs-keyword">import</span> co.elastic.clients.transport.rest_client.RestClientTransport;
<span class="hljs-keyword">import</span> org.apache.http.HttpHost;
<span class="hljs-keyword">import</span> org.elasticsearch.client.RestClient;

<span class="hljs-keyword">import</span> java.io.IOException;
<span class="hljs-keyword">import</span> java.util.HashMap;
<span class="hljs-keyword">import</span> java.util.Map;

<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">EsCrudDemo</span> </span>{

    <span class="hljs-comment">// 索引名称</span>
    <span class="hljs-keyword">private</span> <span class="hljs-keyword">static</span> <span class="hljs-keyword">final</span> String INDEX_NAME = <span class="hljs-string">"products"</span>;

    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">static</span> <span class="hljs-keyword">void</span> <span class="hljs-title">main</span><span class="hljs-params">(String[] args)</span> <span class="hljs-keyword">throws</span> IOException </span>{
        <span class="hljs-comment">// ==========================================</span>
        <span class="hljs-comment">// 0. 初始化连接</span>
        <span class="hljs-comment">// ==========================================</span>
        RestClient restClient = RestClient.builder(
                <span class="hljs-keyword">new</span> HttpHost(<span class="hljs-string">"localhost"</span>, <span class="hljs-number">9200</span>)
        ).build();

        ElasticsearchClient client = <span class="hljs-keyword">new</span> ElasticsearchClient(
                <span class="hljs-keyword">new</span> RestClientTransport(restClient, <span class="hljs-keyword">new</span> JacksonJsonpMapper())
        );

        System.out.println(<span class="hljs-string">"--- 开始 CRUD 演示 ---"</span>);

        <span class="hljs-comment">// ==========================================</span>
        <span class="hljs-comment">// 1. Create (新增/索引文档)</span>
        <span class="hljs-comment">// ==========================================</span>
        Product newProduct = <span class="hljs-keyword">new</span> Product(<span class="hljs-string">"101"</span>, <span class="hljs-string">"Java编程思想"</span>, <span class="hljs-number">99.00</span>, <span class="hljs-string">"Books"</span>);

        IndexResponse indexResponse = client.index(i -&gt; i
            .index(INDEX_NAME)
            .id(newProduct.getId()) <span class="hljs-comment">// 指定 ID，如果不指定 ES 会自动生成乱码 ID</span>
            .document(newProduct)
        );
        
        System.out.println(<span class="hljs-string">"1. 新增成功，版本号: "</span> + indexResponse.version());

        <span class="hljs-comment">// ==========================================</span>
        <span class="hljs-comment">// 2. Read (根据 ID 查询)</span>
        <span class="hljs-comment">// ==========================================</span>
        <span class="hljs-comment">// get 方法是实时的，不需要等待 refresh</span>
        GetResponse&lt;Product&gt; getResponse = client.get(g -&gt; g
            .index(INDEX_NAME)
            .id(<span class="hljs-string">"101"</span>), 
            Product.class
        );

        <span class="hljs-keyword">if</span> (getResponse.found()) {
            Product p = getResponse.source();
            System.out.println(<span class="hljs-string">"2. 查询成功: "</span> + p.getName() + <span class="hljs-string">" | 价格: "</span> + p.getPrice());
        } <span class="hljs-keyword">else</span> {
            System.out.println(<span class="hljs-string">"2. 未找到文档"</span>);
        }

        <span class="hljs-comment">// ==========================================</span>
        <span class="hljs-comment">// 3. Update (局部更新)</span>
        <span class="hljs-comment">// ==========================================</span>
        <span class="hljs-comment">// 需求：只把价格修改为 120.00，其他字段不变</span>
        <span class="hljs-comment">// 我们使用 Map 来封装需要更新的字段，也可以再建一个 Product 对象</span>
        Map&lt;String, Object&gt; partialUpdate = <span class="hljs-keyword">new</span> HashMap&lt;&gt;();
        partialUpdate.put(<span class="hljs-string">"price"</span>, <span class="hljs-number">120.00</span>);

        UpdateResponse&lt;Product&gt; updateResponse = client.update(u -&gt; u
            .index(INDEX_NAME)
            .id(<span class="hljs-string">"101"</span>)
            .doc(partialUpdate), <span class="hljs-comment">// 这里传入部分数据</span>
            Product.class
        );

        System.out.println(<span class="hljs-string">"3. 更新成功，新版本号: "</span> + updateResponse.version());

        <span class="hljs-comment">// 验证一下更新是否生效</span>
        Product updatedProduct = client.get(g -&gt; g.index(INDEX_NAME).id(<span class="hljs-string">"101"</span>), Product.class).source();
        System.out.println(<span class="hljs-string">"   -&gt; 更新后的价格: "</span> + updatedProduct.getPrice());

        <span class="hljs-comment">// ==========================================</span>
        <span class="hljs-comment">// 4. Delete (删除文档)</span>
        <span class="hljs-comment">// ==========================================</span>
        DeleteResponse deleteResponse = client.delete(d -&gt; d
            .index(INDEX_NAME)
            .id(<span class="hljs-string">"101"</span>)
        );

        System.out.println(<span class="hljs-string">"4. 删除结果: "</span> + deleteResponse.result());

        <span class="hljs-comment">// ==========================================</span>
        <span class="hljs-comment">// 5. 关闭资源</span>
        <span class="hljs-comment">// ==========================================</span>
        restClient.close();
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 data-path-to-node="11">核心知识点解析</h3><ol start="1" data-path-to-node="12"><li><p data-path-to-node="12,0,0"><b data-path-to-node="12,0,0" data-index-in-node="0">Create (<code data-path-to-node="12,0,0" data-index-in-node="8">client.index</code>)</b>:</p><ul data-path-to-node="12,0,1"><li><p data-path-to-node="12,0,1,0,0">在 ES 中，插入通常被称为“索引（Index）”一个文档。</p></li><li><p data-path-to-node="12,0,1,1,0">如果 ID 已存在，默认行为是<b data-path-to-node="12,0,1,1,0" data-index-in-node="15">全量覆盖</b>（替换整个文档）。</p></li><li><p data-path-to-node="12,0,1,2,0">如果 ID 不存在，则创建。</p></li></ul></li><li><p data-path-to-node="12,1,0"><b data-path-to-node="12,1,0" data-index-in-node="0">Read (<code data-path-to-node="12,1,0" data-index-in-node="6">client.get</code>)</b>:</p><ul data-path-to-node="12,1,1"><li><p data-path-to-node="12,1,1,0,0">这是<b data-path-to-node="12,1,1,0,0" data-index-in-node="2">通过 ID</b> 获取文档，它是<b data-path-to-node="12,1,1,0,0" data-index-in-node="15">实时</b>的（Real-time）。</p></li><li><p data-path-to-node="12,1,1,1,0">注意：这与 <code data-path-to-node="12,1,1,1,0" data-index-in-node="6">client.search</code> 不同。<code data-path-to-node="12,1,1,1,0" data-index-in-node="23">search</code> 可能会有 1 秒左右的延迟（受 <code data-path-to-node="12,1,1,1,0" data-index-in-node="46">refresh_interval</code> 影响），但 <code data-path-to-node="12,1,1,1,0" data-index-in-node="69">get</code> 是直接查主键，速度最快且没有延迟。</p></li></ul></li><li><p data-path-to-node="12,2,0"><b data-path-to-node="12,2,0" data-index-in-node="0">Update (<code data-path-to-node="12,2,0" data-index-in-node="8">client.update</code>)</b>:</p><ul data-path-to-node="12,2,1"><li><p data-path-to-node="12,2,1,0,0">这是<b data-path-to-node="12,2,1,0,0" data-index-in-node="2">局部更新</b>。ES 内部其实是：取出旧文档 -&gt; 修改字段 -&gt; 重新索引新文档。</p></li><li><p data-path-to-node="12,2,1,1,0">在代码中，<code data-path-to-node="12,2,1,1,0" data-index-in-node="5">.doc(partialUpdate)</code> 表示只合并这些字段到现有文档中。</p></li></ul></li><li><p data-path-to-node="12,3,0"><b data-path-to-node="12,3,0" data-index-in-node="0">Delete (<code data-path-to-node="12,3,0" data-index-in-node="8">client.delete</code>)</b>:</p><ul data-path-to-node="12,3,1"><li><p data-path-to-node="12,3,1,0,0">根据 ID 物理删除文档。即使文档被标记删除，ES 也会在后台段合并（Segment Merge）时才真正释放磁盘空间。</p></li></ul></li></ol><p data-path-to-node="13">你可以直接运行这段代码，控制台应该会依次输出每一步的操作结果。如果有任何报错，请告诉我！</p></div><!----></message-content><!----></div></structured-content-container><!----><!----><div _ngcontent-ng-c2200210637="" class="response-footer is-mobile gap has-thoughts complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2200210637="" _nghost-ng-c1438932748="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c3454274491="" class="response-container-footer ng-tns-c3454274491-824"><!----><message-actions _ngcontent-ng-c2200210637="" footer="" _nghost-ng-c1927598164="" class="ng-tns-c1927598164-831 ng-star-inserted hide-action-bar" style=""><div _ngcontent-ng-c1927598164="" class="actions-container-v2 ng-tns-c1927598164-831 mobile"><!----><!----><div _ngcontent-ng-c1927598164="" class="spacer ng-tns-c1927598164-831 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c1927598164="" yposition="above" xposition="after" class="ng-tns-c1927598164-831"><!----></mat-menu><mat-menu _ngcontent-ng-c1927598164="" yposition="above" class="ng-tns-c1927598164-831"><!----></mat-men