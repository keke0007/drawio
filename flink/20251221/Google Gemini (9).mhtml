<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">EsShopDemoV7</span> </span>{

    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">static</span> <span class="hljs-keyword">void</span> <span class="hljs-title">main</span><span class="hljs-params">(String[] args)</span> <span class="hljs-keyword">throws</span> IOException </span>{
        <span class="hljs-comment">// -------------------------------------------------------</span>
        <span class="hljs-comment">// 1. 初始化连接 (RestHighLevelClient)</span>
        <span class="hljs-comment">// -------------------------------------------------------</span>
        RestHighLevelClient client = <span class="hljs-keyword">new</span> RestHighLevelClient(
                RestClient.builder(
                        <span class="hljs-keyword">new</span> HttpHost(<span class="hljs-string">"localhost"</span>, <span class="hljs-number">9200</span>, <span class="hljs-string">"http"</span>)
                )
        );

        <span class="hljs-comment">// -------------------------------------------------------</span>
        <span class="hljs-comment">// 2. 构建查询 (核心区别在这里)</span>
        <span class="hljs-comment">// -------------------------------------------------------</span>
        
        <span class="hljs-comment">// A. 创建搜索请求，指定索引</span>
        SearchRequest searchRequest = <span class="hljs-keyword">new</span> SearchRequest(<span class="hljs-string">"my_shop"</span>);
        
        <span class="hljs-comment">// B. 创建 SearchSourceBuilder (相当于 JSON 中的最外层 {} )</span>
        SearchSourceBuilder sourceBuilder = <span class="hljs-keyword">new</span> SearchSourceBuilder();

        <span class="hljs-comment">// C. 构建 Bool 查询</span>
        <span class="hljs-comment">// 对应 DSL: "bool": { "should": [...] }</span>
        BoolQueryBuilder boolQuery = QueryBuilders.boolQuery();
        
        <span class="hljs-comment">// 添加条件: category = "Laptop"</span>
        boolQuery.should(QueryBuilders.termQuery(<span class="hljs-string">"category"</span>, <span class="hljs-string">"Laptop"</span>));
        
        <span class="hljs-comment">// 添加条件: tags = "5g"</span>
        boolQuery.should(QueryBuilders.termQuery(<span class="hljs-string">"tags"</span>, <span class="hljs-string">"5g"</span>));
        
        <span class="hljs-comment">// 对应 DSL: "minimum_should_match": 1</span>
        boolQuery.minimumShouldMatch(<span class="hljs-number">1</span>);

        <span class="hljs-comment">// D. 将查询放入构建器</span>
        sourceBuilder.query(boolQuery);

        <span class="hljs-comment">// E. 设置排序 (对应 DSL: "sort")</span>
        sourceBuilder.sort(<span class="hljs-string">"price"</span>, SortOrder.ASC);

        <span class="hljs-comment">// F. 将构建好的条件放入请求中</span>
        searchRequest.source(sourceBuilder);

        <span class="hljs-comment">// -------------------------------------------------------</span>
        <span class="hljs-comment">// 3. 执行与解析结果</span>
        <span class="hljs-comment">// -------------------------------------------------------</span>
        SearchResponse searchResponse = client.search(searchRequest, RequestOptions.DEFAULT);

        System.out.println(<span class="hljs-string">"匹配到的商品数量: "</span> + searchResponse.getHits().getTotalHits().value);

        <span class="hljs-keyword">for</span> (SearchHit hit : searchResponse.getHits().getHits()) {
            <span class="hljs-comment">// 在 7.x 中，直接获取 Map 比较方便</span>
            Map&lt;String, Object&gt; sourceMap = hit.getSourceAsMap();
            
            String name = (String) sourceMap.get(<span class="hljs-string">"name"</span>);
            Double price = (Double) sourceMap.get(<span class="hljs-string">"price"</span>); <span class="hljs-comment">// 注意类型转换</span>
            
            System.out.println(<span class="hljs-string">"商品: "</span> + name + <span class="hljs-string">" | 价格: "</span> + price);
        }

        <span class="hljs-comment">// -------------------------------------------------------</span>
        <span class="hljs-comment">// 4. 关闭资源</span>
        <span class="hljs-comment">// -------------------------------------------------------</span>
        client.close();
    }
}
