e-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_8c27edbd5714e2d3&quot;,&quot;c_5449f3519d0d8e03&quot;,null,&quot;rc_b0ea491220d82e80&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-693"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-693"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-693"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-693"><span class="hljs-keyword">import</span> co.elastic.clients.elasticsearch.ElasticsearchClient;
<span class="hljs-keyword">import</span> co.elastic.clients.elasticsearch._types.SortOrder;
<span class="hljs-keyword">import</span> co.elastic.clients.elasticsearch.core.SearchResponse;
<span class="hljs-keyword">import</span> co.elastic.clients.elasticsearch.core.search.Hit;
<span class="hljs-keyword">import</span> co.elastic.clients.json.jackson.JacksonJsonpMapper;
<span class="hljs-keyword">import</span> co.elastic.clients.transport.rest_client.RestClientTransport;
<span class="hljs-keyword">import</span> org.apache.http.HttpHost;
<span class="hljs-keyword">import</span> org.elasticsearch.client.RestClient;

<span class="hljs-keyword">import</span> java.io.IOException;

<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">EsShopDemo</span> </span>{

    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">static</span> <span class="hljs-keyword">void</span> <span class="hljs-title">main</span><span class="hljs-params">(String[] args)</span> <span class="hljs-keyword">throws</span> IOException </span>{
        <span class="hljs-comment">// -------------------------------------------------------</span>
        <span class="hljs-comment">// 1. 初始化连接 (连接到本地 Docker 的 ES)</span>
        <span class="hljs-comment">// -------------------------------------------------------</span>
        RestClient restClient = RestClient.builder(
                <span class="hljs-keyword">new</span> HttpHost(<span class="hljs-string">"localhost"</span>, <span class="hljs-number">9200</span>)
        ).build();

        <span class="hljs-comment">// 使用 Jackson 映射器</span>
        RestClientTransport transport = <span class="hljs-keyword">new</span> RestClientTransport(
                restClient, <span class="hljs-keyword">new</span> JacksonJsonpMapper()
        );

        <span class="hljs-comment">// 创建 API 客户端</span>
        ElasticsearchClient client = <span class="hljs-keyword">new</span> ElasticsearchClient(transport);

        <span class="hljs-comment">// -------------------------------------------------------</span>
        <span class="hljs-comment">// 2. 构建查询 (对应刚才的 DSL)</span>
        <span class="hljs-comment">// -------------------------------------------------------</span>
        <span class="hljs-comment">// 目标 DSL: bool -&gt; should(Laptop), should(5g) -&gt; min_match(1) -&gt; sort(price asc)</span>
        
        SearchResponse&lt;Product&gt; response = client.search(s -&gt; s
            .index(<span class="hljs-string">"my_shop"</span>) <span class="hljs-comment">// 指定索引名</span>
            .query(q -&gt; q
                .bool(b -&gt; b
                    .should(h -&gt; h
                        .term(t -&gt; t.field(<span class="hljs-string">"category"</span>).value(<span class="hljs-string">"Laptop"</span>)) <span class="hljs-comment">// 条件1</span>
                    )
                    .should(h -&gt; h
                        .term(t -&gt; t.field(<span class="hljs-string">"tags"</span>).value(<span class="hljs-string">"5g"</span>))         <span class="hljs-comment">// 条件2</span>
                    )
                    .minimumShouldMatch(<span class="hljs-string">"1"</span>) <span class="hljs-comment">// 至少满足一个</span>
                )
            )
            .sort(sort -&gt; sort
                .field(f -&gt; f
                    .field(<span class="hljs-string">"price"</span>)
                    .order(SortOrder.Asc) <span class="hljs-comment">// 价格升序</span>
                )
            ),
            Product.class <span class="hljs-comment">// 告诉 ES 把结果映射成 Product 类</span>
        );

        <span class="hljs-comment">// -------------------------------------------------------</span>
        <span class="hljs-comment">// 3. 处理结果</span>
        <span class="hljs-comment">// -------------------------------------------------------</span>
        System.out.println(<span class="hljs-string">"匹配到的商品数量: "</span> + response.hits().total().value());

        <span class="hljs-keyword">for</span> (Hit&lt;Product&gt; hit : response.hits().hits()) {
            Product product = hit.source();
            System.out.println(<span class="hljs-string">"商品: "</span> + product.getName() + <span class="hljs-string">" | 价格: "</span> + product.getPrice());
        }

        <span class="hljs-comment">// 关闭连接</span>
        transport.close();
        restClient.close();
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 data-path-to-node="12">代码与 DSL 的对应关系详解</h3><p data-path-to-node="13">这段 Java 代码使用的是 <b data-path-to-node="13" data-index-in-node="15">Builder Pattern (构建者模式)</b> 的 Lambda 写法，初看可能有点晕，但它和 JSON 结构是一一对应的：</p><div class="horizontal-scroll-wrapper"><div class="table-block-component"><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><table-block _nghost-ng-c3726268734="" class="ng-star-inserted"><div _ngcontent-ng-c3726268734="" class="table-block has-export-button has-scrollbar"><div _ngcontent-ng-c3726268734="" not-end-of-paragraph="" class="table-content not-end-of-paragraph" jslog="275421;track:impression,attention" data-hveid="0" decode-data-ved="1" data-ved="0CAAQ3ecQahgKEwiU8tXn5c6RAxUAAAAAHQAAAAAQpgc"><table data-path-to-node="14"><thead><tr><td><span data-path-to-node="14,0,0,0">JSON (Kibana)</span></td><td><span data-path-to-node="14,0,1,0">Java Client (Lambda)</span></td></tr></thead><tbody><tr><td><span data-path-to-node="14,1,0,0"><code data-path-to-node="14,1,0,0" data-index-in-node="0">"query": { ... }</code></span></td><td><span data-path-to-node="14,1,1,0"><code data-path-to-node="14,1,1,0" data-index-in-node="0">.query(q -&gt; q...)</code></span></td></tr><tr><td><span data-path-to-node="14,2,0,0"><code data-path-to-node="14,2,0,0" data-index-in-node="0">"bool": { ... }</code></span></td><td><span data-path-to-node="14,2,1,0"><code data-path-to-node="14,2,1,0" data-index-in-node="0">.bool(b -&gt; b...)</code></span></td></tr><tr><td><span data-path-to-node="14,3,0,0"><code data-path-to-node="14,3,0,0" data-index-in-node="0">"should": [ ... ]</code></span></td><td><span data-path-to-node="14,3,1,0"><code data-path-to-node="14,3,1,0" data-index-in-node="0">.should(h -&gt; h...)</code></span></td></tr><tr><td><span data-path-to-node="14,4,0,0"><code data-path-to-node="14,4,0,0" data-index-in-node="0">"term": { "category": "Laptop" }</code></span></td><td><span data-path-to-node="14,4,1,0"><code data-path-to-node="14,4,1,0" data-index-in-node="0">.term(t -&gt; t.field("category").value("Laptop"))</code></span></td></tr><tr><td><span data-path-to-node="14,5,0,0"><code data-path-to-node="14,5,0,0" data-index-in-node="0">"sort": [ ... ]</code></span></td><td><span data-path-to-node="14,5,1,0"><code data-path-to-node="14,5,1,0" data-index-in-node="0">.sort(sort -&gt; sort...)</code></span></td></tr></tbody></table></div><div _ngcontent-ng-c3726268734="" hide-from-message-actions="" class="table-footer hide-from-message-actions ng-star-inserted"><!----><button _ngcontent-ng-c3726268734="" mat-icon-button="" mattooltip="复制表格" aria-label="复制表格" data-test-id="copy-table-button" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="276666;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_8c27edbd5714e2d3&quot;,&quot;c_5449f3519d0d8e03&quot;,null,null,null,null,null,null,1,null,null,null,0]]"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c3726268734="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-l google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----></div><!----></table-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></div></div><h3 data-path-to-node="15">下一步建议</h3><p data-path-to-node="16">上面的代码是纯 Java 实现（Java SE）。但在实际的企业开发（比如使用 Spring Boot）中，我们通常有两种选择：</p><ol start="1" data-path-to-node="17"><li><p data-path-to-node="17,0,0"><b data-path-to-node="17,0,0" data-index-in-node="0">直接使用上面的 <code data-path-to-node="17,0,0" data-index-in-node="8">ElasticsearchClient</code></b>：灵活，贴近原生，适合复杂查询。</p></li><li><p data-path-to-node="17,1,0"><b data-path-to-node="17,1,0" data-index-in-node="0">使用 Spring Data Elasticsearch</b>：更高级的封装，像写 SQL 一样写 ES。</p><ul data-path-to-node="17,1,1"><li><p data-path-to-node="17,1,1,0,0">例如：<code data-path-to-node="17,1,1,0,0" data-index-in-node="3">findByCategoryOrTagsOrderByPriceAsc(String category, String tag)</code></p></li><li><p data-path-to-node="17,1,1,1,0">只要定义接口，不需要写实现代码。</p></li></ul></li></ol><p data-path-to-node="18"><b data-path-to-node="18" data-index-in-node="0">建议：</b>
先用上面的代码跑通 Demo，理解 API 的底层逻辑。等你熟悉了，再在 Spring Boot 项目中引入 <code data-path-to-node="18" data-index-in-node="59">spring-boot-starter-data-elasticsearch</code> 来简化开发。</p><p data-path-to-node="19">需要我给你演示一下 <b data-path-to-node="19" data-index-in-node="10">Spring Data Elasticsearch</b> 那种极简的写法作为对比吗？</p></div><!----></message-content><!----></div></structured-content-container><!----><!----><div _ngcontent-ng-c2200210637="" class="response-footer is-mobile gap has-thoughts complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2200210637="" _nghost-ng-c1438932748="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c3454274491="" class="response-container-footer ng-tns-c3454274491-675"><!----><message-actions _ngcontent-ng-c2200210637="" footer="" _nghost-ng-c1927598164="" class="ng-tns-c1927598164-685 ng-star-inserted hide-action-bar" style=""><div _ngcontent-ng-c1927598164="" class="actions-container-v2 ng-tns-c1927598164-685 mobile"><!----><!----><div _ngcontent-ng-c1927598164="" class="spacer ng-tns-c1927598164-685 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c1927598164="" yposition="above" xposition="after" class="ng-tns-c1927598164-685"><!----></mat-menu><mat-menu _ngcontent-ng-c1927598164="" yposition="above" class="ng-tns-c1927598164-685"><!----></mat-menu><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></message-actions><!----><!----></div></div><!----></response-container><!----><!----><!----><!----><freemium-rag-disclaimer _ngcontent-ng-c2200210637="" _nghost-ng-c3728931254="" class="ng-star-inserted" style=""><!----></freemium-rag-disclaimer><!----></div></model-response><div _ngcontent-ng-c413749340="" class="restart-chat-button-scroll-placeholder ng-star-inserted"></div><!----><!----><!----><!----><!----><