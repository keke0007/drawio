f70&quot;,&quot;c_5449f3519d0d8e03&quot;,null,&quot;rc_4d10b3a2ba1effe4&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-856"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-856"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-856"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-856"><span class="hljs-keyword">import</span> redis.clients.jedis.JedisPooled;
<span class="hljs-keyword">import</span> redis.clients.jedis.search.*;
<span class="hljs-keyword">import</span> redis.clients.jedis.search.schemafields.VectorField;
<span class="hljs-keyword">import</span> redis.clients.jedis.search.schemafields.TextField;

<span class="hljs-keyword">import</span> java.nio.ByteBuffer;
<span class="hljs-keyword">import</span> java.nio.ByteOrder;
<span class="hljs-keyword">import</span> java.util.HashMap;
<span class="hljs-keyword">import</span> java.util.List;
<span class="hljs-keyword">import</span> java.util.Map;

<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">RedisVectorDemo</span> </span>{

    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">static</span> <span class="hljs-keyword">void</span> <span class="hljs-title">main</span><span class="hljs-params">(String[] args)</span> </span>{
        <span class="hljs-comment">// 连接 Redis (Redis Stack 默认端口 6379)</span>
        JedisPooled jedis = <span class="hljs-keyword">new</span> JedisPooled(<span class="hljs-string">"localhost"</span>, <span class="hljs-number">6379</span>);

        <span class="hljs-comment">// 索引名</span>
        String indexName = <span class="hljs-string">"my_idx"</span>;

        <span class="hljs-keyword">try</span> {
            <span class="hljs-comment">// 1. 创建索引 (FT.CREATE)</span>
            <span class="hljs-comment">// 如果索引已存在，先删除（方便演示）</span>
            <span class="hljs-keyword">try</span> { jedis.ftDropIndex(indexName); } <span class="hljs-keyword">catch</span> (Exception ignored) {}

            <span class="hljs-comment">// 定义 Schema</span>
            Map&lt;String, Object&gt; attr = <span class="hljs-keyword">new</span> HashMap&lt;&gt;();
            attr.put(<span class="hljs-string">"TYPE"</span>, <span class="hljs-string">"FLOAT32"</span>);
            attr.put(<span class="hljs-string">"DIM"</span>, <span class="hljs-number">3</span>);
            attr.put(<span class="hljs-string">"DISTANCE_METRIC"</span>, <span class="hljs-string">"COSINE"</span>);

            Schema schema = <span class="hljs-keyword">new</span> Schema()
                .addField(<span class="hljs-keyword">new</span> TextField(<span class="hljs-string">"name"</span>)) <span class="hljs-comment">// 文本字段</span>
                .addField(<span class="hljs-keyword">new</span> VectorField(<span class="hljs-string">"embedding"</span>, VectorField.VectorAlgorithm.HNSW, attr)); <span class="hljs-comment">// 向量字段</span>

            IndexDefinition def = <span class="hljs-keyword">new</span> IndexDefinition(IndexDefinition.Type.HASH)
                .setPrefixes(<span class="hljs-string">"item:"</span>); <span class="hljs-comment">// 只索引 key 为 "item:" 开头的数据</span>

            jedis.ftCreate(indexName, IndexOptions.defaultOptions().setDefinition(def), schema);
            System.out.println(<span class="hljs-string">"--- 索引创建完成 ---"</span>);

            <span class="hljs-comment">// 2. 插入数据 (HSET)</span>
            <span class="hljs-comment">// Redis 存向量需要转为 byte[]</span>
            insertData(jedis, <span class="hljs-string">"item:1"</span>, <span class="hljs-string">"Apple"</span>, <span class="hljs-keyword">new</span> <span class="hljs-keyword">float</span>[]{<span class="hljs-number">1f</span>, <span class="hljs-number">1f</span>, <span class="hljs-number">1f</span>});
            insertData(jedis, <span class="hljs-string">"item:2"</span>, <span class="hljs-string">"Banana"</span>, <span class="hljs-keyword">new</span> <span class="hljs-keyword">float</span>[]{<span class="hljs-number">2f</span>, <span class="hljs-number">2f</span>, <span class="hljs-number">2f</span>});
            insertData(jedis, <span class="hljs-string">"item:3"</span>, <span class="hljs-string">"Dog"</span>, <span class="hljs-keyword">new</span> <span class="hljs-keyword">float</span>[]{<span class="hljs-number">10f</span>, <span class="hljs-number">10f</span>, <span class="hljs-number">10f</span>});
            System.out.println(<span class="hljs-string">"--- 数据插入完成 ---"</span>);

            <span class="hljs-comment">// 3. 向量查询 (FT.SEARCH)</span>
            <span class="hljs-comment">// 语法: *=&gt;[KNN 3 @embedding $vec_param]</span>
            String queryStr = <span class="hljs-string">"*=&gt;[KNN 3 @embedding $vec_param AS score]"</span>;
            
            <span class="hljs-comment">// 准备查询向量</span>
            <span class="hljs-keyword">byte</span>[] queryVecBytes = floatToBytes(<span class="hljs-keyword">new</span> <span class="hljs-keyword">float</span>[]{<span class="hljs-number">1f</span>, <span class="hljs-number">1f</span>, <span class="hljs-number">1.2f</span>});

            Query query = <span class="hljs-keyword">new</span> Query(queryStr)
                .addParam(<span class="hljs-string">"vec_param"</span>, queryVecBytes) <span class="hljs-comment">// 绑定参数</span>
                .setSortBy(<span class="hljs-string">"score"</span>, <span class="hljs-keyword">true</span>) <span class="hljs-comment">// 按分数(距离)排序</span>
                .returnFields(<span class="hljs-string">"name"</span>, <span class="hljs-string">"score"</span>); <span class="hljs-comment">// 只返回 name 和 score</span>

            SearchResult result = jedis.ftSearch(indexName, query);

            System.out.println(<span class="hljs-string">"--- 搜索结果 (Top 3) ---"</span>);
            <span class="hljs-keyword">for</span> (Document doc : result.getDocuments()) {
                String name = doc.getString(<span class="hljs-string">"name"</span>);
                Double score = doc.getDouble(<span class="hljs-string">"score"</span>); <span class="hljs-comment">// 在 Redis 中，余弦距离越小越相似</span>
                System.out.printf(<span class="hljs-string">"商品: %-10s | 距离: %.4f%n"</span>, name, score);
            }

        } <span class="hljs-keyword">finally</span> {
            jedis.close();
        }
    }

    <span class="hljs-comment">// 辅助方法：插入数据</span>
    <span class="hljs-function"><span class="hljs-keyword">private</span> <span class="hljs-keyword">static</span> <span class="hljs-keyword">void</span> <span class="hljs-title">insertData</span><span class="hljs-params">(JedisPooled client, String key, String name, <span class="hljs-keyword">float</span>[] vector)</span> </span>{
        Map&lt;String, Object&gt; fields = <span class="hljs-keyword">new</span> HashMap&lt;&gt;();
        fields.put(<span class="hljs-string">"name"</span>, name);
        fields.put(<span class="hljs-string">"embedding"</span>, floatToBytes(vector)); <span class="hljs-comment">// 关键：转为字节</span>
        client.hset(key, redis.clients.jedis.util.JavaDigit.toStringMap(fields));
    }

    <span class="hljs-comment">// 辅助方法：Float数组 转 Byte数组 (Little Endian)</span>
    <span class="hljs-comment">// Redis 强制要求 Little Endian 格式</span>
    <span class="hljs-keyword">private</span> <span class="hljs-keyword">static</span> <span class="hljs-keyword">byte</span>[] floatToBytes(<span class="hljs-keyword">float</span>[] vector) {
        ByteBuffer buffer = ByteBuffer.allocate(vector.length * Float.BYTES);
        buffer.order(ByteOrder.LITTLE_ENDIAN); <span class="hljs-comment">// 必须是小端序</span>
        <span class="hljs-keyword">for</span> (<span class="hljs-keyword">float</span> v : vector) {
            buffer.putFloat(v);
        }
        <span class="hljs-keyword">return</span> buffer.array();
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="18"><h3 data-path-to-node="19">简单对比 (代码层面)</h3><ol start="1" data-path-to-node="20"><li><p data-path-to-node="20,0,0"><b data-path-to-node="20,0,0" data-index-in-node="0">PostgreSQL (pgvector)</b>:</p><ul data-path-to-node="20,0,1"><li><p data-path-to-node="20,0,1,0,0"><b data-path-to-node="20,0,1,0,0" data-index-in-node="0">优点</b>：代码非常像普通的 JDBC 操作，<code data-path-to-node="20,0,1,0,0" data-index-in-node="20">PGvector</code> 对象自动帮你处理了格式转换。如果你习惯写 SQL，这个最舒服。</p></li><li><p data-path-to-node="20,0,1,1,0"><b data-path-to-node="20,0,1,1,0" data-index-in-node="0">查询</b>：直接在 SQL 字符串里写 <code data-path-to-node="20,0,1,1,0" data-index-in-node="17">&lt;=&gt;</code>。</p></li></ul></li><li><p data-path-to-node="20,1,0"><b data-path-to-node="20,1,0" data-index-in-node="0">Redis (Jedis)</b>:</p><ul data-path-to-node="20,1,1"><li><p data-path-to-node="20,1,1,0,0"><b data-path-to-node="20,1,1,0,0" data-index-in-node="0">难点</b>：你需要自己处理 <code data-path-to-node="20,1,1,0,0" data-index-in-node="11">float[]</code> 到 <code data-path-to-node="20,1,1,0,0" data-index-in-node="21">byte[]</code> 的转换（且必须是 Little Endian 小端序）。</p></li><li><p data-path-to-node="20,1,1,1,0"><b data-path-to-node="20,1,1,1,0" data-index-in-node="0">查询</b>：查询语法是特殊的 RediSearch 语法 <code data-path-to-node="20,1,1,1,0" data-index-in-node="26">*=&gt;[KNN ...]</code>，比 SQL 难记一点。</p></li><li><p data-path-to-node="20,1,1,2,0"><b data-path-to-node="20,1,1,2,0" data-index-in-node="0">优点</b>：虽然写起来麻烦点，但跑起来速度极快。</p></li></ul></li></ol><p data-path-to-node="21">这两个代码直接粘贴到你的 IDE 里，配合我之前给你的 <code data-path-to-node="21" data-index-in-node="28">docker-compose.yml</code> 启动的环境，是可以直接运行的！</p></div><!----></message-content><!----></div></structured-content-container><!----><!----><div _ngcontent-ng-c2200210637="" class="response-footer is-mobile gap has-thoughts complete"><!----><!----><sources-list _ngcontent-ng-c2200210637="" class="sources-list ng-star-inserted"><!----></sources-list><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2200210637="" _nghost-ng-c1438932748="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c3454274491="" class="response-container-footer ng-tns-c3454274491-840"><!----><message-actions _ngcontent-ng-c2200210637="" footer="" _nghost-ng-c1927598164="" class="ng-tns-c1927598164-852 ng-star-inserted" style=""><div _ngcontent-ng-c1927598164="" class="actions-container-v2 ng-tns-c1927598164-852 mobile"><!----><!----><div _ngcontent-ng-c1927598164="" class="spacer ng-tns-c1927598164-852 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c1927598164="" yposition="above" xposition="after" class="ng-tns-c1927598164-852"><!----></mat-menu><mat-menu _ngcontent-ng-c1927598164="" yposition="above" class="ng-tns-c1927598164-852"><!----></mat-menu><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></message-actions><!----><!----></div></div><!----></response-container><!----><!----><!----><!----><freemium-rag-disclaimer _ngcontent-ng-c2200210637="" _nghost-ng-c3728931254="" class="ng-star-inserted" style=""><!----></freemium-rag-disclaimer><!----></div></model-response><div _ngcontent-ng-c413749340="" class="restart-chat-button-scroll-placeholder ng-star-inserted"></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><freemium-file-upload-near-quota-disclaimer _