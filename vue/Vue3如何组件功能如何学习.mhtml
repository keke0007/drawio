    data <span class="hljs-comment">// post 放在 data 里</span>
  })
}

<span class="hljs-keyword">export</span> <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">getUserList</span>(<span class="hljs-params">params</span>) </span>{
  <span class="hljs-keyword">return</span> request({
    <span class="hljs-attr">url</span>: <span class="hljs-string">'/users/list'</span>,
    <span class="hljs-attr">method</span>: <span class="hljs-string">'get'</span>,
    params <span class="hljs-comment">// get 放在 params 里</span>
  })
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h4 data-path-to-node="15">第三层：在组件中使用 (Views)</h4><p data-path-to-node="16">现在，你的组件代码会变得非常干净：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c115509130="" class="ng-tns-c115509130-198 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c115509130="" class="code-block ng-tns-c115509130-198 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_7e5d3d6fd6ef71e3&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_ec0b314c24c16e2f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwilq4rO-_uRAxUAAAAAHQAAAAAQpwI" style="display: block;"><div _ngcontent-ng-c115509130="" class="code-block-decoration header-formatted gds-title-s ng-tns-c115509130-198 ng-star-inserted" style=""><span _ngcontent-ng-c115509130="" class="ng-tns-c115509130-198">HTML</span><div _ngcontent-ng-c115509130="" class="buttons ng-tns-c115509130-198 ng-star-inserted"><button _ngcontent-ng-c115509130="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c115509130-198 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_7e5d3d6fd6ef71e3&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_ec0b314c24c16e2f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c115509130="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c115509130="" class="formatted-code-block-internal-container ng-tns-c115509130-198"><div _ngcontent-ng-c115509130="" class="animated-opacity ng-tns-c115509130-198"><pre _ngcontent-ng-c115509130="" class="ng-tns-c115509130-198"><code _ngcontent-ng-c115509130="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c115509130-198"><span class="hljs-tag">&lt;<span class="hljs-name">script</span> <span class="hljs-attr">setup</span>&gt;</span><span class="javascript">
<span class="hljs-keyword">import</span> { getUserList } <span class="hljs-keyword">from</span> <span class="hljs-string">'@/api/user'</span> <span class="hljs-comment">// 引入接口</span>
<span class="hljs-keyword">import</span> { ref, onMounted } <span class="hljs-keyword">from</span> <span class="hljs-string">'vue'</span>

<span class="hljs-keyword">const</span> tableData = ref([])

onMounted(<span class="hljs-keyword">async</span> () =&gt; {
  <span class="hljs-comment">// 不需要关心 URL 是什么，不需要关心 Token 怎么传</span>
  <span class="hljs-comment">// 就像调用本地函数一样调用后端接口</span>
  <span class="hljs-keyword">try</span> {
    <span class="hljs-keyword">const</span> res = <span class="hljs-keyword">await</span> getUserList({ <span class="hljs-attr">page</span>: <span class="hljs-number">1</span>, <span class="hljs-attr">size</span>: <span class="hljs-number">10</span> })
    tableData.value = res.list
  } <span class="hljs-keyword">catch</span> (e) {
    <span class="hljs-comment">// 错误已经在拦截器处理过了，这里可以忽略或做特殊处理</span>
  }
})
</span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="18"><h3 data-path-to-node="19">3. Views vs Components：有什么区别？</h3><p data-path-to-node="20">这是初学者最容易混淆的。</p><ul data-path-to-node="21"><li><p data-path-to-node="21,0,0"><b data-path-to-node="21,0,0" data-index-in-node="0">Views (src/views):</b></p><ul data-path-to-node="21,0,1"><li><p data-path-to-node="21,0,1,0,0"><b data-path-to-node="21,0,1,0,0" data-index-in-node="0">定义:</b> 页面级组件。</p></li><li><p data-path-to-node="21,0,1,1,0"><b data-path-to-node="21,0,1,1,0" data-index-in-node="0">特点:</b> 跟路由 (<code data-path-to-node="21,0,1,1,0" data-index-in-node="9">router</code>) 一一对应。</p></li><li><p data-path-to-node="21,0,1,2,0"><b data-path-to-node="21,0,1,2,0" data-index-in-node="0">职责:</b> 负责获取数据 (调用 API)，组装各种小组件，处理业务逻辑。</p></li><li><p data-path-to-node="21,0,1,3,0"><b data-path-to-node="21,0,1,3,0" data-index-in-node="0">类比:</b> Java 的 <code data-path-to-node="21,0,1,3,0" data-index-in-node="11">Controller</code>。</p></li></ul></li><li><p data-path-to-node="21,1,0"><b data-path-to-node="21,1,0" data-index-in-node="0">Components (src/components):</b></p><ul data-path-to-node="21,1,1"><li><p data-path-to-node="21,1,1,0,0"><b data-path-to-node="21,1,1,0,0" data-index-in-node="0">定义:</b> 功能性组件。</p></li><li><p data-path-to-node="21,1,1,1,0"><b data-path-to-node="21,1,1,1,0" data-index-in-node="0">特点:</b> 不依赖具体业务，可以到处复用。</p></li><li><p data-path-to-node="21,1,1,2,0"><b data-path-to-node="21,1,1,2,0" data-index-in-node="0">职责:</b> 傻瓜式渲染。它不该直接请求 API，数据全靠 <code data-path-to-node="21,1,1,2,0" data-index-in-node="27">Props</code> 传进来，操作全靠 <code data-path-to-node="21,1,1,2,0" data-index-in-node="42">Emit</code> 发出去。</p></li><li><p data-path-to-node="21,1,1,3,0"><b data-path-to-node="21,1,1,3,0" data-index-in-node="0">类比:</b> Java 的 <code data-path-to-node="21,1,1,3,0" data-index-in-node="11">Util</code> 类或 JSP 的 <code data-path-to-node="21,1,1,3,0" data-index-in-node="25">TagLib</code>。</p></li></ul></li></ul><hr data-path-to-node="22"><h3 data-path-to-node="23">4. 完整的数据流向图</h3><p data-path-to-node="24">当用户点击一个按钮时，数据流向是这样的：</p><ol start="1" data-path-to-node="25"><li><p data-path-to-node="25,0,0"><b data-path-to-node="25,0,0" data-index-in-node="0">View (页面)</b> 捕获点击事件。</p></li><li><p data-path-to-node="25,1,0"><b data-path-to-node="25,1,0" data-index-in-node="0">View</b> 调用 <b data-path-to-node="25,1,0" data-index-in-node="8">Store (Pinia)</b> 的 Action（如果涉及全局状态）或直接调用 <b data-path-to-node="25,1,0" data-index-in-node="46">API</b> 函数。</p></li><li><p data-path-to-node="25,2,0"><b data-path-to-node="25,2,0" data-index-in-node="0">API</b> 函数通过 <b data-path-to-node="25,2,0" data-index-in-node="9">Axios 拦截器</b>，加上 Token，发给后端。</p></li><li><p data-path-to-node="25,3,0"><b data-path-to-node="25,3,0" data-index-in-node="0">后端 Spring Boot</b> 处理完，返回 JSON。</p></li><li><p data-path-to-node="25,4,0"><b data-path-to-node="25,4,0" data-index-in-node="0">Axios 拦截器</b> 剥离外壳，检查 code 是否为 200。</p></li><li><p data-path-to-node="25,5,0"><b data-path-to-node="25,5,0" data-index-in-node="0">View</b> 拿到纯净的数据，更新响应式变量 (<code data-path-to-node="25,5,0" data-index-in-node="22">ref</code>)。</p></li><li><p data-path-to-node="25,6,0"><b data-path-to-node="25,6,0" data-index-in-node="0">Vue</b> 自动更新 DOM。</p></li></ol><hr data-path-to-node="26"><h3 data-path-to-node="27">下一步建议</h3><p data-path-to-node="28">架构搭建好之后，通常我们不会自己去写 CSS 样式（按钮、表格、下拉框的样式）。在 Vue 生态中，我们会使用成熟的 <b data-path-to-node="28" data-index-in-node="59">UI 组件库</b>。</p><p data-path-to-node="29">这就好比你在 Java 里不会自己写 TCP 连接，而是用 Netty 或 Tomcat。</p><p data-path-to-node="30"><b data-path-to-node="30" data-index-in-node="0">常用的 Vue 3 UI 库有两个巨头，你想了解哪一个？</b></p><ol start="1" data-path-to-node="31"><li><p data-path-to-node="31,0,0"><b data-path-to-node="31,0,0" data-index-in-node="0">Element Plus</b>: 国内最流行，适合做<b data-path-to-node="31,0,0" data-index-in-node="23">后台管理系统</b> (风格像 Spring Boot Admin)。</p></li><li><p data-path-to-node="31,1,0"><b data-path-to-node="31,1,0" data-index-in-node="0">Ant Design Vue</b>: 阿里系，适合<b data-path-to-node="31,1,0" data-index-in-node="22">企业级中台</b> (风格更细腻，像 React 的 AntD)。</p></li></ol><p data-path-to-node="32">(根据你的 ExtJS 背景，你可能会觉得它们都很亲切，因为它们都提供了现成的 Grid, Tree, Form 组件)。</p></div></message-content><!----></div></structured-content-container><!----><!----><div _ngcontent-ng-c2257363295="" class="response-footer is-mobile has-thoughts gap complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2257363295="" _nghost-ng-c427815498="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c3217591318="" class="response-container-footer ng-tns-c3217591318-168"><!----><message-actions _ngcontent-ng-c2257363295="" footer="" _nghost-ng-c3249768162="" class="ng-tns-c3249768162-188 ng-star-inserted hide-action-bar" style=""><div _ngcontent-ng-c3249768162="" class="actions-container-v2 ng-tns-c3249768162-188 mobile"><!----><!----><div _ngcontent-ng-c3249768162="" class="spacer ng-tns-c3249768162-188 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c3249768162="" yposition="above" xposition="after" class="ng-tns-c3249768162-188"><!----></mat-menu><mat-menu _ngcontent-ng-c3249768162="" yposition="above" class="ng-tns-c3249768162-188"><!----></mat-menu><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></message-actions><!----><!----></div></div></response-container><!----><!-