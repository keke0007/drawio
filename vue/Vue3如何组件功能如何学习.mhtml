ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_7f92279e4caa7234&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_a3eda8f258fe8f75&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c115509130="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c115509130="" class="formatted-code-block-internal-container ng-tns-c115509130-167"><div _ngcontent-ng-c115509130="" class="animated-opacity ng-tns-c115509130-167"><pre _ngcontent-ng-c115509130="" class="ng-tns-c115509130-167"><code _ngcontent-ng-c115509130="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c115509130-167"><span class="hljs-keyword">import</span> { useRouter, useRoute } <span class="hljs-keyword">from</span> <span class="hljs-string">'vue-router'</span>
<span class="hljs-keyword">import</span> { useUserStore } <span class="hljs-keyword">from</span> <span class="hljs-string">'../stores/userStore'</span>

<span class="hljs-keyword">const</span> router = useRouter() <span class="hljs-comment">// 拿到路由实例，用来执行跳转</span>
<span class="hljs-keyword">const</span> route = useRoute()   <span class="hljs-comment">// 拿到当前路由信息，用来获取参数</span>
<span class="hljs-keyword">const</span> userStore = useUserStore()

<span class="hljs-keyword">const</span> handleLogin = <span class="hljs-keyword">async</span> () =&gt; {
  <span class="hljs-comment">// 1. 调用 Store 进行登录</span>
  <span class="hljs-keyword">const</span> success = <span class="hljs-keyword">await</span> userStore.login(username.value, password.value)
  
  <span class="hljs-keyword">if</span> (success) {
    <span class="hljs-comment">// 2. 登录成功后，获取之前的 redirect 参数，没有就跳去首页</span>
    <span class="hljs-keyword">const</span> redirectPath = route.query.redirect || <span class="hljs-string">'/'</span>
    
