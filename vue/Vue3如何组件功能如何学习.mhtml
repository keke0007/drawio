后台管理系统必定有分页。通常我们会把 <code data-path-to-node="23" data-index-in-node="40">el-table</code> 和 <code data-path-to-node="23" data-index-in-node="51">el-pagination</code> 放在一起。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c115509130="" class="ng-tns-c115509130-231 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c115509130="" class="code-block ng-tns-c115509130-231 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_2a7c7573fba7da59&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_0191912e8707f04d&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwilq4rO-_uRAxUAAAAAHQAAAAAQxgI" style="display: block;"><div _ngcontent-ng-c115509130="" class="code-block-decoration header-formatted gds-title-s ng-tns-c115509130-231 ng-star-inserted" style=""><span _ngcontent-ng-c115509130="" class="ng-tns-c115509130-231">HTML</span><div _ngcontent-ng-c115509130="" class="buttons ng-tns-c115509130-231 ng-star-inserted"><button _ngcontent-ng-c115509130="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c115509130-231 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_2a7c7573fba7da59&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_0191912e8707f04d&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c115509130="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c115509130="" class="formatted-code-block-internal-container ng-tns-c115509130-231"><div _ngcontent-ng-c115509130="" class="animated-opacity ng-tns-c115509130-231"><pre _ngcontent-ng-c115509130="" class="ng-tns-c115509130-231"><code _ngcontent-ng-c115509130="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c115509130-231"><span class="hljs-tag">&lt;<span class="hljs-name">div</span>&gt;</span>
