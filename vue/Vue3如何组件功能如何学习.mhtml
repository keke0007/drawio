    <span class="hljs-tag">&lt;<span class="hljs-name">el-form-item</span> <span class="hljs-attr">label</span>=<span class="hljs-string">"角色"</span> <span class="hljs-attr">prop</span>=<span class="hljs-string">"role"</span>&gt;</span>
