</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="5"><h3 data-path-to-node="6">2. 核心模块详解：API 请求层封装</h3><p data-path-to-node="7">在 Spring Boot 中，你肯定不会在 Controller 里直接写 SQL。同理，在 Vue 中，我们也不会在组件里直接写 <code data-path-to-node="7" data-index-in-node="67">axios.get('http://...')</code>。</p><p data-path-to-node="8">我们需要一个 <b data-path-to-node="8" data-index-in-node="7">Axios 拦截器</b> (类似于 Spring 的 <code data-path-to-node="8" data-index-in-node="31">HandlerInterceptor</code>)。</p><h4 data-path-to-node="9">第一层：Axios 拦截器 (<code data-path-to-node="9" data-index-in-node="15">src/utils/request.js</code>)</h4><p data-path-to-node="10">这是整个项目与后端通讯的<b data-path-to-node="10" data-index-in-node="12">咽喉</b>。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c115509130="" class="ng-tns-c115509130-196 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c115509130="" class="code-block ng-tns-c115509130-196 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_7e5d3d6fd6ef71e3&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_ec0b314c24c16e2f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwilq4rO-_uRAxUAAAAAHQAAAAAQpQI" style="display: block;"><div _ngcontent-ng-c115509130="" class="code-block-decoration header-formatted gds-title-s ng-tns-c115509130-196 ng-star-inserted" style=""><span _ngcontent-ng-c115509130="" class="ng-tns-c115509130-196">JavaScript</span><div _ngcontent-ng-c115509130="" class="buttons ng-tns-c115509130-196 ng-star-inserted"><button _ngcontent-ng-c115509130="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c115509130-196 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_7e5d3d6fd6ef71e3&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_ec0b314c24c16e2f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c115509130="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c115509130="" class="formatted-code-block-internal-container ng-tns-c115509130-196"><div _ngcontent-ng-c115509130="" class="animated-opacity ng-tns-c115509130-196"><pre _ngcontent-ng-c115509130="" class="ng-tns-c115509130-196"><code _ngcontent-ng-c115509130="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c115509130-196"><span class="hljs-keyword">import</span> axios <span class="hljs-keyword">from</span> <span class="hljs-string">'axios'</span>
<span class="hljs-keyword">import</span> { useUserStore } <span class="hljs-keyword">from</span> <span class="hljs-string">'@/stores/userStore'</span>

<span class="hljs-comment">// 1. 创建 axios 实例</span>
<span class="hljs-keyword">const</span> service = axios.create({
  <span class="hljs-attr">baseURL</span>: <span class="hljs-keyword">import</span>.meta.env.VITE_API_URL, <span class="hljs-comment">// 从环境变量获取，如 /api</span>
  <span class="hljs-attr">timeout</span>: <span class="hljs-number">5000</span>
})

<span class="hljs-comment">// 2. 请求拦截器 (Request Interceptor)</span>
<span class="hljs-comment">// 每次发请求前，自动带上 Token</span>
service.interceptors.request.use(
  <span class="hljs-function">(<span class="hljs-params">config</span>) =&gt;</span> {
    <span class="hljs-keyword">const</span> userStore = useUserStore()
    <span class="hljs-keyword">if</span> (userStore.token) {
      <span class="hljs-comment">// 类似于 Postman 里加 Header</span>
      config.headers[<span class="hljs-string">'Authorization'</span>] = <span class="hljs-string">`Bearer <span class="hljs-subst">${userStore.token}</span>`</span>
    }
    <span class="hljs-keyword">return</span> config
  },
  <span class="hljs-function">(<span class="hljs-params">error</span>) =&gt;</span> <span class="hljs-built_in">Promise</span>.reject(error)
)

<span class="hljs-comment">// 3. 响应拦截器 (Response Interceptor)</span>
<span class="hljs-comment">// 统一处理后端返回的状态码</span>
service.interceptors.response.use(
  <span class="hljs-function">(<span class="hljs-params">response</span>) =&gt;</span> {
    <span class="hljs-keyword">const</span> res = response.data
    <span class="hljs-comment">// 假设后端约定 code !== 200 就是业务错误</span>
    <span class="hljs-keyword">if</span> (res.code !== <span class="hljs-number">200</span>) {
      alert(res.message || <span class="hljs-string">'系统错误'</span>)
      
      <span class="hljs-comment">// 如果是 Token 过期 (比如 code 401)</span>
      <span class="hljs-keyword">if</span> (res.code === <span class="hljs-number">401</span>) {
        <span class="hljs-comment">// 强制登出逻辑...</span>
      }
      <span class="hljs-keyword">return</span> <span class="hljs-built_in">Promise</span>.reject(<span class="hljs-keyword">new</span> <span class="hljs-built_in">Error</span>(res.message))
    }
    <span class="hljs-keyword">return</span> res.data <span class="hljs-comment">// 直接返回数据核心部分</span>
  },
  <span class="hljs-function">(<span class="hljs-params">error</span>) =&gt;</span> {
    <span class="hljs-comment">// 处理 HTTP 网络错误 (404, 500)</span>
    <span class="hljs-built_in">console</span>.error(<span class="hljs-string">'网络请求错:'</span>, error)
    <span class="hljs-keyword">return</span> <span class="hljs-built_in">Promise</span>.reject(error)
  }
)

<span class="hljs-keyword">export</span> <span class="hljs-keyword">default</span> service
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h4 data-path-to-node="12">第二层：API 接口定义 (<code data-path-to-node="12" data-index-in-node="14">src/api/user.js</code>)</h4><p data-path-to-node="13">把接口定义成函数，就像定义 Java Interface。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c115509130="" class="ng-tns-c115509130-197 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c115509130="" class="code-block ng-tns-c115509130-197 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_7e5d3d6fd6ef71e3&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_ec0b314c24c16e2f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwilq4rO-_uRAxUAAAAAHQAAAAAQpgI" style="display: block;"><div _ngcontent-ng-c115509130="" class="code-block-decoration header-formatted gds-title-s ng-tns-c115509130-197 ng-star-inserted" style=""><span _ngcontent-ng-c115509130="" class="ng-tns-c115509130-197">JavaScript</span><div _ngcontent-ng-c115509130="" class="buttons ng-tns-c115509130-197 ng-star-inserted"><button _ngcontent-ng-c115509130="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c115509130-197 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_7e5d3d6fd6ef71e3&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_ec0b314c24c16e2f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c115509130="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c115509130="" class="formatted-code-block-internal-container ng-tns-c115509130-197"><div _ngcontent-ng-c115509130="" class="animated-opacity ng-tns-c115509130-197"><pre _ngcontent-ng-c115509130="" class="ng-tns-c115509130-197"><code _ngcontent-ng-c115509130="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c115509130-197"><span class="hljs-keyword">import</span> request <span class="hljs-keyword">from</span> <span class="hljs-string">'@/utils/request'</span>

<span class="hljs-keyword">export</span> <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">login</span>(<span class="hljs-params">data</span>) </span>{
  <span class="hljs-keyword">return</span> request({
    <span class="hljs-attr">url</span>: <span class="hljs-string">'/auth/login'</span>,
