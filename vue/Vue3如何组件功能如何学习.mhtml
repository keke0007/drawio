9062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_2a7c7573fba7da59&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_0191912e8707f04d&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c115509130="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c115509130="" class="formatted-code-block-internal-container ng-tns-c115509130-230"><div _ngcontent-ng-c115509130="" class="animated-opacity ng-tns-c115509130-230"><pre _ngcontent-ng-c115509130="" class="ng-tns-c115509130-230"><code _ngcontent-ng-c115509130="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c115509130-230"><span class="hljs-tag">&lt;<span class="hljs-name">script</span> <span class="hljs-attr">setup</span>&gt;</span><span class="javascript">
<span class="hljs-keyword">import</span> { reactive, ref } <span class="hljs-keyword">from</span> <span class="hljs-string">'vue'</span>
<span class="hljs-keyword">import</span> { ElMessage } <span class="hljs-keyword">from</span> <span class="hljs-string">'element-plus'</span> <span class="hljs-comment">// 类似于 Ext.Msg</span>

<span class="hljs-keyword">const</span> formRef = ref(<span class="hljs-literal">null</span>) <span class="hljs-comment">// 拿到表单组件的实例引用</span>

<span class="hljs-comment">// 表单数据对象 (DTO)</span>
<span class="hljs-keyword">const</span> formData = reactive({
  <span class="hljs-attr">username</span>: <span class="hljs-string">''</span>,
  <span class="hljs-attr">role</span>: <span class="hljs-string">''</span>
})

<span class="hljs-comment">// 验证规则 (Validation Rules)</span>
<span class="hljs-keyword">const</span> rules = {
  <span class="hljs-attr">username</span>: [
    { <span class="hljs-attr">required</span>: <span class="hljs-literal">true</span>, <span class="hljs-attr">message</span>: <span class="hljs-string">'请输入用户名'</span>, <span class="hljs-attr">trigger</span>: <span class="hljs-string">'blur'</span> },
    { <span class="hljs-attr">min</span>: <span class="hljs-number">3</span>, <span class="hljs-attr">max</span>: <span class="hljs-number">10</span>, <span class="hljs-attr">message</span>: <span class="hljs-string">'长度在 3 到 10 个字符'</span>, <span class="hljs-attr">trigger</span>: <span class="hljs-string">'blur'</span> }
  ],
  <span class="hljs-attr">role</span>: [
    { <span class="hljs-attr">required</span>: <span class="hljs-literal">true</span>, <span class="hljs-attr">message</span>: <span class="hljs-string">'请选择角色'</span>, <span class="hljs-attr">trigger</span>: <span class="hljs-string">'change'</span> }
  ]
}

<span class="hljs-keyword">const</span> submitForm = <span class="hljs-function">() =&gt;</span> {
  <span class="hljs-keyword">if</span> (!formRef.value) <span class="hljs-keyword">return</span>
  
  <span class="hljs-comment">// 调用组件内置的 validate 方法</span>
  formRef.value.validate(<span class="hljs-function">(<span class="hljs-params">valid</span>) =&gt;</span> {
    <span class="hljs-keyword">if</span> (valid) {
      ElMessage.success(<span class="hljs-string">'验证通过，正在提交...'</span>)
      <span class="hljs-comment">// 这里调用 axios</span>
    } <span class="hljs-keyword">else</span> {
      ElMessage.error(<span class="hljs-string">'表单填写有误！'</span>)
      <span class="hljs-keyword">return</span> <span class="hljs-literal">false</span>
    }
  })
}
</span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>

<span class="hljs-tag">&lt;<span class="hljs-name">template</span>&gt;</span>
