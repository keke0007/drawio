    <span class="hljs-attr">label-width</span>=<span class="hljs-string">"100px"</span>
    <span class="hljs-attr">style</span>=<span class="hljs-string">"max-width: 460px"</span>
  &gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">el-form-item</span> <span class="hljs-attr">label</span>=<span class="hljs-string">"用户名"</span> <span class="hljs-attr">prop</span>=<span class="hljs-string">"username"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">el-input</span> <span class="hljs-attr">v-model</span>=<span class="hljs-string">"formData.username"</span> /&gt;</span>
