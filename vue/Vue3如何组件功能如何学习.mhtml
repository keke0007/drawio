content-container _ngcontent-ng-c2257363295="" class="model-response-text has-thoughts is-mobile ng-star-inserted" _nghost-ng-c3764099196="" style="height: auto;"><div _ngcontent-ng-c3764099196="" class="container"><message-content _ngcontent-ng-c3764099196="" _nghost-ng-c2925066281="" id="message-content-id-r_55ae36efc9b6d922" class="ng-star-inserted"><div _ngcontent-ng-c2925066281="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_55ae36efc9b6d922" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">既然你准备好了，那我们直接进入<b data-path-to-node="0" data-index-in-node="15">实战模式</b>。</p><p data-path-to-node="1">光看概念不如看代码。为了让你快速理解 Vue 3 的 <code data-path-to-node="1" data-index-in-node="27">&lt;script setup&gt;</code> 写法，我为你准备了一个经典的**“用户卡片组件” (UserCard.vue)** 示例。</p><p data-path-to-node="2">这个组件涵盖了 Vue 3 开发中最常用的 4 个核心功能：</p><ol start="1" data-path-to-node="3"><li><p data-path-to-node="3,0,0"><b data-path-to-node="3,0,0" data-index-in-node="0">Props (接收数据)</b></p></li><li><p data-path-to-node="3,1,0"><b data-path-to-node="3,1,0" data-index-in-node="0">Emits (发送事件)</b></p></li><li><p data-path-to-node="3,2,0"><b data-path-to-node="3,2,0" data-index-in-node="0">Ref (内部状态)</b></p></li><li><p data-path-to-node="3,3,0"><b data-path-to-node="3,3,0" data-index-in-node="0">Computed (计算属性)</b></p></li></ol><h3 data-path-to-node="4">1. 组件代码示例 (UserCard.vue)</h3><p data-path-to-node="5">你可以直接把这段代码想象成一个独立的文件。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c115509130="" class="ng-tns-c115509130-49 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c115509130="" class="code-block ng-tns-c115509130-49 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_55ae36efc9b6d922&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_efabd64317067dfd&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwilq4rO-_uRAxUAAAAAHQAAAAAQgAE" style="display: block;"><div _ngcontent-ng-c115509130="" class="code-block-decoration header-formatted gds-title-s ng-tns-c115509130-49 ng-star-inserted" style=""><span _ngcontent-ng-c115509130="" class="ng-tns-c115509130-49">HTML</span><div _ngcontent-ng-c115509130="" class="buttons ng-tns-c115509130-49 ng-star-inserted"><button _ngcontent-ng-c115509130="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c115509130-49 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_55ae36efc9b6d922&quot;,&quot;c_8b50c378e6bd4f38&quot;,null,&quot;rc_efabd64317067dfd&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c115509130="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c115509130="" class="formatted-code-block-internal-container ng-tns-c115509130-49"><div _ngcontent-ng-c115509130="" class="animated-opacity ng-tns-c115509130-49"><pre _ngcontent-ng-c115509130="" class="ng-tns-c115509130-49"><code _ngcontent-ng-c115509130="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c115509130-49"><span class="hljs-tag">&lt;<span class="hljs-name">script</span> <span class="hljs-attr">setup</span>&gt;</span><span class="javascript">
<span class="hljs-keyword">import</span> { ref, computed } <span class="hljs-keyword">from</span> <span class="hljs-string">'vue'</span>

<span class="hljs-comment">// --- 1. 定义 Props (父组件传进来的数据) ---</span>
<span class="hljs-comment">// 相当于 ExtJS 的 config 或者是 Java 类中的成员变量</span>
<span class="hljs-keyword">const</span> props = defineProps({
  <span class="hljs-attr">username</span>: {
    <span class="hljs-attr">type</span>: <span class="hljs-built_in">String</span>,
    <span class="hljs-attr">required</span>: <span class="hljs-literal">true</span>
  },
  <span class="hljs-attr">age</span>: {
    <span class="hljs-attr">type</span>: <span class="hljs-built_in">Number</span>,
    <span class="hljs-attr">default</span>: <span class="hljs-number">18</span>
  },
  <span class="hljs-attr">status</span>: {
    <span class="hljs-attr">type</span>: <span class="hljs-built_in">String</span>,
    <span class="hljs-attr">default</span>: <span class="hljs-string">'offline'</span> <span class="hljs-comment">// online, offline, busy</span>
  }
})

<span class="hljs-comment">// --- 2. 定义 Emits (告诉父组件我要触发什么事件) ---</span>
<span class="hljs-comment">// 相当于 Java 的接口回调或者 ExtJS 的 fireEvent</span>
<span class="hljs-keyword">const</span> emit = defineEmits([<span class="hljs-string">'status-change'</span>, <span class="hljs-string">'delete-user'</span>])

<span class="hljs-comment">// --- 3. 响应式状态 (Ref) ---</span>
<span class="hljs-comment">// 组件内部的私有变量，修改它会自动更新页面</span>
<span class="hljs-keyword">const</span> isExpanded = ref(<span class="hljs-literal">false</span>) 

<span class="hljs-comment">// --- 4. 计算属性 (Computed) ---</span>
<span class="hljs-comment">// 依赖 props 或 ref 动态计算出的值，类似于 Excel 公式</span>
<span class="hljs-keyword">const</span> statusColor = computed(<span class="hljs-function">() =&gt;</span> {
  <span class="hljs-keyword">return</span> props.status === <span class="hljs-string">'online'</span> ? <span class="hljs-string">'green'</span> : <span class="hljs-string">'gray'</span>
})

<span class="hljs-comment">// --- 5. 方法 (Methods) ---</span>
<span class="hljs-comment">// 直接定义普通函数即可</span>
<span class="hljs-keyword">const</span> toggleDetails = <span class="hljs-function">() =&gt;</span> {
  isExpanded.value = !isExpanded.value <span class="hljs-comment">// 注意：在 script 中操作 ref 需要 .value</span>
}

<span class="hljs-keyword">const</span> changeStatus = <span class="hljs-function">() =&gt;</span> {
  <span class="hljs-comment">// 触发事件通知父组件，父组件去修改数据</span>
  emit(<span class="hljs-string">'status-change'</span>, props.username)
}
</span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>

<span class="hljs-tag">&lt;<span class="hljs-name">template</span>&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"user-card"</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">h3</span>&gt;</span>{{ username }} <span class="hljs-tag">&lt;<span class="hljs-name">span</span> <span class="hljs-attr">:style</span>=<span class="hljs-string">"{ color: statusColor }"</span>&gt;</span>●<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span>
    
    <span class="hljs-tag">&lt;<span class="hljs-name">p</span>&gt;</span>年龄: {{ age }}<span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>

    <span class="hljs-tag">&lt;<span class="hljs-name">button</span> @<span class="hljs-attr">click</span>=<span class="hljs-string">"toggleDetails"</span>&gt;</span>
      {{ isExpanded ? '收起详情' : '查看详情' }}
    <span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
    
    <span class="hljs-tag">&lt;<span class="hljs-name">button</span> @<span class="hljs-attr">click</span>=<span class="hljs-string">"changeStatus"</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"margin-left: 10px;"</span>&gt;</span>
      切换状态
    <span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>

    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">v-if</span>=<span class="hljs-string">"isExpanded"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"details"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">p</span>&gt;</span>这里是更多关于 {{ username }} 的详细信息...<span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">button</span> @<span class="hljs-attr">click</span>=<span class="hljs-string">"emit('delete-user')"</span>&gt;</span>删除用户<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
  <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">template</span>&gt;</span>

<span class="hljs-tag">&lt;<span class="hljs-name">style</span> <span class="hljs-attr">scoped</span>&gt;</span><span class="css">
<span class="hljs-selector-class">.user-card</span> {
  <span class="hljs-attribute">border</span>: <span class="hljs-number">1px</span> solid <span class="hljs-number">#ccc</span>;
  <span class="hljs-attribute">padding</span>: <span class="hljs-number">16px</span>;
  <span class="hljs-attribute">border-radius</span>: <span class="hljs-number">8px</span>;
  <span class="hljs-attribute">max-width</span>: <span class="hljs-number">300px</span>;
}
<span class="hljs-selector-class">.details</span> {
  <span class="hljs-attribute">margin-top</span>: <span class="hljs-number">10px</span>;
  <span class="hljs-attribute">background-color</span>: <span class="hljs-number">#f9f9f9</span>;
  <span class="hljs-attribute">padding</span>: <span class="hljs-number">8px</span>;
}
</span><span class="hljs-tag">&lt;/<span class="hljs-name">style</span>&gt;</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="7"><h3 data-path-to-node="8">2. 关键点解析 (对比你的技术栈)</h3><p data-path-to-node="9">基于你熟悉的 <b data-path-to-node="9" data-index-in-node="7">Java</b> 和 <b data-path-to-node="9" data-index-in-node="14">ExtJS</b> 背景，这样理解会更快：</p><ol start="1" data-path-to-node="10"><li><p data-path-to-node="10,0,0"><b data-path-to-node="10,0,0" data-index-in-node="0"><code data-path-to-node="10,0,0" data-index-in-node="0">defineProps</code> (接口定义):</b></p><ul data-path-to-node="10,0,1"><li><p data-path-to-node="10,0,1,0,0">这就好比 Java 中定义一个方法的入参，或者 ExtJS 组件的 <code data-path-to-node="10,0,1,0,0" data-index-in-node="34">configs</code>。</p></li><li><p data-path-to-node="10,0,1,1,0"><b data-path-to-node="10,0,1,1,0" data-index-in-node="0">注意：</b> Vue 是<b data-path-to-node="10,0,1,1,0" data-index-in-node="9">单向数据流</b>。虽然 <code data-path-to-node="10,0,1,1,0" data-index-in-node="18">props.status</code> 传进来了，但你<b data-path-to-node="10,0,1,1,0" data-index-in-node="38">不能</b>在子组件里直接写 <code data-path-to-node="10,0,1,1,0" data-index-in-node="49">props.status = 'online'</code>。必须通知父组件去改。</p></li></ul></li><li><p data-path-to-node="10,1,0"><b data-path-to-node="10,1,0" data-index-in-node="0"><code data-path-to-node="10,1,0" data-index-in-node="0">defineEmits</code> (事件回调):</b></p><ul data-path-to-node="10,1,1"><li><p data-path-to-node="10,1,1,0,0">在 ExtJS 中你可能习惯用 <code data-path-to-node="10,1,1,0,0" data-index-in-node="16">this.fireEvent('customname')</code>。</p></li><li><p data-path-to-node="10,1,1,1,0">在 Vue 3 中，必须先通过 <code data-path-to-node="10,1,1,1,0" data-index-in-node="16">defineEmits</code> 声明你可能会发出的事件，这有利于代码提示和类型检查。</p></li></ul></li><li><p data-path-to-node="10,2,0"><b data-path-to-node="10,2,0" data-index-in-node="0"><code data-path-to-node="10,2,0" data-index-in-node="0">ref</code> vs <code data-path-to-node="10,2,0" data-index-in-node="7">reactive</code>:</b></p><ul data-path-to-node="10,2,1"><li><p data-path-to-node="10,2,1,0,0">上面的例子用了 <code data-path-to-node="10,2,1,0,0" data-index-in-node="8">ref</code>。记住一个原则：<b data-path-to-node="10,2,1,0,0" data-index-in-node="19">基本类型（String, Number, Boolean）用 <code data-path-to-node="10,2,1,0,0" data-index-in-node="50">ref</code></b>。</p></li><li><p data-path-to-node="10,2,1,1,0">在 <code data-path-to-node="10,2,1,1,0" data-index-in-node="2">&lt;script&gt;</code> 只有 <code data-path-to-node="10,2,1,1,0" data-index-in-node="14">ref</code> 变量需要加 <code data-path-to-node="10,2,1,1,0" data-index-in-node="24">.value</code> 才能取值（这是初学者最大的坑），但在 <code data-path-to-node="10,2,1,1,0" data-index-in-node="50">&lt;template&gt;</code> HTML 里不需要加。</p></li></ul></li><li><p data-path-to-node="10,3,0"><b data-path-to-node="10,3,0" data-index-in-node="0"><code data-path-to-node="10,3,0" data-index-in-node="0">&lt;script setup&gt;</code>:</b></p><ul data-path-to-node="10,3,1"><li><p data-path-to-node="10,3,1,0,0">这是 Vue 3 的语法糖。你不需要像 Vue 2 那样写 <code data-path-to-node="10,3,1,0,0" data-index-in-node="30">export default { data(), methods() }</code>。</p></li><li><p data-path-to-node="10,3,1,1,0">只要在 <code data-path-to-node="10,3,1,1,0" data-index-in-node="4">script</code> 里定义的变量和函数，模板（template）里直接就能用，非常简洁。</p></li></ul></li></ol><hr data-path-to-node="11"><h3 data-path-to-node="12">接下来？</h3><p data-path-to-node="13">你现在已经看懂了“单个组件”是怎么写的。</p><p data-path-to-node="14">考虑到你有 <b data-path-to-node="14" data-index-in-node="6">Java Spring Boot</b> 背景，通常下一步会涉及<b data-path-to-node="14" data-index-in-node="34">前后端交互</b>。
<b data-path-to-node="14" data-index-in-node="41">你想了解如何把这个组件里的数据，换成从 Spring Boot 接口获取的真实数据吗？</b> (这将涉及到 <code data-path-to-node="14" data-index-in-node="92">onMounted</code> 生命周期和 <code data-path-to-node="14" data-index-in-node="108">axios</code> 请求)</p></div></message-content><!----></div></structured-content-container><!----><!----><div _ngcontent-ng-c2257363295="" class="response-footer is-mobile has-thoughts gap complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2257363295="" _nghost-ng-c427815498="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c3217591318="" class="response-container-footer ng-tns-c3217591318-40"><!----><message-actions _ngcontent-ng-c2257363295="" footer="" _nghost-ng-c3249768162="" class="ng-tns-c3249768162-45 ng-star-inserted hide-action-bar" style=""><div _ngcontent-ng-c3249768162="" class="actions-container-v2 ng-tns-c3249768162-45 mobile"><!----><!----><div _ngcontent-ng-c3249768162="" class="spacer ng-tns-c3249768162-45 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c3249768162="" yposition="above" xposition="after" class="ng-tns-c3249768162-45"><!----></mat-menu><mat-menu _ngcontent-ng-c3249768162="" yposition="above" class="ng-tns-c3249768162-45"><!----></mat-menu><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></message-actions><!----><!----></div></div></response-container><!----><!----><!----><!----><freemium-rag-disclaimer _ngcontent-ng-c2257363295="" _nghost-ng-c3728931254="" class="ng-star-inserted" style=""><!----></freemium-rag-disclaimer><!----></div></model-response><div _ngcontent-ng-c3197814349="" class="restart-chat-button-scroll-placeholder ng-star-inserted"></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!---->