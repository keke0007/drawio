n mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-content"><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-label ng-tns-c2166473866-555"><span _ngcontent-ng-c2166473866="" class="ng-tns-c2166473866-555">显示思路</span></div><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-icons ng-tns-c2166473866-555"><!----><mat-icon _ngcontent-ng-c2166473866="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c2166473866-555 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><structured-content-container _ngcontent-ng-c2200210637="" class="model-response-text has-thoughts is-mobile ng-star-inserted" _nghost-ng-c3024867895="" style="height: auto;"><div _ngcontent-ng-c3024867895="" class="container"><message-content _ngcontent-ng-c3024867895="" _nghost-ng-c4114227185="" id="message-content-id-r_9d691a24dec13fe3" class="ng-star-inserted"><div _ngcontent-ng-c4114227185="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_9d691a24dec13fe3" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">这是一个非常经典且实用的 Starter 开发场景。我们将构建一个名为 <code data-path-to-node="0" data-index-in-node="36">simple-auth-spring-boot-starter</code> 的组件。</p><p data-path-to-node="1">它的核心功能包括：</p><ol start="1" data-path-to-node="2"><li><p data-path-to-node="2,0,0"><b data-path-to-node="2,0,0" data-index-in-node="0">拦截器 (<code data-path-to-node="2,0,0" data-index-in-node="5">AuthInterceptor</code>)</b>：拦截请求，检查 Header 中的 Token。</p></li><li><p data-path-to-node="2,1,0"><b data-path-to-node="2,1,0" data-index-in-node="0">上下文 (<code data-path-to-node="2,1,0" data-index-in-node="5">UserContext</code>)</b>：基于 <code data-path-to-node="2,1,0" data-index-in-node="21">ThreadLocal</code> 存储当前用户信息，供 Controller 使用。</p></li><li><p data-path-to-node="2,2,0"><b data-path-to-node="2,2,0" data-index-in-node="0">注解 (<code data-path-to-node="2,2,0" data-index-in-node="4">@LoginRequired</code>)</b>：用于标记哪些接口需要鉴权（或者反过来，标记哪些不需要）。</p></li><li><p data-path-to-node="2,3,0"><b data-path-to-node="2,3,0" data-index-in-node="0">自动配置</b>：自动将拦截器注册到 Spring MVC 中。</p></li></ol><hr data-path-to-node="3"><h3 data-path-to-node="4">1. 项目结构与依赖</h3><p data-path-to-node="5">首先创建一个 Maven 项目，<code data-path-to-node="5" data-index-in-node="16">pom.xml</code> 引入核心依赖：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c2283161342="" class="ng-tns-c2283161342-587 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2283161342="" class="code-block ng-tns-c2283161342-587 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_9d691a24dec13fe3&quot;,&quot;c_df13630aab5a71bc&quot;,null,&quot;rc_c89bfbb2a096794f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwia5re6k-qRAxUAAAAAHQAAAAAQpwY" style="display: block;"><div _ngcontent-ng-c2283161342="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2283161342-587 ng-star-inserted" style=""><span _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-587">XML</span><div _ngcontent-ng-c2283161342="" class="buttons ng-tns-c2283161342-587 ng-s