    <span class="hljs-keyword">private</span> AuthProperties authProperties;

    <span class="hljs-meta">@Bean</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> AuthInterceptor <span class="hljs-title">authInterceptor</span><span class="hljs-params">()</span> </span>{
        <span class="hljs-keyword">return</span> <span class="hljs-keyword">new</span> AuthInterceptor();
