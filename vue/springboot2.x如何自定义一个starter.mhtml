uot;,null,&quot;rc_c89bfbb2a096794f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-591"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-591"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-591"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-591"><span class="hljs-keyword">package</span> com.example.auth.interceptor;

<span class="hljs-keyword">import</span> com.example.auth.annotation.LoginRequired;
<span class="hljs-keyword">import</span> com.example.auth.context.AuthUser;
<span class="hljs-keyword">import</span> com.example.auth.context.UserContext;
<span class="hljs-keyword">import</span> org.springframework.util.StringUtils;
<span class="hljs-keyword">import</span> org.springframework.web.method.HandlerMethod;
<span class="hljs-keyword">import</span> org.springframework.web.servlet.HandlerInterceptor;

<span class="hljs-keyword">import</span> javax.servlet.http.HttpServletRequest;
<span class="hljs-keyword">import</span> javax.servlet.http.HttpServletResponse;

<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">AuthInterceptor</span> <span class="hljs-keyword">implements</span> <span class="hljs-title">HandlerInterceptor</span> </span>{

    <span class="hljs-meta">@Override</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">boolean</span> <span class="hljs-title">preHandle</span><span class="hljs-params">(HttpServletRequest request, HttpServletResponse response, Object handler)</span> <span class="hljs-keyword">throws</span> Exception </span>{
        <span class="hljs-comment">// 如果不是映射到方法直接通过（比如静态资源）</span>
        <span class="hljs-keyword">if</span> (!(handler <span class="hljs-keyword">instanceof</span> HandlerMethod)) {
            <span class="hljs-keyword">return</span> <span class="hljs-keyword">true</span>;
        }

        HandlerMethod handlerMethod = (HandlerMethod) handler;
        
        <span class="hljs-comment">// 1. 判断是否需要鉴权</span>
        <span class="hljs-comment">// 这里可以结合 AuthProperties 的配置，也可以检查注解</span>
        LoginRequired loginRequired = handlerMethod.getMethodAnnotation(LoginRequired.class);
        <span class="hljs-keyword">if</span> (loginRequired != <span class="hljs-keyword">null</span> &amp;&amp; !loginRequired.required()) {
            <span class="hljs-keyword">return</span> <span class="hljs-keyword">true</span>; <span class="hljs-comment">// 显式标记为不需要登录</span>
        }

        <span class="hljs-comment">// 2. 获取 Token</span>
        String token = request.getHeader(<span class="hljs-string">"Authorization"</span>);
        <span class="hljs-keyword">if</span> (!StringUtils.hasText(token)) {
            <span class="hljs-keyword">throw</span> <span class="hljs-keyword">new</span> RuntimeException(<span class="hljs-string">"401 Unauthorized: Token is missing"</span>);
        }

        <span class="hljs-comment">// 3. 校验 Token (这里模拟逻辑，实际项目中通常是解析 JWT 或查 Redis)</span>
        <span class="hljs-comment">// 实际开发中，这里建议定义一个接口 AuthStrategy，让用户自己注入实现</span>
        <span class="hljs-keyword">if</span> (<span class="hljs-string">"invalid_token"</span>.equals(token)) {
             <span class="hljs-keyword">throw</span> <span class="hljs-keyword">new</span> RuntimeException(<span class="hljs-string">"401 Unauthorized: Invalid Token"</span>);
        }

        <span class="hljs-comment">// 4. 解析用户信息并存入上下文</span>
        AuthUser user = <span class="hljs-keyword">new</span> AuthUser();
        user.setUserId(<span class="hljs-string">"1001"</span>); <span class="hljs-comment">// 模拟解析出的 ID</span>
        user.setUsername(<span class="hljs-string">"admin"</span>);
        UserContext.set(user);

        <span class="hljs-keyword">return</span> <span class="hljs-keyword">true</span>;
    }

    <span class="hljs-meta">@Override</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">afterCompletion</span><span class="hljs-params">(HttpServletRequest request, HttpServletResponse response, Object handler, Exception ex)</span> </span>{
        <span class="hljs-comment">// 请求结束后必须清理 ThreadLocal，防止内存泄漏</span>
        UserContext.clear();
    }
}
