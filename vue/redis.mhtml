ntion;BardVeMetadataKey:[[&quot;r_c3fc2f9963cb0b64&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_fba3e097f98b28b1&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwia5re6k-qRAxUAAAAAHQAAAAAQgQM" style="display: block;"><div _ngcontent-ng-c2283161342="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2283161342-265 ng-star-inserted" style=""><span _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-265">XML</span><div _ngcontent-ng-c2283161342="" class="buttons ng-tns-c2283161342-265 ng-star-inserted"><button _ngcontent-ng-c2283161342="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2283161342-265 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_c3fc2f9963cb0b64&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_fba3e097f98b28b1&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-265"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-265"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-265"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-265"><span class="hljs-tag">&lt;<span class="hljs-name">dependency</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">groupId</span>&gt;</span>org.redisson<span class="hljs-tag">&lt;/<span class="hljs-name">groupId</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">artifactId</span>&gt;</span>redisson<span class="hljs-tag">&lt;/<span class="hljs-name">artifactId</span>&gt;</span>
