p="round" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4"></path></g></g></g></svg></div></div></bard-avatar><!----><!----></div><!----><div _ngcontent-ng-c3454274491="" class="response-container-content ng-tns-c3454274491-383 is-mobile has-thoughts"><div _ngcontent-ng-c3454274491="" class="menu-button-wrapper ng-tns-c3454274491-383 ng-star-inserted" style=""><button _ngcontent-ng-c3454274491="" mat-button="" mattooltip="更多" tabindex="0" aria-label="显示更多选项" data-test-id="more-menu-button" class="mdc-button mat-mdc-button-base mat-mdc-tooltip-trigger icon-button more-button ng-tns-c3454274491-383 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" aria-describedby="cdk-describedby-message-ng-1-31" cdk-describedby-host="ng-1"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><mat-icon _ngcontent-ng-c3454274491="" role="img" fonticon="more_vert" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="more_vert"></mat-icon><span class="mdc-button__label"></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c2200210637="" class="response-content ng-tns-c3454274491-383"><div _ngcontent-ng-c2200210637="" class="thoughts-container"><div _ngcontent-ng-c2200210637="" class="thoughts-content ng-star-inserted" style=""><div _ngcontent-ng-c2200210637="" class="thoughts-wrapper"><!----><model-thoughts _ngcontent-ng-c2200210637="" data-test-id="model-thoughts" _nghost-ng-c2166473866="" class="ng-tns-c2166473866-385 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c2166473866="" class="model-thoughts ng-tns-c2166473866-385 is-mobile"><div _ngcontent-ng-c2166473866="" class="thoughts-header ng-tns-c2166473866-385"><button _ngcontent-ng-c2166473866="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c2166473866-385 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-content"><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-label ng-tns-c2166473866-385"><span _ngcontent-ng-c2166473866="" class="ng-tns-c2166473866-385">显示思路</span></div><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-icons ng-tns-c2166473866-385"><!----><mat-icon _ngcontent-ng-c2166473866="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c2166473866-385 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><structured-content-container _ngcontent-ng-c2200210637="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c3024867895="" style="height: auto;"><div _ngcontent-ng-c3024867895="" class="container"><message-content _ngcontent-ng-c3024867895="" _nghost-ng-c4114227185="" id="message-content-id-r_40e3b655be7a399f" class="ng-star-inserted"><div _ngcontent-ng-c4114227185="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_40e3b655be7a399f" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">配置 Redis 集群（Redis Cluster）主要分为两大部分：<b data-path-to-node="0" data-index-in-node="35">服务端的基础架构搭建</b> 和 <b data-path-to-node="0" data-index-in-node="48">客户端（Spring Boot/Redisson）的连接配置</b>。</p><p data-path-to-node="1">由于我们之前的对话主要集中在 Java 客户端，我将重点放在<b data-path-to-node="1" data-index-in-node="30">客户端如何配置</b>，同时简述服务端的架构要求。</p><hr data-path-to-node="2"><h3 data-path-to-node="3">1. 服务端架构基础 (原理速览)</h3><p data-path-to-node="4">在配置之前，你需要知道 Redis Cluster 的几个核心规则：</p><ul data-path-to-node="5"><li><p data-path-to-node="5,0,0"><b data-path-to-node="5,0,0" data-index-in-node="0">去中心化：</b> 没有中心节点（不像 Sentinel 模式有个哨兵）。节点之间通过 Gossip 协议交换信息。</p></li><li><p data-path-to-node="5,1,0"><b data-path-to-node="5,1,0" data-index-in-node="0">槽位 (Slots)：</b> 数据被分为 <b data-path-to-node="5,1,0" data-index-in-node="18">16384</b> 个槽。数据存取时，根据 Key 的 CRC16 值对 16384 取模，决定去哪个节点。</p></li><li><p data-path-to-node="5,2,0"><b data-path-to-node="5,2,0" data-index-in-node="0">最小规模：</b> 生产环境至少需要 <b data-path-to-node="5,2,0" data-index-in-node="15">3 主 3 从</b>（共 6 个节点）。因为为了保证高可用，每个主节点至少要有一个从节点；而为了进行选举投票，至少需要 3 个主节点。</p></li></ul><hr data-path-to-node="6"><h3 data-path-to-node="7">2. Spring Boot (Lettuce) 集群配置</h3><p data-path-to-node="8">如果你使用的是 Spring Boot 默认的 <b data-path-to-node="8" data-index-in-node="24">Lettuce</b> 客户端，配置非常简单。你只需要将原来的 <code data-path-to-node="8" data-index-in-node="52">host/port</code> 替换为 <code data-path-to-node="8" data-index-in-node="66">cluster.nodes</code>。</p><h4 data-path-to-node="9">修改 <code data-path-to-node="9" data-index-in-node="3">application.yml</code></h4><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c2283161342="" class="ng-tns-c2283161342-400 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2283161342="" class="code-block ng-tns-c2283161342-400 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_40e3b655be7a399f&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_99d94db85b3d167b&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwia5re6k-qRAxUAAAAAHQAAAAAQrgQ" style="display: block;"><div _ngcontent-ng-c2283161342="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2283161342-400 ng-star-inserted" style=""><span _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-400">YAML</span><div _ngcontent-ng-c2283161342="" class="buttons ng-tns-c2283161342-400 ng-star-inserted"><button _ngcontent-ng-c2283161342="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2283161342-400 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_40e3b655be7a399f&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_99d94db85b3d167b&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-400"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-400"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-400"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-400"><span class="hljs-attr">spring:</span>
  <span class="hljs-attr">data:</span>
    <span class="hljs-attr">redis:</span>
      <span class="hljs-attr">password:</span> <span class="hljs-string">"yourpassword"</span> <span class="hljs-comment"># 如果有密码</span>
      <span class="hljs-attr">timeout:</span> <span class="hljs-string">5000ms</span>
      
      <span class="hljs-comment"># 【核心配置】集群节点列表</span>
      <span class="hljs-attr">cluster:</span>
        <span class="hljs-attr">nodes:</span>
          <span class="hljs-bullet">-</span> <span class="hljs-number">192.168</span><span class="hljs-number">.1</span><span class="hljs-number">.101</span><span class="hljs-string">:6379</span>
          <span class="hljs-bullet">-</span> <span class="hljs-number">192.168</span><span class="hljs-number">.1</span><span class="hljs-number">.102</span><span class="hljs-string">:6379</span>
          <span class="hljs-bullet">-</span> <span class="hljs-number">192.168</span><span class="hljs-number">.1</span><span class="hljs-number">.103</span><span class="hljs-string">:6379</span>
          <span class="hljs-comment"># 其实只需要填部分节点，客户端会自动发现其他节点</span>
          <span class="hljs-comment"># 但建议多填几个，防止启动时某个节点挂了连不上</span>
        
        <span class="hljs-comment"># 最大重定向次数 (MOVED/ASK)</span>
        <span class="hljs-comment"># 当数据发生了迁移，客户端需要转发请求的次数，默认 5 即可</span>
        <span class="hljs-attr">max-redirects:</span> <span class="hljs-number">5</span>

      <span class="hljs-comment"># 连接池配置 (同单机)</span>
      <span class="hljs-attr">lettuce:</span>
        <span class="hljs-attr">pool:</span>
          <span class="hljs-attr">max-active:</span> <span class="hljs-number">32</span>
          <span class="hljs-attr">max-wait:</span> <span class="hljs-string">1000ms</span>
          <span class="hljs-attr">max-idle:</span> <span class="hljs-number">32</span>
          <span class="hljs-attr">min-idle:</span> <span class="hljs-number">8</span>
        
        <span class="hljs-comment"># 【进阶配置】拓扑刷新 (解决 Docker/K8s 环境连不上的问题)</span>
        <span class="hljs-attr">cluster:</span>
          <span class="hljs-attr">refresh:</span>
            <span class="hljs-attr">adaptive:</span> <span class="hljs-literal">true</span> <span class="hljs-comment"># 自适应刷新</span>
            <span class="hljs-attr">period:</span> <span class="hljs-string">60s</span>    <span class="hljs-comment"># 或者每 60秒 强制刷新一次拓扑视图</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><blockquote data-path-to-node="11"><p data-path-to-node="11,0"><b data-path-to-node="11,0" data-index-in-node="0">注意：拓扑刷新 (Cluster Topology Refresh)</b>
在云原生环境（Docker/K8s）中，Redis 节点上报的 IP 可能是容器内部 IP（172.x.x.x），外部客户端无法访问。开启 <code data-path-to-node="11,0" data-index-in-node="105">refresh</code> 配置有助于 Lettuce 动态更新正确的节点映射，但解决 NAT 问题的根本通常需要在 Redis 服务端配置 <code data-path-to-node="11,0" data-index-in-node="170">cluster-announce-ip</code>。</p></blockquote><hr data-path-to-node="12"><h3 data-path-to-node="13">3. Redisson 集群配置</h3><p data-path-to-node="14">如果你在项目中引入了 Redisson（如我们之前讨论的混合模式），通常 Redisson 会自动读取 Spring 的 <code data-path-to-node="14" data-index-in-node="61">cluster.nodes</code> 配置。</p><p data-path-to-node="15">但在某些需要<b data-path-to-node="15" data-index-in-node="6">独立配置</b>或<b data-path-to-node="15" data-index-in-node="11">调优</b>的场景下，你需要配置 <code data-path-to-node="15" data-index-in-node="24">clusterServersConfig</code>。</p><h4 data-path-to-node="16">(1) 自动读取模式 (依赖 <code data-path-to-node="16" data-index-in-node="15">redisson-spring-boot-starter</code>)</h4><p data-path-to-node="17"><b data-path-to-node="17" data-index-in-node="0">不需要做任何事</b>。只要 <code data-path-to-node="17" data-index-in-node="11">application.yml</code> 里写了 <code data-path-to-node="17" data-index-in-node="31">spring.data.redis.cluster</code>，Redisson 启动时会自动识别为集群模式。</p><h4 data-path-to-node="18">(2) 手动/独立配置模式 (<code data-path-to-node="18" data-index-in-node="15">redisson.yaml</code>)</h4><p data-path-to-node="19">如果需要手动配置，结构如下：</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c2283161342="" class="ng-tns-c2283161342-401 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2283161342="" class="code-block ng-tns-c2283161342-401 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_40e3b655be7a399f&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_99d94db85b3d167b&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwia5re6k-qRAxUAAAAAHQAAAAAQrwQ" style="display: block;"><div _ngcontent-ng-c2283161342="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2283161342-401 ng-star-inserted" style=""><span _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-401">YAML</span><div _ngcontent-ng-c2283161342="" class="buttons ng-tns-c2283161342-401 ng-star-inserted"><button _ngcontent-ng-c2283161342="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2283161342-401 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_40e3b655be7a399f&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_99d94db85b3d167b&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-401"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-401"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-401"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-401"><span class="hljs-attr">clusterServersConfig:</span>
  <span class="hljs-comment"># 节点地址，必须以 redis:// 开头</span>
  <span class="hljs-attr">nodeAddresses:</span>
    <span class="hljs-bullet">-</span> <span class="hljs-string">"redis://192.168.1.101:6379"</span>
    <span class="hljs-bullet">-</span> <span class="hljs-string">"redis://192.168.1.102:6379"</span>
    <span class="hljs-bullet">-</span> <span class="hljs-string">"redis://192.168.1.103:6379"</span>
  
  <span class="hljs-comment"># 扫描间隔 (毫秒)，检测节点状态</span>
  <span class="hljs-attr">scanInterval:</span> <span class="hljs-number">2000</span>
  
  <span class="hljs-comment"># 读写分离策略</span>
  <span class="hljs-comment"># SLAVE: 只读从节点 (读写分离，有数据延迟风险)</span>
  <span class="hljs-comment"># MASTER: 只读主节点 (强一致性，推荐)</span>
  <span class="hljs-comment"># MASTER_SLAVE: 混合读取</span>
  <span class="hljs-attr">readMode:</span> <span class="hljs-string">"MASTER"</span>
  
  <span class="hljs-comment"># 负载均衡算法 (轮询、随机等)</span>
  <span class="hljs-attr">loadBalancer:</span> <span class="hljs-type">!&lt;org.redisson.connection.balancer.RoundRobinLoadBalancer&gt;</span> {}
  
  <span class="hljs-comment"># 连接池大小 (指的是连接到每一个节点的连接数)</span>
  <span class="hljs-attr">slaveConnectionPoolSize:</span> <span class="hljs-number">64</span>
  <span class="hljs-attr">masterConnectionPoolSize:</span> <span class="hljs-number">64</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="21"><h3 data-path-to-node="22">4. 集群模式下的开发坑 (Code Changes)</h3><p data-path-to-node="23">配置好集群后，你的业务代码可能需要注意以下几点，因为集群和单机在使用上是有区别的：</p><div class="horizontal-scroll-wrapper"><div class="table-block-component"><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><table-block _nghost-ng-c3726268734="" class="ng-star-inserted"><div _ngcontent-ng-c3726268734="" class="table-block has-export-button has-scrollbar"><div _ngcontent-ng-c3726268734="" not-end-of-paragraph="" class="table-content not-end-of-paragraph" jslog="275421;track:impression,attention" data-hveid="0" decode-data-ved="1" data-ved="0CAAQ3ecQahgKEwia5re6k-qRAxUAAAAAHQAAAAAQsAQ"><table data-path-to-node="24"><thead><tr><td><span data-path-to-node="24,0,0,0">问题点</span></td><td><span data-path-to-node="24,0,1,0">现象/原因</span></td><td><span data-path-to-node="24,0,2,0">解决方案</span></td></tr></thead><tbody><tr><td><span data-path-to-node="24,1,0,0"><b data-path-to-node="24,1,0,0" data-index-in-node="0">多 Key 操作</b></span></td><td><span data-path-to-node="24,1,1,0"><code data-path-to-node="24,1,1,0" data-index-in-node="0">mget</code>, <code data-path-to-node="24,1,1,0" data-index-in-node="6">mset</code> 可能会报错。因为这组 Key 可能分布在不同的 Slot（不同的机器上），Redis 不支持跨机器原子操作。</span></td><td><p data-path-to-node="24,1,2,0">1. 业务层面循环 <code data-path-to-node="24,1,2,0" data-index-in-node="10">get/set</code> (性能差)。</p><br data-path-to-node="24,1,2,1"><p data-path-to-node="24,1,2,2">2. 使用 <b data-path-to-node="24,1,2,2" data-index-in-node="6">Hash Tag</b>：把 Key 命名为 <code data-path-to-node="24,1,2,2" data-index-in-node="25">{user:100}:name</code>, <code data-path-to-node="24,1,2,2" data-index-in-node="42">{user:100}:age</code>，大括号 <code data-path-to-node="24,1,2,2" data-index-in-node="61">{}</code> 内的内容相同，就会被分到同一个节点。</p></td></tr><tr><td><span data-path-to-node="24,2,0,0"><b data-path-to-node="24,2,0,0" data-index-in-node="0">Lua 脚本</b></span></td><td><span data-path-to-node="24,2,1,0">同样，Lua 脚本里操作的所有 Key 必须在同一个 Slot 上，否则报错。</span></td><td><span data-path-to-node="24,2,2,0">使用 Hash Tag 确保 Key 落在一起。</span></td></tr><tr><td><span data-path-to-node="24,3,0,0"><b data-path-to-node="24,3,0,0" data-index-in-node="0">Pipeline</b></span></td><td><span data-path-to-node="24,3,1,0"><code data-path-to-node="24,3,1,0" data-index-in-node="0">RedisTemplate</code> 的 Pipeline 在集群模式下机制不同（需要客户端在本地聚合），Lettuce 支持较好，Jedis 支持较差。</span></td><td><span data-path-to-node="24,3,2,0">尽量使用 Lettuce。</span></td></tr><tr><td><span data-path-to-node="24,4,0,0"><b data-path-to-node="24,4,0,0" data-index-in-node="0">事务</b></span></td><td><span data-path-to-node="24,4,1,0">Redis Cluster 对事务的支持非常有限（仅限单节点）。</span></td><td><span data-path-to-node="24,4,2,0"><b data-path-to-node="24,4,2,0" data-index-in-node="0">不建议在集群模式下依赖 Redis 事务</b>，建议用 Lua 脚本代替。</span></td></tr></tbody></table></div><div _ngcontent-ng-c3726268734="" hide-from-message-actions="" class="table-footer hide-from-message-actions ng-star-inserted"><!----><button _ngcontent-ng-c3726268734="" mat-icon-button="" mattooltip="复制表格" aria-label="复制表格" data-test-id="copy-table-button" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="276666;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_40e3b655be7a399f&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,null,null,null,null,null,1,null,null,null,0]]"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c3726268734="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-l google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----></div><!----></table-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></div></div><hr data-path-to-node="25"><h3 data-path-to-node="26">5. 常见报错排查</h3><ol start="1" data-path-to-node="27"><li><p data-path-to-node="27,0,0"><b data-path-to-node="27,0,0" data-index-in-node="0"><code data-path-to-node="27,0,0" data-index-in-node="0">MOVED 12345 192.168.1.5:6379</code></b></p><ul data-path-to-node="27,0,1"><li><p data-path-to-node="27,0,1,0,0"><b data-path-to-node="27,0,1,0,0" data-index-in-node="0">原因：</b> 客户端连接的节点不对，数据在另一个节点上。</p></li><li><p data-path-to-node="27,0,1,1,0"><b data-path-to-node="27,0,1,1,0" data-index-in-node="0">解决：</b> Lettuce/Redisson 会自动处理这个错误并重定向，如果你在日志里偶尔看到这个是正常的。如果一直报错，说明客户端的“拓扑视图”过期了，检查网络或开启拓扑刷新。</p></li></ul></li><li><p data-path-to-node="27,1,0"><b data-path-to-node="27,1,0" data-index-in-node="0"><code data-path-to-node="27,1,0" data-index-in-node="0">CLUSTERDOWN The cluster is down</code></b></p><ul data-path-to-node="27,1,1"><li><p data-path-to-node="27,1,1,0,0"><b data-path-to-node="27,1,1,0,0" data-index-in-node="0">原因：</b> 超过半数的主节点挂了，或者某些 Slot 没有节点负责（集群处于不完整状态）。</p></li><li><p data-path-to-node="27,1,1,1,0"><b data-path-to-node="27,1,1,1,0" data-index-in-node="0">解决：</b> 检查服务端状态，通过 <code data-path-to-node="27,1,1,1,0" data-index-in-node="15">redis-cli --cluster check &lt;ip&gt;:&lt;port&gt;</code> 查看健康度。</p></li></ul></li><li><p data-path-to-node="27,2,0"><b data-path-to-node="27,2,0" data-index-in-node="0"><code data-path-to-node="27,2,0" data-index-in-node="0">CROSSSLOT Keys in request don't hash to the same slot</code></b></p><ul data-path-to-node="27,2,1"><li><p data-path-to-node="27,2,1,0,0"><b data-path-to-node="27,2,1,0,0" data-index-in-node="0">原因：</b> 你尝试对不同槽位的 Key 使用 <code data-path-to-node="27,2,1,0,0" data-index-in-node="21">mset</code> 或 Lua 脚本。</p></li><li><p data-path-to-node="27,2,1,1,0"><b data-path-to-node="27,2,1,1,0" data-index-in-node="0">解决：</b> 使用 Hash Tag <code data-path-to-node="27,2,1,1,0" data-index-in-node="16">{tag}</code> 强制归位。</p></li></ul></li></ol><hr data-path-to-node="28"><p data-path-to-node="29"><b data-path-to-node="29" data-index-in-node="0">建议的下一步</b></p><p data-path-to-node="30">配置完集群后，开发者最常遇到的问题就是 <b data-path-to-node="30" data-index-in-node="20">“我怎么批量删除或查询某一类 Key？”</b>（因为 <code data-path-to-node="30" data-index-in-node="44">keys *</code> 在集群里是禁用的或者极慢的）。</p><p data-path-to-node="31">你需要我介绍 <b data-path-to-node="31" data-index-in-node="7">在 Redis 集群模式下，如何优雅地进行数据扫描（Scan）和批量操作</b> 吗？</p></div><!----></message-content><!----></div></structured-content-container><!----><!----><div _ngcontent-ng-c2200210637="" class="response-footer is-mobile gap has-thoughts complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2200210637="" _nghost-ng-c1438932748="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c3454274491="" class="response-container-footer ng-tns-c3454274491-383"><!----><message-actions _ngcontent-ng-c2200210637="" footer="" _nghost-ng-c192