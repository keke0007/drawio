</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="22"><b data-path-to-node="22" data-index-in-node="0">步骤 2：创建 redisson.yaml</b></p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c2283161342="" class="ng-tns-c2283161342-164 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2283161342="" class="code-block ng-tns-c2283161342-164 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_6c52e688b3af9d80&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_5eb78da5dd4a6f18&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwia5re6k-qRAxUAAAAAHQAAAAAQnQI" style="display: block;"><div _ngcontent-ng-c2283161342="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2283161342-164 ng-star-inserted" style=""><span _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-164">YAML</span><div _ngcontent-ng-c2283161342="" class="buttons ng-tns-c2283161342-164 ng-star-inserted"><button _ngcontent-ng-c2283161342="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2283161342-164 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_6c52e688b3af9d80&quot;,&quot;c_1e4