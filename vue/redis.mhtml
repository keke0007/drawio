tton-content"><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-label ng-tns-c2166473866-43"><span _ngcontent-ng-c2166473866="" class="ng-tns-c2166473866-43">显示思路</span></div><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-icons ng-tns-c2166473866-43"><!----><mat-icon _ngcontent-ng-c2166473866="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c2166473866-43 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><structured-content-container _ngcontent-ng-c2200210637="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c3024867895="" style="height: auto;"><div _ngcontent-ng-c3024867895="" class="container"><message-content _ngcontent-ng-c3024867895="" _nghost-ng-c4114227185="" id="message-content-id-r_18ef6459a589c014" class="ng-star-inserted"><div _ngcontent-ng-c4114227185="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_18ef6459a589c014" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">这是一个非常关键的问题。很多开发者误以为 <code data-path-to-node="0" data-index-in-node="21">setValueSerializer</code> 会管理所有类型的“值”，但实际上 <b data-path-to-node="0" data-index-in-node="57">Hash 结构有自己独立的序列化配置</b>。</p><p data-path-to-node="1">在 <code data-path-to-node="1" data-index-in-node="2">RedisTemplate</code> 中，序列化规则是根据<b data-path-to-node="1" data-index-in-node="26">数据结构的位置</b>来决定的，而不是根据数据类型（List/Set 等）本身。</p><p data-path-to-node="2">以下是详细的映射关系表：</p><h3 data-path-to-node="3">1. 规则总览表</h3><div class="horizontal-scroll-wrapper"><div class="table-block-component"><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><table-block _nghost-ng-c3726268734="" class="ng-star-inserted"><div _ngcontent-ng-c3726268734="" class="table-block has-export-button has-scrollbar"><div _ngcontent-ng-c3726268734="" not-end-of-paragraph="" class="table-content not-end-of-paragraph" jslog="275421;track:impression,attention" data-hveid="0" decode-data-ved="1" data-ved="0CAAQ3ecQahgKEwia5re6k-qRAxUAAAAAHQAAAAAQgQE"><table data-path-to-node="4"><thead><tr><td><span data-path-to-node="4,0,0,0">数据结构</span></td><td><span data-path-to-node="4,0,1,0">Redis 中的部分</span></td><td><span data-path-to-node="4,0,2,0">对应的 Java 配置方法</span></td><td><span data-path-to-node="4,0,3,0">通常建议的配置</span></td></tr></thead><tbody><tr><td><span data-path-to-node="4,1,0,0"><b data-path-to-node="4,1,0,0" data-index-in-node="0">所有结构</b></span></td><td><span data-path-to-node="4,1,1,0"><b data-path-to-node="4,1,1,0" data-index-in-node="0">顶层 Key</b> (Redis Key)</span></td><td><span data-path-to-node="4,1,2,0"><code data-path-to-node="4,1,2,0" data-index-in-node="0">setKeySerializer()</code></span></td><td><span data-path-to-node="4,1,3,0">String</span></td></tr><tr><td><span data-path-to-node="4,2,0,0"><b data-path-to-node="4,2,0,0" data-index-in-node="0">Hash</b></span></td><td><span data-path-to-node="4,2,1,0"><b data-path-to-node="4,2,1,0" data-index-in-node="0">Hash Key</b> (即 Field/字段)</span></td><td><span data-path-to-node="4,2,2,0"><code data-path-to-node="4,2,2,0" data-index-in-node="0">setHashKeySerializer()</code></span></td><td><span data-path-to-node="4,2,3,0">String</span></td></tr><tr><td><span data-path-to-node="4,3,0,0"><b data-path-to-node="4,3,0,0" data-index-in-node="0">Hash</b></span></td><td><span data-path-to-node="4,3,1,0"><b data-path-to-node="4,3,1,0" data-index-in-node="0">Hash Value</b> (即字段的值)</span></td><td><span data-path-to-node="4,3,2,0"><code data-path-to-node="4,3,2,0" data-index-in-node="0">setHashValueSerializer()</code></span></td><td><span data-path-to-node="4,3,3,0">JSON</span></td></tr><tr><td><span data-path-to-node="4,4,0,0"><b data-path-to-node="4,4,0,0" data-index-in-node="0">List</b></span></td><td><span data-path-to-node="4,4,1,0">List 中的元素</span></td><td><span data-path-to-node="4,4,2,0"><code data-path-to-node="4,4,2,0" data-index-in-node="0">setValueSerializer()</code></span></td><td><span data-path-to-node="4,4,3,0">JSON</span></td></tr><tr><td><span data-path-to-node="4,5,0,0"><b data-path-to-node="4,5,0,0" data-index-in-node="0">Set</b></span></td><td><span data-path-to-node="4,5,1,0">Set 中的元素</span></td><td><span data-path-to-node="4,5,2,0"><code data-path-to-node="4,5,2,0" data-index-in-node="0">setValueSerializer()</code></span></td><td><span data-path-to-node="4,5,3,0">JSON</span></td></tr><tr><td><span data-path-to-node="4,6,0,0"><b data-path-to-node="4,6,0,0" data-index-in-node="0">ZSet</b></span></td><td><span data-path-to-node="4,6,1,0">ZSet 中的成员 (Member)</span></td><td><span data-path-to-node="4,6,2,0"><code data-path-to-node="4,6,2,0" data-index-in-node="0">setValueSerializer()</code></span></td><td><span data-path-to-node="4,6,3,0">JSON</span></td></tr></tbody></table></div><div _ngcontent-ng-c3726268734="" hide-from-message-actions="" class="table-footer hide-from-message-actions ng-star-inserted"><!----><button _ngcontent-ng-c3726268734="" mat-icon-button="" mattooltip="复制表格" aria-label="复制表格" data-test-id="copy-table-button" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="276666;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_18ef6459a589c014&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,null,null,null,null,null,1,null,null,null,0]]"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c3726268734="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-l google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----><!----></div><!----></div><!----></table-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></div></div><hr data-path-to-node="5"><h3 data-path-to-node="6">2. 详细图解</h3><p data-path-to-node="7">为了让你更直观地理解，我们把代码操作和序列化器对应起来：</p><h4 data-path-to-node="8">(1) Hash 结构 (最特殊)</h4><p data-path-to-node="9">Hash 是唯一需要用到 <code data-path-to-node="9" data-index-in-node="13">HashKeySerializer</code> 和 <code data-path-to-node="9" data-index-in-node="33">HashValueSerializer</code> 的结构。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c2283161342="" class="ng-tns-c2283161342-56 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2283161342="" class="code-block ng-tns-c2283161342-56 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_18ef6459a589c014&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_97cfeeca189d770f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwia5re6k-qRAxUAAAAAHQAAAAAQgwE" style="display: block;"><div _ngcontent-ng-c2283161342="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2283161342-56 ng-star-inserted" style=""><span _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-56">Java</span><div _ngcontent-ng-c2283161342="" class="buttons ng-tns-c2283161342-56 ng-star-inserted"><button _ngcontent-ng-c2283161342="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2283161342-56 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_18ef6459a589c014&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_97cfeeca189d770f&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-56"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-56"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-56"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-56"><span class="hljs-comment">// 代码：opsForHash().put("user:1001", "name", "gemini");</span>

<span class="hljs-string">"user:1001"</span>  -&gt; 使用 keySerializer (建议 String)
