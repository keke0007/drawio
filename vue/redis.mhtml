      <span class="hljs-attr">password:</span>  <span class="hljs-comment"># 如果有密码填这里</span>
      <span class="hljs-attr">database:</span> <span class="hljs-number">0</span>
      <span class="hljs-attr">timeout:</span> <span class="hljs-string">3000ms</span>
      <span class="hljs-attr">lettuce:</span>
        <span class="hljs-attr">pool:</span>
          <span class="hljs-attr">max-active:</span> <span class="hljs-number">8</span> <span class="hljs-comment"># 最大连接数</span>
          <span class="hljs-attr">max-wait:</span> <span class="hljs-string">-1ms</span> <span class="hljs-comment"># 最大等待时间</span>
          <span class="hljs-attr">max-idle:</span> <span class="hljs-number">8</span>    <span class="hljs-comment"># 最大空闲连接</span>
          <span class="hljs-attr">min-idle:</span> <span class="hljs-number">0</span>    <span class="hljs-comment"># 最小空闲连接</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 data-path-to-node="9">3. 配置类：配置 Lettuce 的序列化</h3><p data-path-to-node="10">这是为了解决我们之前讨论的“乱码”问题，让 Lettuce (RedisTemplate) 存入 JSON。</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c2283161342="" class="ng-tns-c2283161342-146 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2283161342="" class="code-block ng-tns-c2283161342-146 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_724f80f75170a3bf&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_683b97d40ce7f317&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwia5re6k-qRAxUAAAAAHQAAAAAQgwI" style="display: block;"><div _ngcontent-ng-c2283161342="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2283161342-146 ng-star-inserted" style=""><span _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-146">Java</span><div _ngcontent-ng-c2283161342="" class="buttons ng-tns-c2283161342-146 ng-star-inserted"><button _ngcontent-ng-c2283161342="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2283161342-146 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_724f80f75170a3bf&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_683b97d40ce7f317&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-146"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-146"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-146"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-146"><span class="hljs-keyword">import</span> com.fasterxml.jackson.annotation.JsonAutoDetect;
<span class="hljs-keyword">import</span> com.fasterxml.jackson.annotation.PropertyAccessor;
<span class="hljs-keyword">import</span> com.fasterxml.jackson.databind.DeserializationFeature;
<span class="hljs-keyword">import</span> com.fasterxml.jackson.databind.ObjectMapper;
<span class="hljs-keyword">import</span> org.springframework.context.annotation.Bean;
<span class="hljs-keyword">import</span> org.springframework.context.annotation.Configuration;
<span class="hljs-keyword">import</span> org.springframework.data.redis.connection.RedisConnectionFactory;
<span class="hljs-keyword">import</span> org.springframework.data.redis.core.RedisTemplate;
<span class="hljs-keyword">import</span> org.springframework.data.redis.serializer.Jackson2JsonRedisSerializer;
<span class="hljs-keyword">import</span> org.springframework.data.redis.serializer.StringRedisSerializer;

<span class="hljs-meta">@Configuration</span>
<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">RedisConfig</span> </span>{

    <span class="hljs-comment">/**
     * 这里配置的是 RedisTemplate (底层基于 Lettuce)
     * 主要目的是配置 JSON 序列化
     */</span>
    <span class="hljs-meta">@Bean</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> RedisTemplate&lt;String, Object&gt; <span class="hljs-title">redisTemplate</span><span class="hljs-params">(RedisConnectionFactory factory)</span> </span>{
        RedisTemplate&lt;String, Object&gt; template = <span class="hljs-keyword">new</span> RedisTemplate&lt;&gt;();
        template.setConnectionFactory(factory);

        <span class="hljs-comment">// 1. 定义 String 序列化器 (用于 Key)</span>
        StringRedisSerializer stringSerializer = <span class="hljs-keyword">new</span> StringRedisSerializer();

        <span class="hljs-comment">// 2. 定义 Jackson 序列化器 (用于 Value)</span>
        ObjectMapper om = <span class="hljs-keyword">new</span> ObjectMapper();
        om.setVisibility(PropertyAccessor.ALL, JsonAutoDetect.Visibility.ANY);
        <span class="hljs-comment">// 防止缺少属性时报错 (FAIL_ON_UNKNOWN_PROPERTIES = false)</span>
        om.configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, <span class="hljs-keyword">false</span>);
        
        <span class="hljs-comment">// 如果需要存类信息（@class），可以使用下面这行（可选，视业务需求而定）</span>
        <span class="hljs-comment">// om.activateDefaultTyping(LaissezFaireSubTypeValidator.instance, ObjectMapper.DefaultTyping.NON_FINAL);</span>

        Jackson2JsonRedisSerializer&lt;Object&gt; jacksonSerializer = <span class="hljs-keyword">new</span> Jackson2JsonRedisSerializer&lt;&gt;(om, Object.class);

        <span class="hljs-comment">// 3. 设置配置</span>
        template.setKeySerializer(stringSerializer);
        template.setValueSerializer(jacksonSerializer);
        template.setHashKeySerializer(stringSerializer);
        template.setHashValueSerializer(jacksonSerializer);

        template.afterPropertiesSet();
        <span class="hljs-keyword">return</span> template;
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 data-path-to-node="12">4. 实战代码：混合使用 Lettuce 和 Redisson</h3><p data-path-to-node="13">这是最核心的部分。我们将模拟一个 <b data-path-to-node="13" data-index-in-node="17">“抢购商品”</b> 或 <b data-path-to-node="13" data-index-in-node="26">“高并发库存扣减”</b> 的场景。</p><ul data-path-to-node="14"><li><p data-path-to-node="14,0,0"><b data-path-to-node="14,0,0" data-index-in-node="0">RedisTemplate (Lettuce)</b>：用来快速读取库存、更新库存。</p></li><li><p data-path-to-node="14,1,0"><b data-path-to-node="14,1,0" data-index-in-node="0">Redisson</b>：用来加锁，保证同一时间只有一个线程能修改库存。</p></li></ul><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c2283161342="" class="ng-tns-c2283161342-147 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2283161342="" class="code-block ng-tns-c2283161342-147 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_724f80f75170a3bf&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_683b97d40ce7f317&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwia5re6k-qRAxUAAAAAHQAAAAAQhAI" style="display: block;"><div _ngcontent-ng-c2283161342="" class="code-block-decoration header-formatted gds-title-s ng-tns-c2283161342-147 ng-star-inserted" style=""><span _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-147">Java</span><div _ngcontent-ng-c2283161342="" class="buttons ng-tns-c2283161342-147 ng-star-inserted"><button _ngcontent-ng-c2283161342="" aria-label="复制代码" mat-icon-button="" mattooltip="复制代码" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c2283161342-147 mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_724f80f75170a3bf&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_683b97d40ce7f317&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-147"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-147"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-147"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-147"><span class="hljs-keyword">import</span> org.redisson.api.RLock;
<span class="hljs-keyword">import</span> org.redisson.api.RedissonClient;
<span class="hljs-keyword">import</span> org.springframework.beans.factory.annotation.Autowired;
<span class="hljs-keyword">import</span> org.springframework.data.redis.core.RedisTemplate;
<span class="hljs-keyword">import</span> org.springframework.stereotype.Service;

<span class="hljs-keyword">import</span> java.util.concurrent.TimeUnit;

<span class="hljs-meta">@Service</span>
<span class="hljs-keyword">public</span> <span class="hljs-class"><span class="hljs-keyword">class</span> <span class="hljs-title">StockService</span> </span>{

    <span class="hljs-comment">// 1. 注入 RedisTemplate (底层是 Lettuce) -&gt; 用于数据读写</span>
    <span class="hljs-meta">@Autowired</span>
    <span class="hljs-keyword">private</span> RedisTemplate&lt;String, Object&gt; redisTemplate;

    <span class="hljs-comment">// 2. 注入 RedissonClient -&gt; 专门用于分布式锁</span>
    <span class="hljs-meta">@Autowired</span>
    <span class="hljs-keyword">private</span> RedissonClient redissonClient;

    <span class="hljs-comment">/**
     * 模拟扣减库存的业务
     * <span class="hljs-doctag">@param</span> productId 商品ID
     */</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> String <span class="hljs-title">deductStock</span><span class="hljs-params">(String productId)</span> </span>{
        String lockKey = <span class="hljs-string">"lock:product:"</span> + productId;
        String stockKey = <span class="hljs-string">"stock:product:"</span> + productId;

        <span class="hljs-comment">// --- 第一步：获取分布式锁 (Redisson) ---</span>
        RLock lock = redissonClient.getLock(lockKey);

        <span class="hljs-keyword">try</span> {
            <span class="hljs-comment">// 尝试加锁：</span>
            <span class="hljs-comment">// waitTime: 最多等待 5 秒</span>
            <span class="hljs-comment">// leaseTime: 上锁后 10 秒自动解锁 (防止死锁)</span>
            <span class="hljs-comment">// res: 是否加锁成功</span>
            <span class="hljs-keyword">boolean</span> res = lock.tryLock(<span class="hljs-number">5</span>, <span class="hljs-number">10</span>, TimeUnit.SECONDS);
            
            <span class="hljs-keyword">if</span> (!res) {
                <span class="hljs-keyword">return</span> <span class="hljs-string">"系统繁忙，请稍后再试 (抢锁失败)"</span>;
            }

            <span class="hljs-comment">// --- 第二步：执行业务逻辑 (Lettuce) ---</span>
            <span class="hljs-comment">// 此时已经是线程安全的了</span>
            
            <span class="hljs-comment">// 1. 查询库存</span>
            Object stockObj = redisTemplate.opsForValue().get(stockKey);
            <span class="hljs-keyword">int</span> stock = stockObj == <span class="hljs-keyword">null</span> ? <span class="hljs-number">0</span> : (Integer) stockObj;

            <span class="hljs-comment">// 2. 判断库存</span>
            <span class="hljs-keyword">if</span> (stock &gt; <span class="hljs-number">0</span>) {
                <span class="hljs-comment">// 3. 扣减库存</span>
                stock = stock - <span class="hljs-number">1</span>;
                redisTemplate.opsForValue().set(stockKey, stock);
                System.out.println(<span class="hljs-string">"扣减成功，剩余库存："</span> + stock);
                <span class="hljs-keyword">return</span> <span class="hljs-string">"扣减成功"</span>;
            } <span class="hljs-keyword">else</span> {
                System.out.println(<span class="hljs-string">"扣减失败，库存不足"</span>);
                <span class="hljs-keyword">return</span> <span class="hljs-string">"库存不足"</span>;
            }

        } <span class="hljs-keyword">catch</span> (InterruptedException e) {
            e.printStackTrace();
            <span class="hljs-keyword">return</span> <span class="hljs-string">"系统异常"</span>;
        } <span class="hljs-keyword">finally</span> {
            <span class="hljs-comment">// --- 第三步：释放锁 (Redisson) ---</span>
            <span class="hljs-comment">// 必须在 finally 中释放，且判断是否是当前线程持有的锁</span>
            <span class="hljs-keyword">if</span> (lock.isLocked() &amp;&amp; lock.isHeldByCurrentThread()) {
                lock.unlock();
            }
        }
    }
    
    <span class="hljs-comment">// 初始化库存的方法</span>
    <span class="hljs-function"><span class="hljs-keyword">public</span> <span class="hljs-keyword">void</span> <span class="hljs-title">initStock</span><span class="hljs-params">(String productId)</span> </span>{
        redisTemplate.opsForValue().set(<span class="hljs-string">"stock:product:"</span> + productId, <span class="hljs-number">100</span>);
    }
}
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 data-path-to-node="16">5. 关键点解析</h3><ol start="1" data-path-to-node="17"><li><p data-path-to-node="17,0,0"><b data-path-to-node="17,0,0" data-index-in-node="0">各司其职</b>：</p><ul data-path-to-node="17,0,1"><li><p data-path-to-node="17,0,1,0,0">我们在代码里并没有用 Redisson 去做 <code data-path-to-node="17,0,1,0,0" data-index-in-node="23">set</code> 或 <code data-path-to-node="17,0,1,0,0" data-index-in-node="29">get</code> 操作（虽然它可以做），因为 <code data-path-to-node="17,0,1,0,0" data-index-in-node="47">RedisTemplate</code> 的 API 在 Spring 中更通用，而且我们已经配置好了 JSON 序列化。</p></li><li><p data-path-to-node="17,0,1,1,0">我们只用 Redisson 做它最擅长的事——<b data-path-to-node="17,0,1,1,0" data-index-in-node="23">锁 (<code data-path-to-node="17,0,1,1,0" data-index-in-node="26">getLock</code>)</b>。</p></li></ul></li><li><p data-path-to-node="17,1,0"><b data-path-to-node="17,1,0" data-index-in-node="0">看门狗机制 (Watchdog)</b>：</p><ul data-path-to-node="17,1,1"><li><p data-path-to-node="17,1,1,0,0">在上面的代码中，我显式设置了 <code data-path-to-node="17,1,1,0,0" data-index-in-node="15">leaseTime</code> (10秒)。</p></li><li><p data-path-to-node="17,1,1,1,0">如果你调用 <code data-path-to-node="17,1,1,1,0" data-index-in-node="6">lock.lock()</code> 而不传时间，Redisson 会启动<b data-path-to-node="17,1,1,1,0" data-index-in-node="36">看门狗机制</b>：默认 30 秒过期，但只要你的业务线程还在跑，它每隔 10 秒就会自动把锁的时间续满。这能防止“业务没跑完，锁先过期了”的问题。</p></li></ul></li><li><p data-path-to-node="17,2,0"><b data-path-to-node="17,2,0" data-index-in-node="0">tryLock vs lock</b>：</p><ul data-path-to-node="17,2,1"><li><p data-path-to-node="17,2,1,0,0">推荐使用 <code data-path-to-node="17,2,1,0,0" data-index-in-node="5">tryLock</code>。因为在互联网业务中，如果用户拿不到锁，通常是直接返回“请稍后再试”，而不是让用户在那里一直无限等待（<code data-path-to-node="17,2,1,0,0" data-index-in-node="63">lock()</code> 会一直阻塞直到拿到锁）。</p></li></ul></li></ol><hr data-path-to-node="18"><h3 data-path-to-node="19">下一步建议</h3><p data-path-to-node="20">这个 Demo 跑通后，你可能会遇到<b data-path-to-node="20" data-index-in-node="18">Redis 里的 Key 管理混乱</b>的问题。</p><p data-path-to-node="21">你需要我介绍 <b data-path-to-node="21" data-index-in-node="7">Redis Key 的可视化管理工具</b>（除了命令行，还有哪些好用的桌面软件），或者如何通过 <b data-path-to-node="21" data-index-in-node="52">AOP (切面)</b> 把上面的分布式锁代码封装成一个简单的注解（例如 <code data-path-to-node="21" data-index-in-node="85">@DistributedLock</code>），让业务代码更干净？</p></div><!----></message-content><!----></div></structured-content-container><!----><!----><div _ngcontent-ng-c2200210637="" class="response-footer is-mobile has-thoughts gap complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2200210637="" _nghost-ng-c1438932748="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c3454274491="" class="response-container-footer ng-tns-c3454274491-125"><!----><message-actions _ngcontent-ng-c2200210637="" footer="" _nghost-ng-c1927598164="" class="ng-tns-c1927598164-137 ng-star-inserted hide-action-bar" style=""><div _ngcontent-ng-c1927598164="" class="actions-container-v2 ng-tns-c1927598164-137 mobile"><!----><!----><div _ngcontent-ng-c1927598164="" class="spacer ng-tns-c1927598164-137 ng-star-inserted"></div><!----><!----></div><!----><mat-menu _ngcontent-ng-c1927598164="" yposition="above" xposition="after" class="ng-tns-c1927598164-137"><!----></mat-menu><mat-menu _ngcontent-ng-c1927598164="" yposition="above" class="ng-tns-c1927598164-137"><!----></mat-menu><!----><!----><!----><!----><!----><!----><!----><!----