fc1c88880f95b&quot;,null,&quot;rc_b2abf18db01ed6d8&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-117"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-117"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-117"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-117"><span class="hljs-string">"{\"name\":\"Gemini\",\"age\":18}"</span>
</code></pre><!----></div></div></div><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="17"><i data-path-to-node="17" data-index-in-node="0">(注意看：外层多了引号，里面的引号被转义了。这在其他系统读取时会变成单纯的字符串，而不是 JSON 对象)</i></p><hr data-path-to-node="18"><h3 data-path-to-node="19">3. 为什么是这样？（底层原理）</h3><p data-path-to-node="20"><code data-path-to-node="20" data-index-in-node="0">RedisTemplate</code> 的工作流程如下：</p><ol start="1" data-path-to-node="21"><li><p data-path-to-node="21,0,0">你调用 <code data-path-to-node="21,0,0" data-index-in-node="4">opsForValue().set(key, value)</code>。</p></li><li><p data-path-to-node="21,1,0"><code data-path-to-node="21,1,0" data-index-in-node="0">RedisTemplate</code> 检查配置的 <code data-path-to-node="21,1,0" data-index-in-node="20">ValueSerializer</code>。</p></li><li><p data-path-to-node="21,2,0">它调用 <code data-path-to-node="21,2,0" data-index-in-node="4">serializer.serialize(value)</code>。</p><ul data-path-to-node="21,2,1"><li><p data-path-to-node="21,2,1,0,0">如果你传的是 <code data-path-to-node="21,2,1,0,0" data-index-in-node="7">User</code> 对象，Jackson 把它变成 <code data-path-to-node="21,2,1,0,0" data-index-in-node="28">{"name":"..."}</code> (byte[])。</p></li><li><p data-path-to-node="21,2,1,1,0">如果你传的是 <code data-path-to-node="21,2,1,1,0" data-index-in-node="7">String</code>，Jackson 把它变成 <code data-path-to-node="21,2,1,1,0" data-index-in-node="27">"String内容"</code> (byte[])。</p></li></ul></li></ol><h3 data-path-to-node="22">4. 特别注意：泛型的匹配</h3><p data-path-to-node="23">为了让“直接存对象”生效，你的 <code data-path-to-node="23" data-index-in-node="16">RedisTemplate</code> 注入时，泛型必须匹配。</p><ul data-path-to-node="24"><li><p data-path-to-node="24,0,0"><b data-path-to-node="24,0,0" data-index-in-node="0">✅ 推荐：</b> 注入 <code data-path-to-node="24,0,0" data-index-in-node="9">RedisTemplate&lt;String, Object&gt;</code></p><ul data-path-to-node="24,0,1"><li><p data-path-to-node="24,0,1,0,0">这样 <code data-path-to-node="24,0,1,0,0" data-index-in-node="3">value</code> 参数类型是 <code data-path-to-node="24,0,1,0,0" data-index-in-node="15">Object</code>，你可以传任何对象。</p></li></ul></li><li><p data-path-to-node="24,1,0"><b data-path-to-node="24,1,0" data-index-in-node="0">❌ 限制：</b> 如果你注入 <code data-path-to-node="24,1,0" data-index-in-node="12">RedisTemplate&lt;String, String&gt;</code></p><ul data-path-to-node="24,1,1"><li><p data-path-to-node="24,1,1,0,0">编译器会强制要求你 <code data-path-to-node="24,1,1,0,0" data-index-in-node="10">set</code> 的时候只能传 <code data-path-to-node="24,1,1,0,0" data-index-in-node="21">String</code>，这时候你就被迫必须手动转 JSON 了，而且必须配合 <code data-path-to-node="24,1,1,0,0" data-index-in-node="55">StringRedisSerializer</code> 使用，否则又会出现双重序列化的问题。</p></li></ul></li></ul><h3 data-path-to-node="25">总结</h3><p data-path-to-node="26">只要你配置了 <code data-path-to-node="26" data-index-in-node="7">Jackson2JsonRedisSerializer</code>，<b data-path-to-node="26" data-index-in-node="35">请大胆地把 Java 对象直接扔进去</b>。RedisTemplate 会帮你处理好一切。</p></div><!----></message-content><!----></div></structured-content-container><!----><!----><div _ngcontent-ng-c2200210637="" class="response-footer is-mobile has-thoughts gap complete"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c2200210637="" _nghost-ng-c1438932748="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----></div></div><!----><div _ngcontent-ng-c3454274491="" class="response-container-footer ng-tns-c3454274491-79"><!----><message-actions _ngcontent-ng-c2200210637="" footer="" _nghost-ng-c1927598164="" class="ng-