st-id="more-menu-button" class="mdc-button mat-mdc-button-base mat-mdc-tooltip-trigger icon-button more-button ng-tns-c3454274491-267 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" aria-describedby="cdk-describedby-message-ng-1-31" cdk-describedby-host="ng-1"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><mat-icon _ngcontent-ng-c3454274491="" role="img" fonticon="more_vert" class="mat-icon notranslate google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="more_vert"></mat-icon><span class="mdc-button__label"></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c2200210637="" class="response-content ng-tns-c3454274491-267"><div _ngcontent-ng-c2200210637="" class="thoughts-container"><div _ngcontent-ng-c2200210637="" class="thoughts-content ng-star-inserted" style=""><div _ngcontent-ng-c2200210637="" class="thoughts-wrapper"><!----><model-thoughts _ngcontent-ng-c2200210637="" data-test-id="model-thoughts" _nghost-ng-c2166473866="" class="ng-tns-c2166473866-269 ng-star-inserted" style="height: auto;"><div _ngcontent-ng-c2166473866="" class="model-thoughts ng-tns-c2166473866-269 is-mobile"><div _ngcontent-ng-c2166473866="" class="thoughts-header ng-tns-c2166473866-269"><button _ngcontent-ng-c2166473866="" mat-button="" data-test-id="thoughts-header-button" class="mdc-button mat-mdc-button-base thoughts-header-button ng-tns-c2166473866-269 mat-mdc-button mat-unthemed" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-content"><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-label ng-tns-c2166473866-269"><span _ngcontent-ng-c2166473866="" class="ng-tns-c2166473866-269">显示思路</span></div><div _ngcontent-ng-c2166473866="" class="thoughts-header-button-icons ng-tns-c2166473866-269"><!----><mat-icon _ngcontent-ng-c2166473866="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c2166473866-269 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><structured-content-container _ngcontent-ng-c2200210637="" class="model-response-text is-mobile ng-star-inserted has-thoughts" _nghost-ng-c3024867895="" style="height: auto;"><div _ngcontent-ng-c3024867895="" class="container"><message-content _ngcontent-ng-c3024867895="" _nghost-ng-c4114227185="" id="message-content-id-r_329d4385bc05af6c" class="ng-star-inserted"><div _ngcontent-ng-c4114227185="" inline-copy-host="" class="markdown markdown-main-panel stronger enable-updated-hr-color" id="model-response-message-contentr_329d4385bc05af6c" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">Redisson 的强大之处在于它不仅仅是一个 Redis 客户端，它在 Redis 之上实现了一整套 <b data-path-to-node="0" data-index-in-node="52">JDK 分布式数据结构</b> 和 <b data-path-to-node="0" data-index-in-node="66">分布式服务</b>。</p><p data-path-to-node="1">这意味着你不需要自己写 Lua 脚本或复杂的逻辑，就能像使用本地 Java 对象（如 <code data-path-to-node="1" data-index-in-node="43">HashMap</code>, <code data-path-to-node="1" data-index-in-node="52">Lock</code>, <code data-path-to-node="1" data-index-in-node="58">AtomicLong</code>）一样使用 Redis。</p><p data-path-to-node="2">以下是 Redisson 最核心、最高频的 <b data-path-to-node="2" data-index-in-node="22">6 大使用场景</b>：</p><hr data-path-to-node="3"><h3 data-path-to-node="4">1. 分布式锁 (Distributed Lock) —— <b data-path-to-node="4" data-index-in-node="30">最核心场景</b></h3><p data-path-to-node="5">这是 Redisson 最著名的功能。在微服务或多实例部署中，Java 自带的 <code data-path-to-node="5" data-index-in-node="40">synchronized</code> 和 <code data-path-to-node="5" data-index-in-node="55">ReentrantLock</code> 只能锁住当前机器的线程，无法锁住其他机器。</p><ul data-path-to-node="6"><li><p data-path-to-node="6,0,0"><b data-path-to-node="6,0,0" data-index-in-node="0">痛点：</b> 手写 <code data-path-to-node="6,0,0" data-index-in-node="7">SETNX</code> 容易出现死锁、原子性问题、锁误删问题。</p></li><li><p data-path-to-node="6,1,0"><b data-path-to-node="6,1,0" data-index-in-node="0">Redisson 方案：</b> 提供了生产级的锁实现，自带 <b data-path-to-node="6,1,0" data-index-in-node="27">Watchdog (看门狗)</b> 自动续期机制。</p></li><li><p data-path-to-node="6,2,0"><b data-path-to-node="6,2,0" data-index-in-node="0">子场景：</b></p><ul data-path-to-node="6,2,1"><li><p data-path-to-node="6,2,1,0,0"><b data-path-to-node="6,2,1,0,0" data-index-in-node="0"><code data-path-to-node="6,2,1,0,0" data-index-in-node="0">RLock</code> (可重入锁)：</b> 防止商品超卖、防止重复提交订单、定时任务只在单机执行。</p></li><li><p data-path-to-node="6,2,1,1,0"><b data-path-to-node="6,2,1,1,0" data-index-in-node="0"><code data-path-to-node="6,2,1,1,0" data-index-in-node="0">RReadWriteLock</code> (读写锁)：</b> 读多写少的场景（如热点配置更新），读锁共享，写锁排他。</p></li><li><p data-path-to-node="6,2,1,2,0"><b data-path-to-node="6,2,1,2,0" data-index-in-node="0"><code data-path-to-node="6,2,1,2,0" data-index-in-node="0">RMultiLock</code> (联锁)：</b> 同时锁定多个资源（例如：扣减库存的同时，锁定优惠券）。</p></li></ul></li></ul><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><code-block _nghost-ng-c2283161342="" class="ng-tns-c2283161342-286 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2283161342="" class="code-block ng-tns-c2283161342-286 ng-animate-disabled ng-trigger ng-trigger-codeB