b64&quot;,&quot;c_1e4fc1c88880f95b&quot;,null,&quot;rc_fba3e097f98b28b1&quot;,null,null,&quot;zh&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c2283161342="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----></div><!----><div _ngcontent-ng-c2283161342="" class="formatted-code-block-internal-container ng-tns-c2283161342-266"><div _ngcontent-ng-c2283161342="" class="animated-opacity ng-tns-c2283161342-266"><pre _ngcontent-ng-c2283161342="" class="ng-tns-c2283161342-266"><code _ngcontent-ng-c2283161342="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2283161342-266"><span class="hljs-meta">@Bean</span>
<span class="hljs-function"><span class="hljs-keyword">public</span> RedissonClient <span class="hljs-title">redissonClient</span><span class="hljs-params">()</span> <span class="hljs-keyword">throws</span> IOException </span>{
